+"""Opt-in robot feedback timing, without a camera, model, or robot SDK import.
+
+The source is the SDK cache update after CAN feedback was copied, NOT the
+physical encoder sampling time. All comparisons require one Linux boot clock.
+"""
+
+from __future__ import annotations
+
+import copy
+import csv
+from functools import lru_cache
+import io
+import json
+import math
+from pathlib import Path
+import queue
+import re
+import statistics
+import threading
+import time
+from contextlib import redirect_stdout
+
+
+SOURCE_KIND = "SDK_cache_update"
+NS_FIELDS = (
+    "eef_source_ns", "joint_source_ns", "server_received_ns", "server_send_ns",
+    "client_send_ns", "client_return_ns", "clock_uncertainty_ns",
+)
+CSV_FIELDS = (
+    "label", "command", "request_id", "version", "clock_id", "sdk_instance_id",
+    "source_kind", *NS_FIELDS, "controller_received_ns", "eef_sdk_timestamp_s",
+    "joint_sdk_timestamp_s", "eef_sdk_to_client_ms", "joint_sdk_to_client_ms",
+    "eef_sdk_to_server_reply_ms", "joint_sdk_to_server_reply_ms", "rpc_ms",
+    "server_reply_to_client_ms", "client_to_controller_ms",
+    "eef_sdk_to_controller_ms", "joint_sdk_to_controller_ms",
+)
+
+
+@lru_cache(maxsize=1)
+def local_clock_id() -> str:
+    try:
+        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
+    except OSError as exc:
+        raise RuntimeError("Robot feedback timing requires a shared Linux boot clock") from exc
+    if not boot_id:
+        raise RuntimeError("Cannot read Linux boot clock identity")
+    return "linux:" + boot_id
+
+
+def validate_latency_metadata(data: dict) -> dict:
+    if not isinstance(data, dict) or data.get("protocol_version") != 1 or isinstance(data.get("protocol_version"), bool):
+        raise RuntimeError("Robot server lacks latency protocol v1; update and restart the 8765 service")
+    if data.get("clock_id") != local_clock_id():
+        raise RuntimeError("Robot latency needs server and client on the same Linux boot clock; cross-host clocks are not calibrated")
+    if data.get("source_kind") != SOURCE_KIND:
+        raise RuntimeError("Robot latency server reports an unsupported source timestamp")
+    if data.get("controller_active") is False:
+        raise RuntimeError(
+            "Robot controller is inactive; read-only measurement will not recreate it. "
+            "Restart the robot server, then start measurement before its idle timeout "
+            "(60 seconds by default). Keep the server running in a separate terminal."
+        )
+    if not isinstance(data.get("sdk_instance_id"), str) or not data["sdk_instance_id"]:
+        raise RuntimeError("Robot latency metadata lacks SDK instance identity")
+    return copy.deepcopy(data)
+
+
+def _integer(value, name, *, minimum=0):
+    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
+        raise ValueError(f"{name} must be an integer >= {minimum}")
+    return value
+
+
+def validate_timing(timing: dict, *, check_local_clock=True) -> dict:
+    if not isinstance(timing, dict):
+        raise ValueError("Robot timing must be a dictionary")
+    data = dict(timing)
+    if data.get("error"):
+        raise ValueError(f"Robot server timing error: {data['error']}")
+    if data.get("version") != 1 or isinstance(data.get("version"), bool):
+        raise ValueError("Unsupported robot timing version")
+    if data.get("source_kind") != SOURCE_KIND:
+        raise ValueError("Unsupported source_kind; expected SDK_cache_update")
+    for key in ("request_id", "sdk_instance_id", "clock_id"):
+        if not isinstance(data.get(key), str) or not data[key]:
+            raise ValueError(f"Missing {key}")
+    if not data["clock_id"].startswith("linux:"):
+        raise ValueError("Robot timing must use Linux monotonic clock identity")
+    if check_local_clock and data["clock_id"] != local_clock_id():
+        raise ValueError("Robot reply clock_id does not match the local Linux boot clock")
+    if data.get("command") not in ("GET_STATE", "SET_EE_POSE"):
+        raise ValueError("Robot timing command must be GET_STATE or SET_EE_POSE")
+    for key in NS_FIELDS:
+        _integer(data.get(key), key)
+    if not (data["client_send_ns"] <= data["server_received_ns"]
+            <= data["server_send_ns"] <= data["client_return_ns"]):
+        raise ValueError("Robot timing transport timestamps are out of order")
+    for prefix in ("eef", "joint"):
+        if data[f"{prefix}_source_ns"] > data["server_send_ns"] + data["clock_uncertainty_ns"]:
+            raise ValueError(f"{prefix} SDK source timestamp is in the future")
+        timestamp = data.get(f"{prefix}_sdk_timestamp_s")
+        if isinstance(timestamp, bool) or not isinstance(timestamp, (int, float)) or not math.isfinite(timestamp) or timestamp < 0:
+            raise ValueError(f"Invalid {prefix} SDK timestamp")
+    return data
+
+
+def timing_row(timing: dict, controller_received_ns=None, label="GET_STATE", *, check_local_clock=True) -> dict:
+    data = validate_timing(timing, check_local_clock=check_local_clock)
+    row = {key: data[key] for key in CSV_FIELDS if key in data}
+    row["label"] = str(label)
+    row["controller_received_ns"] = ""
+    for prefix in ("eef", "joint"):
+        row[f"{prefix}_sdk_to_client_ms"] = (data["client_return_ns"] - data[f"{prefix}_source_ns"]) / 1e6
+        row[f"{prefix}_sdk_to_server_reply_ms"] = (data["server_send_ns"] - data[f"{prefix}_source_ns"]) / 1e6
+        row[f"{prefix}_sdk_to_controller_ms"] = ""
+    row["rpc_ms"] = (data["client_return_ns"] - data["client_send_ns"]) / 1e6
+    row["server_reply_to_client_ms"] = (data["client_return_ns"] - data["server_send_ns"]) / 1e6
+    row["client_to_controller_ms"] = ""
+    if controller_received_ns is not None:
+        _integer(controller_received_ns, "controller_received_ns")
+        if controller_received_ns < data["client_return_ns"]:
+            raise ValueError("Controller boundary predates client return")
+        row["controller_received_ns"] = controller_received_ns
+        row["client_to_controller_ms"] = (controller_received_ns - data["client_return_ns"]) / 1e6
+        for prefix in ("eef", "joint"):
+            row[f"{prefix}_sdk_to_controller_ms"] = (controller_received_ns - data[f"{prefix}_source_ns"]) / 1e6
+    return row
+
+
+def percentile(values, fraction):
+    ordered = sorted(values)
+    position = (len(ordered) - 1) * fraction
+    left, right = math.floor(position), math.ceil(position)
+    return ordered[left] + (ordered[right] - ordered[left]) * (position - left)
+
+
+def _stat_line(name, values):
+    if not values:
+        return
+    print(f"  {name}: n={len(values)} mean={statistics.fmean(values):.3f} "
+          f"p50={statistics.median(values):.3f} p95={percentile(values, .95):.3f} "
+          f"min={min(values):.3f} max={max(values):.3f}")
+
+
+def load_rows(csv_path: Path):
+    rows = []
+    with Path(csv_path).open(newline="") as stream:
+        reader = csv.DictReader(stream)
+        if reader.fieldnames is None or not set(CSV_FIELDS).issubset(reader.fieldnames):
+            raise ValueError("Robot latency CSV is missing required fields")
+        for number, raw in enumerate(reader, start=2):
+            try:
+                data = dict(raw)
+                for key in (*NS_FIELDS, "version"):
+                    data[key] = int(raw[key])
+                for prefix in ("eef", "joint"):
+                    data[f"{prefix}_sdk_timestamp_s"] = float(raw[f"{prefix}_sdk_timestamp_s"])
+                controller = int(raw["controller_received_ns"]) if raw["controller_received_ns"] else None
+                # Saved sessions remain reportable after reboot or on another host.
+                row = timing_row(data, controller, raw["label"], check_local_clock=False)
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError(f"Invalid robot timing at CSV line {number}: {exc}") from exc
+            rows.append(row)
+    return rows
+
+
+def _print_groups(rows):
+    groups = {}
+    for row in rows:
+        groups.setdefault((row["label"], row["command"], row["clock_id"], row["sdk_instance_id"]), []).append(row)
+    for (label, command, clock_id, sdk_id), group in groups.items():
+        print(f"\n[{label} / {command}] n={len(group)}; SDK instance={sdk_id}; clock={clock_id}")
+        print(f"  SDK-to-host clock mapping uncertainty: +/-{max(r['clock_uncertainty_ns'] for r in group) / 1e6:.6f} ms")
+        for name in ("eef_sdk_to_client_ms", "joint_sdk_to_client_ms", "rpc_ms",
+                     "eef_sdk_to_server_reply_ms", "joint_sdk_to_server_reply_ms",
+                     "server_reply_to_client_ms", "client_to_controller_ms",
+                     "eef_sdk_to_controller_ms", "joint_sdk_to_controller_ms"):
+            _stat_line(name, [float(row[name]) for row in group if row[name] != ""])
+        for prefix in ("eef", "joint"):
+            stamps = [row[f"{prefix}_sdk_timestamp_s"] for row in group]
+            pairs = max(0, len(stamps) - 1)
+            repeated = sum(a == b for a, b in zip(stamps, stamps[1:]))
+            regressions = sum(b < a for a, b in zip(stamps, stamps[1:]))
+            ratio = 100 * repeated / pairs if pairs else 0
+            print(f"  {prefix} repeated adjacent SDK timestamp: {repeated}/{pairs} ({ratio:.1f}%); regressions={regressions}")
+
+
+def _print_policy_active(csv_path, rows):
+    print("\nPolicy-active SET_EE_POSE feedback (requests entirely inside recorded policy windows):")
+    observation_path = Path(csv_path).parent.parent / "observation_session.json"
+    if not re.fullmatch(r"robot\d+", Path(csv_path).parent.name) or not observation_path.is_file():
+        print("No actual policy-active result: no same-session policy windows recorded.")
+        return
+    try:
+        metadata = json.loads(observation_path.read_text())["metadata"]
+        if not isinstance(metadata, dict):
+            raise ValueError("observation metadata must be a dictionary")
+        windows = metadata.get("policy_windows", [])
+        if not windows:
+            print("No actual policy-active result: no policy windows recorded.")
+            return
+        if not isinstance(windows, list):
+            raise ValueError("policy_windows must be a list")
+        intervals = []
+        for window in windows:
+            start = _integer(window["start_ns"], "policy window start_ns")
+            end = _integer(window["end_ns"], "policy window end_ns")
+            if end < start:
+                raise ValueError("policy window end precedes start")
+            intervals.append((start, end))
+        clock_id = metadata["server"]["clock_id"]
+        if not isinstance(clock_id, str) or not clock_id.startswith("linux:"):
+            raise ValueError("policy window metadata lacks a Linux boot clock identity")
+    except (OSError, KeyError, TypeError, ValueError) as error:
+        print(f"No actual policy-active result: invalid window metadata: {error}")
+        return
+    candidates = [row for row in rows if row["command"] == "SET_EE_POSE"]
+    mismatches = sum(row["clock_id"] != clock_id for row in candidates)
+    if mismatches:
+        print(f"WARNING: excluded {mismatches} SET_EE_POSE requests with a clock identity different from policy windows.")
+    active = []
+    for row in candidates:
+        if row["clock_id"] != clock_id:
+            continue
+        received = row["controller_received_ns"]
+        end = int(received) if received != "" else row["client_return_ns"]
+        if any(row["client_send_ns"] >= start and end <= stop for start, stop in intervals):
+            active.append(row)
+    print(f"Recorded policy windows: {len(intervals)}; eligible active requests: {len(active)}/{len(candidates)} SET_EE_POSE samples.")
+    if not active:
+        print("No actual policy-active result: no matching complete requests inside the recorded windows.")
+        return
+    _print_groups(active)
+
+
+def print_report(csv_path: Path):
+    rows = load_rows(csv_path)
+    print(f"Robot feedback latency: {len(rows)} samples; units: ms")
+    print("Source: SDK cache update after CAN-cache copy; excludes earlier encoder/CAN/cache delay.")
+    print("Endpoint: client receive after deserialization; controller boundary is shown separately when recorded.")
+    print("This measures feedback, not action execution delay; robot_obs_latency is not changed.")
+    print("\nAll-session feedback (may include idle, hold, reset, and warmup; command names alone do not identify active policy):")
+    if not rows:
+        print("No valid samples recorded.")
+    _print_groups(rows)
+    _print_policy_active(csv_path, rows)
+    metadata_path = Path(csv_path).parent / "session.json"
+    if metadata_path.is_file():
+        metadata = json.loads(metadata_path.read_text())
+        if "accounting" in metadata:
+            print(f"\nRecorder accounting: {json.dumps(metadata['accounting'], sort_keys=True)}")
+        if metadata.get("save_error"):
+            print(f"WARNING: recorder failed: {metadata['save_error']}")
+        controller_errors = metadata.get("metadata", {}).get("controller_timing_errors")
+        if controller_errors:
+            print(f"WARNING: controller timing diagnostics failed/skipped {controller_errors} samples")
+    print("\nGET_STATE polling is a read-only baseline. Only the policy-active SET_EE_POSE group isolates the recorded policy run.")
+    print("A fixed compensation also needs any unmeasured pre-SDK delay; do not infer total physical latency from this report.")
+
+
+class RobotLatencyRecorder:
+    """Bounded background CSV writer; record() never waits for disk or a queue slot."""
+
+    def __init__(self, directory: Path, metadata: dict, max_samples=100000, queue_size=2048):
+        if isinstance(max_samples, bool) or not isinstance(max_samples, int) or max_samples < 1:
+            raise ValueError("max_samples must be a positive integer")
+        if isinstance(queue_size, bool) or not isinstance(queue_size, int) or queue_size < 1:
+            raise ValueError("queue_size must be a positive integer")
+        self.directory = self.session_dir = Path(directory)
+        self.metadata = copy.deepcopy(metadata)
+        json.dumps(self.metadata)
+        self.max_samples = max_samples
+        self._queue = queue.Queue(maxsize=queue_size)
+        self._stop = threading.Event()
+        self._thread = None
+        self._started = self._closed = False
+        self._error = None
+        self._accounting = dict(record_calls=0, enqueued=0, saved=0, dropped_queue_full=0,
+                                skipped_cap=0, invalid=0, dropped_save_error=0)
+
+    @property
+    def accounting(self):
+        return dict(self._accounting)
+
+    def _write_metadata(self):
+        data = {"schema_version": 1, "metadata": self.metadata, "accounting": self.accounting,
+                "source_kind": SOURCE_KIND, "save_error": self._error,
+                "closed": self._closed,
+                "scope": "SDK cache update to client receive; excludes prior encoder/CAN/cache delay"}
+        temporary = self.directory / "session.json.tmp"
+        temporary.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+        temporary.replace(self.directory / "session.json")
+
+    def __enter__(self):
+        if self._started or self._closed:
+            raise RuntimeError("RobotLatencyRecorder cannot be restarted")
+        self.directory.mkdir(parents=True, exist_ok=True)
+        if (self.directory / "session.json").exists():
+            raise FileExistsError(f"Refusing to overwrite a robot timing session: {self.directory}")
+        self._stream = (self.directory / "samples.csv").open("x", newline="")
+        self._writer = csv.DictWriter(self._stream, fieldnames=CSV_FIELDS)
+        try:
+            self._writer.writeheader()
+            self._stream.flush()
+            self._write_metadata()
+        except BaseException:
+            self._stream.close()
+            raise
+        self._started = True
+        self._thread = threading.Thread(target=self._save_loop, name="robot-latency-saver", daemon=True)
+        self._thread.start()
+        print(f"[robot-latency] Samples: {self.directory}", flush=True)
+        return self
+
+    def record(self, timing: dict, controller_received_ns=None, label="GET_STATE"):
+        if not self._started or self._closed:
+            raise RuntimeError("Use RobotLatencyRecorder inside its context")
+        self._accounting["record_calls"] += 1
+        if self._error is not None:
+            self._accounting["dropped_save_error"] += 1
+            return False
+        if self._accounting["enqueued"] >= self.max_samples:
+            self._accounting["skipped_cap"] += 1
+            return False
+        try:
+            row = timing_row(timing, controller_received_ns, label)
+        except (ValueError, TypeError):
+            self._accounting["invalid"] += 1
+            raise
+        try:
+            self._queue.put_nowait(row)
+        except queue.Full:
+            self._accounting["dropped_queue_full"] += 1
+            return False
+        self._accounting["enqueued"] += 1
+        return True
+
+    def _save_loop(self):
+        last_flush = time.monotonic()
+        try:
+            while not self._stop.is_set() or not self._queue.empty():
+                try:
+                    row = self._queue.get(timeout=0.05)
+                except queue.Empty:
+                    if time.monotonic() - last_flush >= 1:
+                        self._stream.flush()
+                        last_flush = time.monotonic()
+                    continue
+                self._writer.writerow(row)
+                self._accounting["saved"] += 1
+                if time.monotonic() - last_flush >= 1:
+                    self._stream.flush()
+                    last_flush = time.monotonic()
+            self._stream.flush()
+        except Exception as exc:
+            self._error = f"{type(exc).__name__}: {exc}"
+        finally:
+            self._stream.close()
+
+    def close(self):
+        if self._closed:
+            return
+        self._closed = True
+        if not self._started:
+            return
+        self._stop.set()
+        self._thread.join(timeout=10)
+        if self._thread.is_alive():
+            self._error = "CSV saver did not finish within 10 seconds"
+        self._write_metadata()
+        if self._error is not None:
+            raise RuntimeError(f"Robot latency recorder failed: {self._error}")
+        report = io.StringIO()
+        with redirect_stdout(report):
+            print_report(self.directory / "samples.csv")
+        (self.directory / "report.txt").write_text(report.getvalue())
+
+    def __exit__(self, exc_type, exc, tb):
+        try:
+            self.close()
+        except Exception:
+            if exc_type is None:
+                raise
+        return False
