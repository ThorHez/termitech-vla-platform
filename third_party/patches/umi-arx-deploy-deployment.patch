+"""Observation provenance checks are synthetic and perform no robot I/O."""
+
+import csv
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+import numpy as np
+
+from utils.interpolation_util import PoseInterpolator
+from utils.robot_latency_observation import (
+    RobotObservationRecorder, describe_robot_observation,
+    feedback_timing_example, feedback_timing_fields,
+)
+
+
+class ObservationTimingTests(unittest.TestCase):
+    def state_history(self):
+        fields = []
+        for i in range(3):
+            base = 1_000_000_000 + i * 10_000_000
+            fields.append(feedback_timing_fields({
+                "eef_source_ns": base,
+                "joint_source_ns": base + 1_000_000,
+                "client_return_ns": base + 2_000_000,
+                "clock_uncertainty_ns": 2_500,
+            }, base + 3_000_000))
+        history = {key: np.asarray([row[key] for row in fields]) for key in fields[0]}
+        history["robot_timestamp"] = np.array([10., 11., 12.])
+        return history
+
+    def observation(self, target=10.25):
+        return {
+            "robot0_feedback_timing": describe_robot_observation(self.state_history(), target),
+            "robot_observation_monotonic_ns": 1_030_000_000,
+            "camera0_rgb": np.full((224, 224, 3), 255, dtype=np.uint8),
+        }
+
+    def test_schema_missing_timing_is_explicitly_invalid_int64(self):
+        example = feedback_timing_example()
+        missing = feedback_timing_fields(None, 999)
+        self.assertEqual(set(example), set(missing))
+        self.assertTrue(all(type(value) is np.int64 and value == 0 for value in missing.values()))
+
+    def test_malformed_timing_cannot_create_valid_shared_memory_sample(self):
+        valid = {"eef_source_ns": 100, "joint_source_ns": 101, "client_return_ns": 105, "clock_uncertainty_ns": 2}
+        for key, value in (("eef_source_ns", 0), ("joint_source_ns", 108),
+                           ("client_return_ns", 121), ("clock_uncertainty_ns", -1),
+                           ("eef_source_ns", 1.0), ("eef_source_ns", True)):
+            with self.subTest(key=key, value=value), self.assertRaises(ValueError):
+                feedback_timing_fields(dict(valid, **{key: value}), 120)
+        result = feedback_timing_fields(dict(valid, eef_source_ns=107), 120)
+        self.assertEqual(result["robot_feedback_valid"], 1)
+
+    def test_brackets_match_actual_clipped_pose_interpolator(self):
+        history = self.state_history()
+        poses = np.zeros((3, 6))
+        poses[:, 0] = [0, 10, 30]
+        interpolate = PoseInterpolator(history["robot_timestamp"], poses)
+        for target, lower, upper, clip in (
+            (9., 0, 0, "before"), (10., 0, 0, "none"),
+            (10.25, 0, 1, "none"), (11., 1, 1, "none"),
+            (11.25, 1, 2, "none"), (12., 2, 2, "none"),
+            (13., 2, 2, "after"),
+        ):
+            with self.subTest(target=target):
+                row = describe_robot_observation(history, target)
+                self.assertEqual((row["lower_index"], row["upper_index"], row["clip"]), (lower, upper, clip))
+                fraction = 0 if lower == upper else (row["effective_wall_time"] - history["robot_timestamp"][lower]) / (history["robot_timestamp"][upper] - history["robot_timestamp"][lower])
+                expected = poses[lower, 0] + fraction * (poses[upper, 0] - poses[lower, 0])
+                self.assertAlmostEqual(float(interpolate(np.array([target]))[0, 0]), expected)
+                self.assertEqual(row["lower_eef_source_ns"], int(history["robot_eef_source_monotonic_ns"][lower]))
+                self.assertEqual(json.loads(json.dumps(row)), row)
+
+    def test_description_is_copied_and_missing_or_unsorted_history_fails(self):
+        history = self.state_history()
+        result = describe_robot_observation(history, 10.25)
+        history["robot_eef_source_monotonic_ns"][0] = 4
+        self.assertEqual(result["lower_eef_source_ns"], 1_000_000_000)
+        del history["robot_clock_uncertainty_ns"]
+        with self.assertRaisesRegex(ValueError, "lacks"):
+            describe_robot_observation(history, 10.25)
+        history = self.state_history()
+        history["robot_timestamp"][:] = [10, 10, 12]
+        with self.assertRaisesRegex(ValueError, "strictly increasing"):
+            describe_robot_observation(history, 10.25)
+
+    def test_recorder_is_bounded_scalar_only_and_flushes_on_close(self):
