+            sdk_instances.add(timing["sdk_instance_id"])
+            clock_ids.add(timing["clock_id"])
+            if len(sdk_instances) > 1 or len(clock_ids) > 1:
+                raise ValueError("Mixed SDK instances or clock domains; split capture before matching")
+            source_ns = timing["joint_source_ns"]
+            uncertainty = timing["clock_uncertainty_ns"]
+            raw = state_raw(reply["data"])
+            base = dict(sample_index=sample_index, request_id=timing["request_id"],
+                        sdk_instance_id=timing["sdk_instance_id"], joint_source_ns=source_ns,
+                        client_return_ns=timing["client_return_ns"],
+                        clock_uncertainty_ns=uncertainty, joint_sdk_timestamp_s=timing["joint_sdk_timestamp_s"])
+            sdk_stamps.append(timing["joint_sdk_timestamp_s"])
+            sdk_receive_ages.append((timing["client_return_ns"] - source_ns) / 1e6)
+            for motor in MOTORS:
+                description, eligible = describe_candidates(reconstruction.motor_index[motor].get(raw[motor], []), source_ns, uncertainty)
+                motor_rows.append(dict(base, motor_id=motor, **description))
+            description, eligible = describe_candidates(reconstruction.whole_index.get(flatten(raw), []), source_ns, uncertainty)
+            whole_rows.append(dict(base, **description))
+            if len(eligible) == 1 and description["clock_boundary_count"] == 0:
+                candidate = eligible[0]
+                motor_ages = {
+                    motor: (source_ns - candidate["motors"][motor]["writes"]["position_rad"]["receive_ns"]) / 1e6
+                    for motor in MOTORS
+                }
+                unique_whole.append(dict(
+                    sample_index=sample_index, motor_ages=motor_ages,
+                    sdk_to_client_ms=(timing["client_return_ns"] - source_ns) / 1e6,
+                    eef_matches_joint_snapshot=timing["eef_sdk_timestamp_s"] == timing["joint_sdk_timestamp_s"],
+                ))
+            for motor in MOTORS:
+                for field in FIELDS:
+                    writes = {(candidate["motors"][motor]["writes"][field]["seq"]): candidate["motors"][motor]["writes"][field]
+                              for candidate in eligible}
+                    field_description, _ = describe_candidates(list(writes.values()), source_ns, uncertainty)
+                    attribution_rows.append(dict(base, motor_id=motor, field=field,
+                                                 whole_candidate_count=len(eligible), **field_description))
+
+    write_csv(directory / "motor_tuple_matches.csv", motor_rows)
+    write_csv(directory / "whole_snapshot_matches.csv", whole_rows)
+    write_csv(directory / "whole_snapshot_field_sources.csv", attribution_rows)
