+++ b/utils/robot_latency_observation.py
@@ -0,0 +1,228 @@
+"""Trace which SDK feedback samples bracket a model's robot observation.
+
+All source ages refer to SDK cache update, not encoder sampling or CAN arrival.
+Wall-clock timestamps only select the same interpolation bracket as get_obs;
+all measured durations use the shared monotonic clock.
+"""
+
+import csv
+from contextlib import redirect_stdout
+import io
+import json
+import math
+from pathlib import Path
+import re
+import statistics
+import warnings
+
+import numpy as np
+
+
+SOURCE_KIND = "SDK_cache_update"
+TIMING_FIELDS = {
+    "valid": "robot_feedback_valid",
+    "eef_source_ns": "robot_eef_source_monotonic_ns",
+    "joint_source_ns": "robot_joint_source_monotonic_ns",
+    "client_return_ns": "robot_client_return_monotonic_ns",
+    "controller_receive_ns": "robot_controller_receive_monotonic_ns",
+    "clock_uncertainty_ns": "robot_clock_uncertainty_ns",
+}
+
+
+def _integer(value, name, *, minimum=0):
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value, (int, np.integer)):
+        raise ValueError(f"{name} must be an integer")
+    value = int(value)
+    if value < minimum or value > np.iinfo(np.int64).max:
+        raise ValueError(f"{name} must be in [{minimum}, int64 max]")
+    return value
+
+
+def feedback_timing_example():
+    return {name: np.int64(0) for name in TIMING_FIELDS.values()}
+
+
+def feedback_timing_fields(timing, received_ns):
+    """Convert validated client timing into numeric shared-memory fields."""
+    result = feedback_timing_example()
+    if timing is None:
+        return result
+    if not isinstance(timing, dict):
+        raise ValueError("Robot feedback timing must be a dictionary or None")
+    received_ns = _integer(received_ns, "controller receive", minimum=1)
+    values = {
+        name: _integer(timing.get(name), name, minimum=0 if name == "clock_uncertainty_ns" else 1)
+        for name in ("eef_source_ns", "joint_source_ns", "client_return_ns", "clock_uncertainty_ns")
+    }
+    if values["client_return_ns"] > received_ns:
+        raise ValueError("Robot controller receive timestamp predates client return")
+    for name in ("eef_source_ns", "joint_source_ns"):
+        if values[name] > values["client_return_ns"] + values["clock_uncertainty_ns"]:
+            raise ValueError(f"Robot {name} is in the future beyond the clock bound")
+    values.update(valid=1, controller_receive_ns=received_ns)
+    return {TIMING_FIELDS[name]: np.int64(value) for name, value in values.items()}
+
+
+def describe_robot_observation(last_robot_data, target_wall_time):
+    """Copy provenance of the two samples used by the existing clipped interpolator."""
+    times = np.asarray(last_robot_data["robot_timestamp"])
+    target = float(target_wall_time)
+    if (times.ndim != 1 or not len(times) or not np.all(np.isfinite(times))
+            or np.any(np.diff(times) <= 0) or not math.isfinite(target)):
+        raise ValueError("Robot interpolation needs finite, strictly increasing timestamps")
+    clipped = "before" if target < times[0] else "after" if target > times[-1] else "none"
+    effective = float(np.clip(target, times[0], times[-1]))
+    upper = int(np.searchsorted(times, effective, side="left"))
+    lower = upper if float(times[upper]) == effective else upper - 1
+    result = {
+        "source_kind": SOURCE_KIND,
+        "requested_wall_time": target,
+        "effective_wall_time": effective,
+        "clip": clipped,
+        "lower_index": lower,
+        "upper_index": upper,
+    }
+    for prefix, index in (("lower", lower), ("upper", upper)):
+        result[f"{prefix}_configured_robot_timestamp"] = float(times[index])
+        for name, field in TIMING_FIELDS.items():
+            if field not in last_robot_data:
+                raise ValueError(f"Robot observation lacks {field}; enable robot feedback timing")
+            data = np.asarray(last_robot_data[field])
+            if data.shape != times.shape:
+                raise ValueError(f"Robot observation {field} shape differs from state timestamps")
+            value = _integer(data[index], field)
+            if name == "valid" and value not in (0, 1):
+                raise ValueError("robot_feedback_valid must be 0 or 1")
+            result[f"{prefix}_{name}"] = value
+    return result
+
+
+class RobotObservationRecorder:
+    """Bounded scalar-only buffering; disk writes happen only at close."""
+
+    def __init__(self, directory, metadata=None, max_samples=10000):
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True)
+        if any((self.directory / name).exists() for name in (
+            "observations.csv", "observation_session.json", "observation_report.txt",
+        )):
+            raise FileExistsError(f"Refusing to overwrite robot observation timing: {self.directory}")
+        self.metadata = dict(metadata or {})
+        self.max_samples = _integer(max_samples, "max_samples", minimum=1)
+        self.rows = []
+        self.seen = 0
+        self.dropped = 0
+        self.closed = False
+        self._cap_warned = False
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.close()
+
+    def record(self, obs, model_use_ns, label="policy"):
+        if self.closed:
+            raise RuntimeError("Robot observation recorder is closed")
+        sampled_ns = _integer(obs.get("robot_observation_monotonic_ns"), "robot observation sampled_ns", minimum=1)
+        model_use_ns = _integer(model_use_ns, "model_use_ns", minimum=1)
+        if model_use_ns < sampled_ns:
+            raise ValueError("Model use timestamp predates robot observation sampling")
+        pending = []
+        for key in sorted(obs):
+            match = re.fullmatch(r"robot(\d+)_feedback_timing", key)
+            if match is None:
+                continue
+            provenance = obs[key]
+            if not isinstance(provenance, dict) or provenance.get("source_kind") != SOURCE_KIND:
+                raise ValueError(f"Invalid robot feedback provenance: {key}")
+            if provenance.get("clip") not in ("before", "after", "none"):
+                raise ValueError(f"Invalid interpolation clipping marker: {key}")
+            row = {
+                "label": str(label), "robot_index": int(match.group(1)),
+                "sampled_ns": sampled_ns, "model_use_ns": model_use_ns,
+                "source_kind": SOURCE_KIND, "clip": provenance["clip"],
+            }
+            for field in ("requested_wall_time", "effective_wall_time", "lower_configured_robot_timestamp", "upper_configured_robot_timestamp"):
+                value = float(provenance[field])
+                if not math.isfinite(value):
+                    raise ValueError(f"Invalid observation {field}")
+                row[field] = value
+            for prefix in ("lower", "upper"):
+                row[f"{prefix}_index"] = _integer(provenance[f"{prefix}_index"], f"{prefix}_index")
+                values = {}
+                for field in TIMING_FIELDS:
+                    values[field] = _integer(provenance[f"{prefix}_{field}"], f"{prefix}_{field}")
+                    row[f"{prefix}_{field}"] = values[field]
+                if values["valid"] != 1:
+                    raise ValueError(f"{key} {prefix} sample lacks valid robot feedback timing")
+                feedback_timing_fields(values, values["controller_receive_ns"])
+                if sampled_ns < values["controller_receive_ns"]:
+                    raise ValueError(f"{key} {prefix} robot sample is newer than get_obs completion")
+                for state in ("eef", "joint"):
+                    for stage, stamp in (("sample", sampled_ns), ("model_use", model_use_ns)):
+                        row[f"{prefix}_{state}_sdk_to_{stage}_ms"] = (stamp - values[f"{state}_source_ns"]) / 1e6
+                row[f"{prefix}_client_return_to_model_use_ms"] = (model_use_ns - values["client_return_ns"]) / 1e6
+                row[f"{prefix}_controller_receive_to_model_use_ms"] = (model_use_ns - values["controller_receive_ns"]) / 1e6
+            pending.append(row)
+        if not pending:
+            raise ValueError("Observation contains no robotN_feedback_timing provenance")
+        self.seen += len(pending)
+        available = max(0, self.max_samples - len(self.rows))
+        self.rows.extend(pending[:available])
+        self.dropped += max(0, len(pending) - available)
+        if self.dropped and not self._cap_warned:
+            warnings.warn("Robot observation trace reached its row limit; control continues", RuntimeWarning, stacklevel=2)
+            self._cap_warned = True
+
+    def close(self):
+        if self.closed:
+            return
+        csv_path = self.directory / "observations.csv"
+        fields = list(self.rows[0]) if self.rows else ["label", "robot_index", "sampled_ns", "model_use_ns"]
+        with csv_path.open("w", newline="") as stream:
+            writer = csv.DictWriter(stream, fieldnames=fields)
+            writer.writeheader()
+            writer.writerows(self.rows)
+        session = {
+            "metadata": self.metadata, "source_kind": SOURCE_KIND,
+            "max_samples": self.max_samples, "seen": self.seen,
+            "recorded": len(self.rows), "dropped": self.dropped,
+            "scope": "SDK cache update through get_obs interpolation to model use; excludes encoder sampling and earlier CAN/cache delay",
+        }
+        (self.directory / "observation_session.json").write_text(json.dumps(session, indent=2, ensure_ascii=False) + "\n")
+        (self.directory / "observation_report.txt").write_text(self._report())
+        # The controller CSV savers close before this recorder. Their first
+        # reports could not yet see the final policy windows; refresh them now.
+        from utils.robot_latency import print_report
+        for csv_path in sorted(self.directory.glob("robot*/samples.csv")):
+            if not re.fullmatch(r"robot\d+", csv_path.parent.name):
+                continue
+            report = io.StringIO()
+            with redirect_stdout(report):
+                print_report(csv_path)
+            (csv_path.parent / "report.txt").write_text(report.getvalue())
+        self.closed = True
+
+    def _report(self):
+        lines = [
+            f"Robot observation timing: {len(self.rows)} recorded rows; {self.dropped} dropped; units ms",
+            "Source: SDK_cache_update; encoder sampling and preceding CAN/cache delay are excluded.",
+            "Model use is the client boundary before the policy request, not server dispatch or GPU execution.",
+            "Lower/upper are the actual interpolation bracket samples, not one invented source time for the interpolated pose.",
+        ]
+        if self.metadata.get("record_errors"):
+            lines.append(f"WARNING: {self.metadata['record_errors']} observation timing records failed; see observation_session.json.")
+        counts = {name: sum(row["clip"] == name for row in self.rows) for name in ("before", "after", "none")}
+        lines.append(f"Interpolation clipping: before={counts['before']} after={counts['after']} none={counts['none']}")
+        if self.rows:
+            bound = max(row[f"{prefix}_clock_uncertainty_ns"] for row in self.rows for prefix in ("lower", "upper")) / 1e6
+            lines.append(f"Maximum source clock uncertainty: +/-{bound:.6f} ms")
+            for key in self.rows[0]:
+                if not key.endswith("_ms"):
+                    continue
+                values = sorted(row[key] for row in self.rows)
+                position = .95 * (len(values) - 1)
+                p95 = values[math.floor(position)] + (values[math.ceil(position)] - values[math.floor(position)]) * (position % 1)
+                lines.append(f"  {key}: n={len(values)} mean={statistics.fmean(values):.3f} p50={statistics.median(values):.3f} p95={p95:.3f} min={min(values):.3f} max={max(values):.3f}")
+        return "\n".join(lines) + "\n"
