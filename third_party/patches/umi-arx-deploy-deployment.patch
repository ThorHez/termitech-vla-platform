+"""Server timing tests use fake SDK objects; no network or robot is opened."""
+
+import importlib.util
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+import numpy as np
+
+from utils.robot_latency_server import RobotLatencyServer
+
+
+class ServerTimingTests(unittest.TestCase):
+    def helper(self, readings=(100_000_000_000, 100_000_000_400, 100_000_000_500)):
+        helper = RobotLatencyServer(clock_ns=mock.Mock(side_effect=readings), clock_id="linux:fake")
+        helper.new_sdk_instance()
+        return helper
+
+    def decorate(self, helper, *, request=None, controller=None, eef_s=9.99, joint_s=9.992):
+        request = request if request is not None else {
+            "cmd": "GET_STATE", "_robot_latency": {"version": 1, "request_id": "req-1"},
+        }
+        controller = controller if controller is not None else mock.Mock(get_timestamp=lambda: 10.0)
+        payload = {"ee_pose": np.arange(6), "timestamp": eef_s}
+        reply = {"cmd": request["cmd"], "data": payload}
+        result = helper.decorate_reply(
+            request, reply, controller, 99_999_999_000,
+            eef_state=SimpleNamespace(timestamp=eef_s),
+            joint_state=SimpleNamespace(timestamp=joint_s),
+        )
+        self.assertIs(result, reply)
+        self.assertIs(result["data"], payload)
+        return result
+
+    def test_distinct_snapshots_map_into_conservative_host_bounds(self):
+        helper = self.helper()
+        timing = self.decorate(helper)["robot_latency"]
+        self.assertEqual(timing["eef_source_ns"], 99_990_000_200)
+        self.assertEqual(timing["joint_source_ns"], 99_992_000_200)
+        self.assertEqual(timing["clock_uncertainty_ns"], 2_200)
+        self.assertEqual(timing["eef_sdk_timestamp_s"], 9.99)
+        self.assertEqual(timing["joint_sdk_timestamp_s"], 9.992)
+        self.assertEqual(timing["server_received_ns"], 99_999_999_000)
+        self.assertEqual(timing["server_send_ns"], 100_000_000_500)
+        self.assertEqual(timing["request_id"], "req-1")
+        self.assertEqual(timing["source_kind"], "SDK_cache_update")
+        self.assertEqual(timing["clock_id"], "linux:fake")
+        # Extremes include both independent 1us SDK quantization errors.
+        self.assertEqual(timing["eef_source_ns"] - timing["clock_uncertainty_ns"], 99_989_998_000)
+        self.assertEqual(timing["eef_source_ns"] + timing["clock_uncertainty_ns"], 99_990_002_400)
+
+    def test_untraced_or_other_commands_do_not_query_sdk_clock(self):
+        for request in ({"cmd": "GET_STATE"}, {"cmd": "SET_EE_POSE"}, {
+            "cmd": "RESET_TO_HOME", "_robot_latency": {"version": 1, "request_id": "x"},
+        }):
+            helper = self.helper()
+            controller = mock.Mock()
+            result = self.decorate(helper, request=request, controller=controller)
+            self.assertNotIn("robot_latency", result)
+            controller.get_timestamp.assert_not_called()
+            helper.clock_ns.assert_not_called()
+
+    def test_bad_metadata_preserves_normal_reply_without_sdk_call(self):
+        for probe in (None, [], {}, {"version": 2, "request_id": "x"},
+                      {"version": True, "request_id": "x"},
+                      {"version": 1, "request_id": ""}, {"version": 1, "request_id": 3}):
+            helper = self.helper()
+            controller = mock.Mock()
