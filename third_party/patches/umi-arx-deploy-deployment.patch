@@ -0,0 +1,124 @@
+"""Exercise the actual controller loop with a fake robot, never real hardware."""
+
+from contextlib import redirect_stdout
+import ast
+import enum
+import io
+from pathlib import Path
+import time
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest import mock
+
+import numpy as np
+
+from modules.pose_trajectory_interpolator import PoseTrajectoryInterpolator
+
+# Extract the production methods so this regression needs neither shared-memory
+# drivers nor a robot installation in the test interpreter.
+source = Path(__file__).resolve().parents[1] / "modules" / "arx5_controller.py"
+tree = ast.parse(source.read_text())
+command = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Command")
+controller_class = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Arx5Controller")
+controller_class.bases = []
+controller_class.body = [node for node in controller_class.body if isinstance(node, ast.FunctionDef)
+                         and node.name in ("_record_feedback_timing", "_run_control")]
+module = ModuleType("controller_timing_test")
+module.__dict__.update(np=np, enum=enum, time=time, PoseTrajectoryInterpolator=PoseTrajectoryInterpolator,
+                       precise_wait=lambda *args, **kwargs: None)
+exec(compile(ast.Module(body=[command, controller_class], type_ignores=[]), str(source), "exec"), module.__dict__)
+
+
+class RobotControllerTimingTests(unittest.TestCase):
+    def run_control(self, *, enabled=False, broken_recorder=False, missing_timing=False, malformed_timing=False):
+        events, samples = [], []
+        pose = np.array([0.1, 0.2, 0.3, 0.0, 0.0, 0.0])
+        timing = {
+            "eef_source_ns": 990_000_000, "joint_source_ns": 991_000_000,
+            "client_return_ns": 1_000_000_000, "clock_uncertainty_ns": 2000,
+        }
+        if malformed_timing:
+            timing["eef_source_ns"] = 0
+        client = SimpleNamespace(
+            tcp_pose=pose, gripper_pos=0.03, joint_pos=np.arange(6), joint_vel=np.zeros(6),
+            latest_state_latency=None if missing_timing else timing,
+            latest_latency_error="missing probe" if missing_timing else None,
+            reset_to_home=lambda: events.append("reset"),
+            get_gain=lambda: {"kp": np.zeros(6)},
+            set_gain=lambda gain: events.append(("gain", gain["kp"].copy())),
+            get_state=lambda: events.append("get_state"),
+            set_tcp_pose=lambda pose, grip: events.append(("set_tcp_pose", pose.copy(), grip)),
+            set_to_damping=lambda: events.append("damping"),
+        )
+
+        def save(state):
+            events.append("ring_put")
+            samples.append({k: v.copy() if isinstance(v, np.ndarray) else v for k, v in state.items()})
+
+        recorder = SimpleNamespace(record=mock.Mock(side_effect=RuntimeError("disk failed") if broken_recorder else None))
+        controller = SimpleNamespace(
+            robot_client=client, robot_latency_output_dir="unused" if enabled else None,
+            _robot_latency_errors=0, _robot_latency_recorder=recorder,
+            receive_keys=[("ActualTCPPose", "tcp_pose"), ("ActualQ", "joint_pos"),
+                          ("ActualQd", "joint_vel"), ("gripper_position", "gripper_pos")],
+            receive_latency=0.2, frequency=200, verbose=False,
+            input_queue=SimpleNamespace(get_k=lambda _: {"cmd": np.array([module.Command.STOP.value])}),
+            ring_buffer=SimpleNamespace(put=save), ready_event=SimpleNamespace(set=lambda: events.append("ready")),
+        )
+        controller._record_feedback_timing = lambda state, label: module.Arx5Controller._record_feedback_timing(
+            controller, state, label=label,
+        )
+        clock = SimpleNamespace(
+            time=lambda: 1700.0, monotonic=lambda: 1.003, monotonic_ns=lambda: 1_003_000_000,
+            sleep=lambda duration: events.append(("sleep", duration)),
+        )
+        with mock.patch.object(module, "time", clock), mock.patch.object(
+            module, "precise_wait", side_effect=lambda deadline, **_: events.append(("wait", deadline)),
+        ), redirect_stdout(io.StringIO()):
+            module.Arx5Controller._run_control(controller)
+        return controller, events, samples, recorder
+
+    def test_enabled_tracing_preserves_original_commands_states_and_timestamps(self):
+        _, baseline_events, baseline, _ = self.run_control()
+        _, events, traced, recorder = self.run_control(enabled=True)
+        self.assertEqual(len(baseline_events), len(events))
+        for expected, actual in zip(baseline_events, events):
+            if isinstance(expected, tuple):
+                for a, b in zip(expected, actual):
+                    np.testing.assert_array_equal(a, b)
+            else:
+                self.assertEqual(expected, actual)
+        self.assertEqual(len(baseline), 1)
+        for key, value in baseline[0].items():
+            np.testing.assert_array_equal(traced[0][key], value)
+        self.assertEqual(traced[0]["robot_feedback_valid"], 1)
+        self.assertEqual(traced[0]["robot_eef_source_monotonic_ns"], 990_000_000)
+        self.assertEqual(traced[0]["robot_controller_receive_monotonic_ns"], 1_003_000_000)
+        recorder.record.assert_called_once()
+        self.assertEqual(recorder.record.call_args.kwargs["label"], "control")
+
+    def test_recording_failure_does_not_discard_robot_feedback(self):
+        controller, _, samples, _ = self.run_control(enabled=True, broken_recorder=True)
+        self.assertEqual(controller._robot_latency_errors, 1)
+        self.assertEqual(len(samples), 1)
+        self.assertEqual(samples[0]["robot_feedback_valid"], 1)
+
+    def test_missing_timing_is_marked_invalid_and_not_reused(self):
+        controller, _, samples, recorder = self.run_control(enabled=True, missing_timing=True)
+        self.assertEqual(controller._robot_latency_errors, 1)
+        self.assertEqual(samples[0]["robot_feedback_valid"], 0)
+        self.assertEqual(samples[0]["robot_eef_source_monotonic_ns"], 0)
+        recorder.record.assert_not_called()
+
+    def test_invalid_shared_memory_timing_does_not_interrupt_control(self):
+        controller, events, samples, recorder = self.run_control(enabled=True, malformed_timing=True)
+        self.assertEqual(controller._robot_latency_errors, 1)
+        self.assertEqual(len(samples), 1)
+        self.assertEqual(samples[0]["robot_feedback_valid"], 0)
+        self.assertEqual(samples[0]["robot_eef_source_monotonic_ns"], 0)
+        self.assertIn("ring_put", events)
+        recorder.record.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
