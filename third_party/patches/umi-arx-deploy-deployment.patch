+"""Clock calibration and wire timestamps without a camera or network server."""
+
+from pathlib import Path
+import sys
+import unittest
+from unittest import mock
+
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "packages" / "openpi-client" / "src"))
+from openpi_client import msgpack_numpy
+from openpi_client import websocket_client_policy as client_module
+
+
+class PolicyLatencyClientTests(unittest.TestCase):
+    def make_client(self, **kwargs):
+        socket = mock.Mock()
+        metadata = {"latency_protocol": 1, "latency_clock_id": "linux:server"}
+        with mock.patch.object(client_module.WebsocketClientPolicy, "_wait_for_server", return_value=(socket, metadata)):
+            client = client_module.WebsocketClientPolicy(**kwargs)
+        return client, socket
+
+    def clock_response(self, received, sent, clock_id="linux:server"):
+        return msgpack_numpy.packb({
+            "latency_probe": {"clock_id": clock_id, "received_ns": received, "sent_ns": sent},
+        })
+
+    def enable_same_clock(self, client, socket):
+        socket.recv.return_value = self.clock_response(110, 120)
+        with mock.patch.object(client_module, "_local_clock_id", return_value="linux:server"), \
+             mock.patch.object(client_module.time, "monotonic_ns", side_effect=[100, 130]):
+            client.enable_latency_probe(clock_samples=1)
+        socket.reset_mock()
+
+    def test_default_client_keeps_legacy_payload_and_response(self):
+        client, socket = self.make_client()
+        socket.recv.return_value = msgpack_numpy.packb({"actions": [1]})
+        obs = {"mode": "infer_step", "frame": [1, 2]}
+        with mock.patch.object(client_module.time, "monotonic_ns", side_effect=AssertionError("not enabled")):
+            self.assertEqual(client.infer(obs), {"actions": [1]})
+        self.assertEqual(msgpack_numpy.unpackb(socket.send.call_args.args[0]), obs)
+        socket.recv.assert_called_once_with()
+
+    def test_clock_bounds_choose_tightest_exchange_without_symmetric_network_assumption(self):
+        client, socket = self.make_client()
+        # First interval [930, 1000], second [985, 995]. Server compute time is excluded.
+        socket.recv.side_effect = [self.clock_response(1100, 1130), self.clock_response(1195, 1205)]
+        with mock.patch.object(client_module, "_local_clock_id", return_value="linux:client"), \
+             mock.patch.object(client_module.time, "monotonic_ns", side_effect=[100, 200, 200, 220]):
+            mapping = client.enable_latency_probe(clock_samples=2)
+        self.assertFalse(mapping["same_clock"])
+        self.assertEqual((mapping["offset_lower_ns"], mapping["offset_upper_ns"]), (985, 995))
+        self.assertEqual(mapping["uncertainty_ns"], 10)
+        self.assertEqual(mapping["measured_ns"], 220)
+        self.assertEqual(msgpack_numpy.unpackb(socket.send.call_args.args[0]), {"_latency_probe": {"kind": "clock"}})
+
+    def test_shared_clock_uses_zero_offset(self):
+        client, socket = self.make_client()
+        self.enable_same_clock(client, socket)
+        mapping = client.latency_clock_mapping
+        self.assertTrue(mapping["same_clock"])
+        self.assertEqual((mapping["offset_lower_ns"], mapping["offset_upper_ns"], mapping["uncertainty_ns"]), (0, 0, 0))
+
+    def test_unsupported_metadata_is_rejected_before_probe_send(self):
+        client, socket = self.make_client()
+        client._server_metadata = {}
+        with self.assertRaisesRegex(RuntimeError, "does not support"):
+            client.enable_latency_probe()
+        socket.send.assert_not_called()
+
+    def test_bad_clock_responses_do_not_enable_timing(self):
+        cases = [
+            (self.clock_response(110, 120, "linux:other"), "mismatched"),
+            (self.clock_response(120, 110), "inconsistent"),
+            (self.clock_response(110, 150), "inconsistent"),
+            (self.clock_response(210, 220), "Matching clock"),
+        ]
+        for response, message in cases:
+            with self.subTest(message=message):
+                client, socket = self.make_client()
+                socket.recv.return_value = response
+                with mock.patch.object(client_module, "_local_clock_id", return_value="linux:server"), \
+                     mock.patch.object(client_module.time, "monotonic_ns", side_effect=[100, 130]), \
+                     self.assertRaisesRegex(RuntimeError, message):
+                    client.enable_latency_probe(clock_samples=1)
+                self.assertIsNone(client.latency_clock_mapping)
+
+    def test_wire_times_exclude_pack_and_unpack_and_preserve_observation(self):
+        client, socket = self.make_client(request_timeout=600)
+        self.enable_same_clock(client, socket)
+        obs = {"frame": [1, 2, 3]}
+        events = []
+        original_packer = client._packer
+        client._packer = mock.Mock()
+        client._packer.pack.side_effect = lambda value: (events.append("pack"), original_packer.pack(value))[1]
+        socket.send.side_effect = lambda data: events.append("send")
+
+        def receive(**kwargs):
+            events.append("recv")
+            request = msgpack_numpy.unpackb(socket.send.call_args.args[0])
+            return msgpack_numpy.packb({"actions": [1], "latency_probe": {
+                "request_id": request["_latency_probe"]["request_id"],
+                "clock_id": "linux:server", "received_ns": 210, "policy_start_ns": 215,
+                "model_dispatch_ns": 220,
+            }})
+
+        socket.recv.side_effect = receive
+        ticks = iter([200, 300])
+
+        def now():
+            events.append("timestamp")
+            return next(ticks)
+
+        with mock.patch.object(client_module.time, "monotonic_ns", side_effect=now):
+            result = client.infer(obs)
+        self.assertEqual(events, ["pack", "timestamp", "send", "recv", "timestamp"])
+        self.assertEqual(obs, {"frame": [1, 2, 3]})
+        self.assertEqual((result["client_latency"]["send_ns"], result["client_latency"]["return_ns"]), (200, 300))
+        self.assertEqual(result["client_latency"]["request_id"], result["latency_probe"]["request_id"])
+        self.assertIsNot(result["client_latency"]["clock_mapping"], client.latency_clock_mapping)
+        socket.recv.assert_called_once_with(timeout=600)
+
+    def test_inference_probe_rejects_wrong_request_clock_or_event_order(self):
+        overrides = [
+            {"request_id": "unrelated"}, {"clock_id": "linux:restarted"},
+            {"policy_start_ns": 190}, {"model_dispatch_ns": 205},
+            {"received_ns": True},
+        ]
+        for override in overrides:
+            with self.subTest(override=override):
+                client, socket = self.make_client()
+                self.enable_same_clock(client, socket)
+
+                def receive():
+                    request = msgpack_numpy.unpackb(socket.send.call_args.args[0])
+                    probe = {
+                        "request_id": request["_latency_probe"]["request_id"],
+                        "clock_id": "linux:server", "received_ns": 210, "policy_start_ns": 215,
+                    }
+                    probe.update(override)
+                    return msgpack_numpy.packb({"actions": [], "latency_probe": probe})
+
+                socket.recv.side_effect = receive
+                with mock.patch.object(client_module.time, "monotonic_ns", side_effect=[200, 300]), \
+                     self.assertRaises(RuntimeError):
+                    client.infer({})
+
+    def test_clock_timeout_and_close(self):
+        client, socket = self.make_client(request_timeout=2)
+        self.enable_same_clock(client, socket)
+        socket.recv.side_effect = TimeoutError("probe timeout")
+        with self.assertRaises(TimeoutError):
+            client.enable_latency_probe(clock_samples=1)
+        self.assertIsNone(client.latency_clock_mapping)
+        socket.recv.assert_called_once_with(timeout=2)
+        client.close()
+        socket.close.assert_called_once_with()
+
+    def test_connect_timeout_bounds_refused_retry_sleep(self):
+        clock = [0.0]
+
+        def sleep(seconds):
+            clock[0] += seconds
+
+        with mock.patch.object(client_module.time, "monotonic", side_effect=lambda: clock[0]), \
+             mock.patch.object(client_module.time, "sleep", side_effect=sleep), \
+             mock.patch.object(client_module.websockets.sync.client, "connect", side_effect=ConnectionRefusedError) as connect, \
+             self.assertRaisesRegex(TimeoutError, "Timed out connecting"):
+            client_module.WebsocketClientPolicy(connect_timeout=7)
+        self.assertEqual(clock[0], 7)
+        self.assertEqual([call.kwargs["open_timeout"] for call in connect.call_args_list], [7, 2])
+
+    def test_connection_metadata_timeout_is_bounded_and_closes_connection(self):
+        socket = mock.Mock()
+        socket.recv.side_effect = TimeoutError("metadata")
+        with mock.patch.object(client_module.time, "monotonic", side_effect=[100, 100, 103]), \
+             mock.patch.object(client_module.websockets.sync.client, "connect", return_value=socket), \
+             self.assertRaises(TimeoutError):
+            client_module.WebsocketClientPolicy(connect_timeout=7)
+        socket.recv.assert_called_once_with(timeout=4)
+        socket.close.assert_called_once_with()
+
+
+if __name__ == "__main__":
+    unittest.main()
