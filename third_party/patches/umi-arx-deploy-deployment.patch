@@ -0,0 +1,359 @@
+"""Offline CAN-cache reconstruction matched against saved SDK joint snapshots.
+
+No sockets or robot controllers are constructed. Repeated values remain
+ambiguous. Even a unique match is conditional on the SDK receiving the same
+ordered RX stream as the passive observer; it is not an encoder timestamp.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+import csv
+import ctypes
+import json
+import math
+from pathlib import Path
+import statistics
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from tools.can_audit.decode_feedback import FeedbackDecoder
+
+
+MOTORS = (1, 2, 4, 5, 6, 7, 8)
+FIELDS = ("position_rad", "velocity_rad_s", "current_raw")
+EC_IDS = (1, 2, 4)
+GRIPPER_OPEN_READOUT = 5.15507
+GRIPPER_WIDTH = .088
+
+
+def close_roundoff(a, b):
+    return math.isfinite(a) and math.isfinite(b) and abs(a - b) <= max(1e-13, 8 * math.ulp(a), 8 * math.ulp(b))
+
+
+def sdk_values(motor_id, raw, *, gripper_width=GRIPPER_WIDTH, gripper_open=GRIPPER_OPEN_READOUT):
+    position, velocity, current = raw
+    if motor_id == 8:
+        return (position / gripper_open * gripper_width,
+                velocity / gripper_open * gripper_width, current * .424)
+    torque = current * 1.4 * 1.4 if motor_id in EC_IDS else current * .424
+    return position, velocity, torque
+
+
+def canonical_raw(motor_id, values, *, gripper_width=GRIPPER_WIDTH, gripper_open=GRIPPER_OPEN_READOUT):
+    """Invert SDK units, then require forward conversion to differ only by roundoff.
+
+    Float32 rounding creates an exact lookup key, not a value-match tolerance:
+    the forward check rejects values merely near a CAN quantization bin.
+    """
+    position, velocity, torque = map(float, values)
+    if not all(math.isfinite(value) for value in (position, velocity, torque)):
+        raise ValueError("SDK state contains a nonfinite value")
+    if motor_id == 8:
+        position = position / gripper_width * gripper_open
+        velocity = velocity / gripper_width * gripper_open
+    current = torque / (1.4 * 1.4 if motor_id in EC_IDS else .424)
+    raw = tuple(ctypes.c_float(value).value for value in (position, velocity, current))
+    transformed = sdk_values(motor_id, raw, gripper_width=gripper_width, gripper_open=gripper_open)
+    if not all(close_roundoff(a, float(b)) for a, b in zip(transformed, values)):
+        raise ValueError(f"Motor {motor_id} state does not round-trip through audited float32 SDK transforms")
+    return raw
+
+
+def flatten(values):
+    return tuple(value for motor in MOTORS for value in values[motor])
+
+
+def describe_candidates(candidates, source_ns, source_uncertainty_ns):
+    eligible, boundary, definite, future = [], [], [], []
+    for candidate in candidates:
+        receive_ns = candidate["receive_ns"]
+        uncertainty = candidate["uncertainty_ns"]
+        if receive_ns - uncertainty > source_ns + source_uncertainty_ns:
+            future.append(candidate)
+        else:
+            eligible.append(candidate)
+            if receive_ns + uncertainty <= source_ns - source_uncertainty_ns:
+                definite.append(candidate)
+            else:
+                boundary.append(candidate)
+    result = {
+        "status": ("unique_in_capture" if len(eligible) == 1 else "ambiguous" if eligible
+                   else "future_only" if future else "unmatched"),
+        "candidate_count": len(eligible), "definitely_before_count": len(definite),
+        "clock_boundary_count": len(boundary), "future_match_count": len(future),
+        "pre_capture_same_value_not_excluded": True,
+        "earliest_match_seq": "", "latest_match_seq": "",
+        "earliest_match_receive_ns": "", "latest_match_receive_ns": "",
+        "latest_match_age_ms": "", "latest_match_age_lower_bound_ms": "",
+        "earliest_match_age_upper_in_capture_ms": "",
+    }
+    if eligible:
+        earliest = min(eligible, key=lambda item: item["receive_ns"])
+        latest = max(eligible, key=lambda item: item["receive_ns"])
+        result.update(
+            earliest_match_seq=earliest["seq"], latest_match_seq=latest["seq"],
+            earliest_match_receive_ns=earliest["receive_ns"], latest_match_receive_ns=latest["receive_ns"],
+            latest_match_age_ms=(source_ns - latest["receive_ns"]) / 1e6,
+            latest_match_age_lower_bound_ms=max(0, source_ns - source_uncertainty_ns
+                                                - max(v["receive_ns"] + v["uncertainty_ns"] for v in eligible)) / 1e6,
+            earliest_match_age_upper_in_capture_ms=(source_ns + source_uncertainty_ns
+                                                    - min(v["receive_ns"] - v["uncertainty_ns"] for v in eligible)) / 1e6,
+        )
+    return result, eligible
+
+
+def stats(values):
+    values = sorted(float(value) for value in values)
+    if not values:
+        return {"n": 0}
+    offset = .95 * (len(values) - 1)
+    p95 = values[math.floor(offset)] + (values[math.ceil(offset)] - values[math.floor(offset)]) * (offset % 1)
+    return dict(n=len(values), mean=statistics.fmean(values), p50=statistics.median(values),
+                p95=p95, min=values[0], max=values[-1])
+
+
+class Reconstruction:
+    def __init__(self, clock_envelope_ns=0):
+        self.clock_envelope_ns = clock_envelope_ns
+        self.motor_index = {motor: defaultdict(list) for motor in MOTORS}
+        self.whole_index = defaultdict(list)
+        self.initialized = {motor: set() for motor in MOTORS}
+        self.field_writes = {motor: {} for motor in MOTORS}
+        self.current = {}
+        self.events = {motor: [] for motor in MOTORS}
+        self.counts = Counter()
+
+    def add(self, frame, decoded):
+        if frame.get("locally_generated"):
+            self.counts["tx_ignored"] += 1
+            return
+        self.counts["remote_rx"] += 1
+        if decoded is None:
+            self.counts["unrecognized_rx"] += 1
+            return
+        motor = decoded["motor_id"]
+        if decoded.get("decode_skipped"):
+            self.counts["skipped_decode"] += 1
+            self.initialized[motor].clear()
+            self.current.pop(motor, None)
+            return
+        updated = set(decoded["updated_fields"]) & set(FIELDS)
+        if not updated:
+            self.counts["no_relevant_field_update"] += 1
+            return
+        self.counts["partial_updates" if len(updated) < 3 else "full_updates"] += 1
+        timing = dict(seq=int(frame["capture_seq"]), receive_ns=int(frame["kernel_monotonic_ns"]),
+                      uncertainty_ns=int(frame["clock_anchor"]["uncertainty_ns"]) + self.clock_envelope_ns)
+        for field in updated:
+            self.field_writes[motor][field] = timing
+        self.initialized[motor].update(updated)
+        if self.initialized[motor] != set(FIELDS):
+            self.counts["initialization_incomplete"] += 1
+            return
+        event = dict(timing, motor_id=motor, raw=tuple(decoded[key] for key in FIELDS),
+                     position_updated="position_rad" in updated,
+                     writes=dict(self.field_writes[motor]))
+        self.events[motor].append(event)
+        self.motor_index[motor][event["raw"]].append(event)
+        self.current[motor] = event
+        if len(self.current) == len(MOTORS):
+            key = flatten({motor: self.current[motor]["raw"] for motor in MOTORS})
+            self.whole_index[key].append(dict(timing, motors=dict(self.current)))
+
+
+def state_raw(state):
+    values = {motor: (state["joint_pos"][index], state["joint_vel"][index], state["joint_torque"][index])
+              for index, motor in enumerate(MOTORS[:-1])}
+    values[8] = (state["gripper_pos"], state["gripper_vel"], state["gripper_torque"])
+    return {motor: canonical_raw(motor, values[motor]) for motor in MOTORS}
+
+
+def write_csv(path, rows):
+    with Path(path).open("w", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(rows[0]) if rows else ["sample_index"])
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def analyze(directory, decoder=None):
+    directory = Path(directory)
+    session = json.loads((directory / "session.json").read_text())
+    offsets = session.get("wall_to_monotonic_offset_range") or [0, 0]
+    clock_envelope = max(offsets) - min(offsets)
+    reconstruction = Reconstruction(clock_envelope)
+    decoder = decoder or FeedbackDecoder()
+    with (directory / "can_frames.jsonl").open() as stream:
+        for line in stream:
+            frame = json.loads(line)
+            decoded = decoder.decode(frame["can_id"], bytes.fromhex(frame["data_hex"]),
+                                     locally_generated=frame["locally_generated"])
+            reconstruction.add(frame, decoded)
+    motor_rows, whole_rows, attribution_rows = [], [], []
+    sdk_stamps, sdk_receive_ages, unique_whole = [], [], []
+    sdk_instances, clock_ids = set(), set()
+    with (directory / "sdk_states.jsonl").open() as stream:
+        for sample_index, line in enumerate(stream, 1):
+            reply = json.loads(line)
