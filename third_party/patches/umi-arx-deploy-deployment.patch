--- /dev/null
+++ b/tools/can_audit/decode_feedback.py
@@ -0,0 +1,155 @@
+"""Offline decoding of captured X5 feedback with the audited SDK's pure parsers.
+
+No controller/ArxCan/SocketCAN object is constructed. This module cannot open a
+CAN socket or send a command. It only passes validated saved bytes into the
+exported RV_can_data_repack / DM_can_data_repack functions and a private array.
+"""
+
+import argparse
+import ctypes
+import hashlib
+import json
+from pathlib import Path
+import sys
+import threading
+
+
+DEFAULT_LIBRARY = Path("/home/lenovo/kian/arx5-sdk/lib/x86_64/libhardware.so")
+DEFAULT_SOEM = Path("/media/lenovo/data/miniconda3/envs/arx-py310/lib/libsoem.so")
+AUDITED_SHA256 = "34875c929a572efde835fff2d0cbb6d20e8aa484ef5def97a309d769526a86ff"
+X5_JOINT_MOTOR_IDS = (1, 2, 4, 5, 6, 7)
+X5_EC_IDS = frozenset((1, 2, 4))
+X5_DM_IDS = frozenset((5, 6, 7, 8))
+
+
+class _MotorMessage(ctypes.Structure):
+    _fields_ = [
+        ("current_actual_int", ctypes.c_int16),
+        ("speed_actual_rad", ctypes.c_float),
+        ("angle_actual_rad", ctypes.c_float),
+        ("motor_id", ctypes.c_uint16),
+        ("temperature", ctypes.c_uint8),
+        ("error", ctypes.c_uint8),
+        ("angle_actual_float", ctypes.c_float),
+        ("current_actual_float", ctypes.c_float),
+        ("gripper_pos", ctypes.c_float),
+        ("gripper_spd", ctypes.c_float),
+        ("gripper_cur", ctypes.c_float),
+        ("gripper_last_pos", ctypes.c_float),
+        ("gripper_totalangle", ctypes.c_float),
+        ("round_cnt", ctypes.c_float),
+    ]
+
+
+_DECODE_LOCK = threading.Lock()  # RV parser has a process-global float scratch union.
+
+
+class FeedbackDecoder:
+    """Private cache; feed only remote received frames in capture order.
+
+    Callers must set locally_generated=True for SocketCAN local TX echo. CAN ID
+    alone does not identify direction: EC commands and feedback share IDs.
+    The return values preserve the native float32 representation used by SDK.
+    Use updated_fields / position_updated; auxiliary replies can retain position.
+    """
+
+    def __init__(self, library=DEFAULT_LIBRARY, soem=DEFAULT_SOEM):
+        library = Path(library)
+        digest = hashlib.sha256(library.read_bytes()).hexdigest()
+        if digest != AUDITED_SHA256:
+            raise ValueError("libhardware.so differs from the audited binary; review ABI and parsers before decoding")
+        if ctypes.sizeof(_MotorMessage) != 48 or _MotorMessage.angle_actual_rad.offset != 8:
+            raise RuntimeError("Unsupported OD_Motor_Msg ABI")
+        self.library_path = str(library.resolve())
+        self.library_sha256 = digest
+        self._soem = ctypes.CDLL(str(soem), mode=ctypes.RTLD_GLOBAL)
+        self._library = ctypes.CDLL(str(library))
+        self._rv = getattr(self._library, "_Z18RV_can_data_repackjPhihRSt5arrayI12OD_Motor_MsgLm10EE")
+        self._dm = getattr(self._library, "_Z18DM_can_data_repackPhRSt5arrayI12OD_Motor_MsgLm10EE")
+        data_pointer = ctypes.POINTER(ctypes.c_uint8)
+        cache_pointer = ctypes.POINTER(_MotorMessage)
+        self._rv.argtypes = (ctypes.c_uint32, data_pointer, ctypes.c_int32, ctypes.c_uint8, cache_pointer)
+        self._dm.argtypes = (data_pointer, cache_pointer)
+        self._rv.restype = self._dm.restype = None
+        self._cache = (_MotorMessage * 10)()
+
+    def decode(self, can_id, payload, *, locally_generated=False):
+        if type(can_id) is not int or can_id < 0:
+            raise ValueError("can_id must be a nonnegative integer")
+        if not isinstance(payload, (bytes, bytearray)) or len(payload) > 8:
+            raise ValueError("payload must contain at most eight bytes")
+        if locally_generated or can_id > 0x7ff:
+            return None  # Ignore TX echo and flagged extended/RTR/error frames.
+        if can_id == 0:
+            if len(payload) < 6:
+                raise ValueError("Truncated DM feedback needs at least six bytes")
+            motor_id = payload[0] & 0x0f
+            if motor_id not in X5_DM_IDS:
+                return None
+            protocol = "DM_J4310"
+            reply_type = None
+            updated = ["motor_id", "position_rad", "velocity_rad_s", "current_raw"]
+        elif can_id in X5_EC_IDS:
+            if not payload:
+                raise ValueError("Empty EC feedback")
+            motor_id = can_id
+            protocol = "EC_A4310"
+            reply_type = payload[0] >> 5
+            required = {1: 7, 2: 8}.get(reply_type, 1)
+            if len(payload) < required:
+                raise ValueError(f"Truncated EC reply type {reply_type} needs at least {required} bytes")
+            if reply_type == 5:
+                # This unusual query branch prints from C and uses shared scratch
+                # state. It is not the standard packed feedback path being audited.
+                return {
+                    "motor_id": motor_id, "protocol": protocol, "reply_type": reply_type,
+                    "position_updated": False, "updated_fields": [],
+                    "decode_skipped": "EC auxiliary query reply type 5 is outside the audited packed-feedback decoder",
+                }
+            updated = ["motor_id", "error"]
+            if reply_type == 1:
+                updated += ["position_rad", "velocity_rad_s", "current_raw", "temperature"]
+            elif reply_type == 2:
+                updated += ["aux_angle_float", "current_int", "current_raw", "temperature"]
+        else:
+            return None
+        buffer = (ctypes.c_uint8 * 8)()
+        buffer[:len(payload)] = payload
+        with _DECODE_LOCK:
+            if can_id == 0:
+                self._dm(buffer, self._cache)
+            else:
+                self._rv(can_id, buffer, len(payload), 0, self._cache)
+            state = self._cache[motor_id]
+            return {
+                "motor_id": motor_id, "protocol": protocol, "reply_type": reply_type,
+                "position_updated": "position_rad" in updated, "updated_fields": updated,
+                "position_rad": float(state.angle_actual_rad),
+                "velocity_rad_s": float(state.speed_actual_rad),
+                "current_raw": float(state.current_actual_float),
+                "current_int": int(state.current_actual_int),
+                "aux_angle_float": float(state.angle_actual_float),
+                "error": int(state.error), "temperature": int(state.temperature),
+            }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("input", type=Path, help="Saved JSONL records with can_id and data_hex")
+    parser.add_argument("--library", type=Path, default=DEFAULT_LIBRARY)
+    parser.add_argument("--soem", type=Path, default=DEFAULT_SOEM)
+    args = parser.parse_args()
+    decoder = FeedbackDecoder(args.library, args.soem)
+    with args.input.open() as stream:
+        for number, line in enumerate(stream, 1):
+            record = json.loads(line)
+            can_id = record["can_id"]
+            if isinstance(can_id, str):
+                can_id = int(can_id, 0)
+            decoded = decoder.decode(can_id, bytes.fromhex(record["data_hex"]),
+                                     locally_generated=bool(record.get("locally_generated", False)))
+            print(json.dumps({"line": number, "decoded": decoded}, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
