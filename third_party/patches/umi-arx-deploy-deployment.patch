+"""Exercise the production observation method without importing robot drivers."""
+
+import ast
+import copy
+import math
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+import numpy as np
+
+from utils.interpolation_util import get_interp1d, PoseInterpolator
+
+
+ENV_PATH = Path(__file__).resolve().parents[1] / "modules" / "arx5_env.py"
+
+
+def _load_get_obs(clock):
+    tree = ast.parse(ENV_PATH.read_text())
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Arx5Env")
+    method = next(node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name == "get_obs")
+    namespace = {
+        "np": np, "math": math, "time": clock,
+        "PoseInterpolator": PoseInterpolator, "get_interp1d": get_interp1d,
+    }
+    exec(compile(ast.Module(body=[method], type_ignores=[]), str(ENV_PATH), "exec"), namespace)
+    return namespace["get_obs"]
+
+
+def _camera_data():
+    def camera(timestamps, stamps, pixels):
+        return {
+            "timestamp": np.asarray(timestamps),
+            "camera_read_monotonic_ns": np.asarray(stamps, dtype=np.int64),
+            "color": np.asarray(pixels, dtype=np.uint8).reshape(-1, 1, 1, 1).repeat(3, axis=3),
+        }
+
+    return {
+        0: camera([9.0, 9.95, 10.45, 11.0], [100, 200, 300, 400], [10, 20, 30, 40]),
+        # The latest frame is intentionally not selected: camera 0 anchors time.
+        1: camera([9.6, 10.48, 11.2, 12.0], [500, 600, 700, 800], [50, 60, 70, 80]),
+    }
+
+
+def _environment(data, *, timing=True, events=None, accumulate=True):
+    events = [] if events is None else events
+    state = {
+        "robot_timestamp": np.asarray([9.0, 12.0]),
+        "ActualTCPPose": np.asarray([[0, 0, 0, 0, 0, 0], [3, 6, 9, 0, 0, 0]], dtype=float),
+        "gripper_position": np.asarray([0.0, 0.09]),
+        "ActualQ": np.zeros((2, 6)),
+        "ActualQd": np.zeros((2, 6)),
+    }
+
+    def get_state():
+        events.append("robot read")
+        return state
+
+    def put(**kwargs):
+        events.append("accumulate")
+
+    return SimpleNamespace(
+        is_ready=True, camera=SimpleNamespace(get=mock.Mock(return_value=data)),
+        last_camera_data=None, robots=[SimpleNamespace(get_all_state=get_state)],
+        frequency=2.0, camera_obs_horizon=2, camera_down_sample_steps=1,
+        robot_obs_horizon=2, robot_down_sample_steps=1,
+        enable_camera_timing=timing,
+        obs_accumulator=SimpleNamespace(put=mock.Mock(side_effect=put)) if accumulate else None,
+    )
+
+
+class ObsFrameTimingTests(unittest.TestCase):
+    def test_constructor_keeps_timing_opt_in(self):
+        tree = ast.parse(ENV_PATH.read_text())
+        cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "Arx5Env")
+        constructor = next(node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name == "__init__")
+        defaults = dict(zip(
+            [arg.arg for arg in constructor.args.args[-len(constructor.args.defaults):]],
+            [ast.literal_eval(value) for value in constructor.args.defaults],
+        ))
+        self.assertIs(defaults["enable_camera_timing"], False)
+        self.assertIsNone(defaults["robot_latency_output_dir"])
+
+    def test_exact_selected_stamps_with_real_interpolation_and_accumulation(self):
+        events = []
+
+        def sample_clock():
+            self.assertEqual(events, ["robot read", "accumulate"])
+            return 1000
+
+        clock = SimpleNamespace(monotonic_ns=mock.Mock(side_effect=sample_clock))
+        get_obs = _load_get_obs(clock)
+        data = _camera_data()
+        env = _environment(data, events=events)
+        obs = get_obs(env)
+        np.testing.assert_array_equal(obs["timestamp"], [10.5, 11.0])
+        np.testing.assert_array_equal(obs["camera0_rgb"][:, 0, 0, 0], [30, 40])
+        np.testing.assert_array_equal(obs["camera1_rgb"][:, 0, 0, 0], [60, 70])
+        np.testing.assert_array_equal(obs["camera0_read_monotonic_ns"], [300, 400])
+        np.testing.assert_array_equal(obs["camera1_read_monotonic_ns"], [600, 700])
+        self.assertEqual(obs["sampled_monotonic_ns"], 1000)
+        np.testing.assert_allclose(obs["robot0_eef_pos"], [[1.5, 3.0, 4.5], [2.0, 4.0, 6.0]])
+        np.testing.assert_allclose(obs["robot0_eef_rot_axis_angle"], np.zeros((2, 3)))
+        np.testing.assert_allclose(obs["robot0_gripper_width"], [[0.045], [0.060]])
+        self.assertEqual(env.obs_accumulator.put.call_count, 1)
+        clock.monotonic_ns.assert_called_once_with()
+        for value in data.values():
+            value["camera_read_monotonic_ns"].fill(-1)
+            value["color"].fill(0)
+        np.testing.assert_array_equal(obs["camera1_read_monotonic_ns"], [600, 700])
+        np.testing.assert_array_equal(obs["camera1_rgb"][:, 0, 0, 0], [60, 70])
+
+    def test_disabled_timing_preserves_observations_and_needs_no_stamps_or_clock(self):
+        data = _camera_data()
+        expected = _load_get_obs(SimpleNamespace(monotonic_ns=lambda: 1000))(_environment(copy.deepcopy(data)))
+        for value in data.values():
+            del value["camera_read_monotonic_ns"]
+        clock = SimpleNamespace(monotonic_ns=mock.Mock(side_effect=AssertionError("timing must stay disabled")))
+        observed = _load_get_obs(clock)(_environment(data, timing=False))
+        expected_keys = {key for key in expected if not key.endswith("monotonic_ns")}
+        self.assertEqual(set(observed), expected_keys)
+        for key, value in observed.items():
+            np.testing.assert_array_equal(value, expected[key])
+        clock.monotonic_ns.assert_not_called()
+
+    def test_missing_timing_field_fails_clearly(self):
+        data = _camera_data()
+        del data[1]["camera_read_monotonic_ns"]
+        with self.assertRaisesRegex(RuntimeError, "Camera 1 is missing camera_read_monotonic_ns"):
+            _load_get_obs(SimpleNamespace(monotonic_ns=lambda: 1000))(_environment(data))
+
+    def test_invalid_selected_stamps_fail_only_when_enabled(self):
+        invalid_arrays = (
+            np.asarray([1, 2]),
+            np.asarray([100.0, 200.0, 300.0, 400.0]),
+            np.asarray([True, True, True, True]),
+            np.asarray([100, 200, 0, 400]),
+            np.asarray([100, 200, -1, 400]),
+            np.asarray([100, 200, 300, 1001]),
+        )
+        get_obs = _load_get_obs(SimpleNamespace(monotonic_ns=lambda: 1000))
+        for stamps in invalid_arrays:
+            with self.subTest(stamps=stamps):
+                data = _camera_data()
+                data[0]["camera_read_monotonic_ns"] = stamps
+                with self.assertRaisesRegex(RuntimeError, "Camera 0 has invalid camera_read_monotonic_ns"):
+                    get_obs(_environment(data))
+                self.assertIn("camera0_rgb", get_obs(_environment(data, timing=False)))
+
+    def test_sample_clock_is_recorded_without_active_episode_accumulation(self):
+        obs = _load_get_obs(SimpleNamespace(monotonic_ns=lambda: 1500))(
+            _environment(_camera_data(), accumulate=False)
+        )
+        self.assertEqual(obs["sampled_monotonic_ns"], 1500)
+
+    def test_robot_feedback_diagnostics_preserve_interpolated_pose_and_detect_clipping(self):
+        for timestamps, expected_clip, expected_indices in (
+            ([9.0, 12.0], "none", (0, 1)),
+            ([7.0, 8.0], "after", (1, 1)),
+        ):
+            with self.subTest(timestamps=timestamps):
+                env = _environment(_camera_data(), accumulate=False)
+                states = env.robots[0].get_all_state()
+                states["robot_timestamp"] = np.asarray(timestamps)
+                states.update({
+                    "robot_feedback_valid": np.ones(2, dtype=np.int64),
+                    "robot_eef_source_monotonic_ns": np.array([100, 400]),
+                    "robot_joint_source_monotonic_ns": np.array([102, 402]),
+                    "robot_client_return_monotonic_ns": np.array([110, 410]),
+                    "robot_controller_receive_monotonic_ns": np.array([120, 420]),
+                    "robot_clock_uncertainty_ns": np.array([2, 2]),
+                })
+                get_obs = _load_get_obs(SimpleNamespace(monotonic_ns=lambda: 1000))
+                baseline = get_obs(env)
+                env.enable_robot_timing = True
+                traced = get_obs(env)
+                for key, value in baseline.items():
+                    np.testing.assert_array_equal(traced[key], value)
+                timing = traced["robot0_feedback_timing"]
+                self.assertEqual(timing["clip"], expected_clip)
+                self.assertEqual((timing["lower_index"], timing["upper_index"]), expected_indices)
+                self.assertEqual(timing["requested_wall_time"], 11.0)
+                self.assertEqual(traced["robot_observation_monotonic_ns"], 1000)
+
+
+if __name__ == "__main__":
+    unittest.main()
