+"""Passive tracing tests with synthetic requests; no hardware or measured latency."""
+
+import csv
+import json
+from pathlib import Path
+from queue import Queue
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+import cv2
+import numpy as np
+
+from utils import deployment_latency as tracing
+from utils.camera_latency import HEADER_HEIGHT
+
+
+class DeploymentLatencyTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+
+    def recorder(self, **kwargs):
+        return tracing.DeploymentLatencyRecorder(
+            Path(self.directory.name), {"offset_lower_ns": 0, "offset_upper_ns": 0},
+            {"synthetic_test": True}, show_timer=False, **kwargs,
+        )
+
+    def request(self, recorder, identity="request1"):
+        origin = recorder.origin_ns
+        return {
+            "client_latency": {
+                "request_id": identity, "send_ns": origin + 22_000_000,
+                "return_ns": origin + 40_000_000,
+                "clock_mapping": {"offset_lower_ns": 0, "offset_upper_ns": 0},
+            },
+            "latency_probe": {
+                "request_id": identity, "received_ns": origin + 23_000_000,
+                "policy_start_ns": origin + 24_000_000, "model_dispatch_ns": origin + 25_000_000,
+            },
+        }
+
+    def record(self, recorder, frame=None, identity="request1", **kwargs):
+        if frame is None:
+            frame = np.zeros((2, 2, 3), dtype=np.uint8)
+        recorder.record(
+            frame, recorder.origin_ns + 20_000_000, recorder.origin_ns + 21_000_000,
+            self.request(recorder, identity), **kwargs,
+        )
+
+    def metadata(self, recorder):
+        return json.loads((recorder.session_dir / "session.json").read_text())
+
+    def test_exact_input_pixels_request_timing_and_clean_close_without_timer(self):
+        frame = np.arange(12, dtype=np.uint8).reshape(2, 2, 3)
+        with mock.patch.object(tracing.mp, "get_context") as context:
+            with self.recorder() as recorder:
+                self.record(recorder, frame, label="policy")
+            context.assert_not_called()
+        recorder.close()  # Idempotent.
+        with (recorder.session_dir / "samples.csv").open() as stream:
+            row, = list(csv.DictReader(stream))
+        np.testing.assert_array_equal(
+            cv2.imread(str(recorder.session_dir / row["image"]))[HEADER_HEIGHT:, :2],
+            frame[..., ::-1],
+        )
+        self.assertEqual(row["source_ms"], "")
+        self.assertEqual(float(row["received_ms"]), 20)
+        self.assertEqual(float(row["client_send_ms"]), 22)
+        self.assertEqual(float(row["model_dispatch_ms"]), 25)
+        metadata = self.metadata(recorder)
+        self.assertEqual(metadata["accounting"]["saved"], 1)
+        self.assertEqual(metadata["samples"][0]["label"], "policy")
+        self.assertFalse(metadata["recording_active"])
+        self.assertFalse(recorder._saver.is_alive())
+
+    def test_slow_png_saver_owns_pixels_and_full_queue_never_waits(self):
+        entered, release = threading.Event(), threading.Event()
+        saved = []
+
+        def slow_save(directory, index, frame, row):
+            entered.set()
+            if not release.wait(3):
+                raise RuntimeError("Test did not release the saver")
+            saved.append((index, frame.copy(), dict(row)))
+
+        frame = np.arange(12, dtype=np.uint8).reshape(2, 2, 3)
+        expected = frame.copy()
+        with mock.patch.object(tracing, "SAVER_QUEUE_SIZE", 1), mock.patch.object(
+            tracing, "save_request", side_effect=slow_save
+        ):
+            with self.recorder() as recorder:
+                try:
+                    self.record(recorder, frame)
+                    self.assertTrue(entered.wait(1))
+                    frame[:] = 255
+                    self.record(recorder, identity="request2")
+                    self.record(recorder, identity="dropped")
+                    self.assertFalse(release.is_set())
+                    self.assertEqual(recorder._accounting["dropped_queue_full"], 1)
+                    self.assertEqual(recorder._accounting["enqueued"], 2)
+                finally:
+                    release.set()
+        self.assertEqual(len(saved), 2)
+        np.testing.assert_array_equal(saved[0][1], expected)
+        self.assertEqual(self.metadata(recorder)["accounting"]["dropped_queue_full"], 1)
+
+    def test_sample_cap_stops_recording_only_and_later_calls_return(self):
+        with self.recorder(max_samples=1) as recorder:
+            self.record(recorder)
+            self.record(recorder, identity="ignored")
+            self.assertFalse(recorder._active)
+        metadata = self.metadata(recorder)
+        self.assertEqual(metadata["accounting"]["enqueued"], 1)
+        self.assertEqual(metadata["accounting"]["skipped_inactive"], 1)
+        self.assertEqual(metadata["stop_reason"], "max_samples reached")
+
+    def test_saver_failures_surface_on_next_record_and_close(self):
+        with mock.patch.object(tracing, "save_request", side_effect=OSError("disk full")):
+            recorder = self.recorder().__enter__()
+            self.record(recorder)
+            recorder._saver.join(timeout=1)
+            self.assertFalse(recorder._saver.is_alive())
+            with self.assertRaisesRegex(RuntimeError, "saver failed: disk full"):
+                self.record(recorder, identity="next")
+            with self.assertRaisesRegex(RuntimeError, "saver failed: disk full"):
+                recorder.close()
+        self.assertEqual(self.metadata(recorder)["accounting"]["save_errors"], 1)
+
+    def test_invalid_or_uninstrumented_result_is_never_saved(self):
+        with self.recorder() as recorder:
+            frame = np.zeros((2, 2, 3), dtype=np.uint8)
+            with self.assertRaisesRegex(ValueError, "client_latency and latency_probe"):
+                recorder.record(frame, 1, 2, {"actions": []})
+            with self.assertRaisesRegex(ValueError, "timestamp order"):
+                recorder.record(frame, recorder.origin_ns + 30_000_000,
+                                recorder.origin_ns + 21_000_000, self.request(recorder))
+        self.assertFalse((recorder.session_dir / "samples.csv").exists())
+
+    def test_timer_close_stops_future_samples_without_raising_into_controls(self):
+        with self.recorder() as recorder:
+            recorder._timer_messages = Queue()
+            recorder._timer_messages.put(("closed", "user closed window"))
+            recorder._timer_stop = threading.Event()
+            recorder._timer = SimpleNamespace(exitcode=0, pid=None)
+            self.record(recorder)
+            self.assertFalse(recorder._active)
+            self.assertEqual(recorder._accounting["enqueued"], 0)
+            # Restore the multiprocessing queue slot before close cleanup.
+            recorder._timer_messages = None
+        self.assertIn("timer_closed", self.metadata(recorder)["stop_reason"])
+
+    def test_timer_uses_spawn_and_bounded_readiness_then_only_owned_process_cleanup(self):
+        with mock.patch.dict(tracing.os.environ, {"DISPLAY": ":synthetic"}):
+            context = mock.Mock()
+            stop, ready = mock.Mock(), mock.Mock()
+            ready.wait.return_value = True
+            context.Event.side_effect = (stop, ready)
+            process = context.Process.return_value
+            process.pid = 123
+            process.is_alive.return_value = False
+            with mock.patch.object(tracing.mp, "get_context", return_value=context) as get_context:
+                recorder = tracing.DeploymentLatencyRecorder(Path(self.directory.name), {}, {})
+                with recorder:
+                    get_context.assert_called_once_with("spawn")
+                    self.assertIs(context.Process.call_args.kwargs["target"], tracing._timer_process)
+                    self.assertEqual(context.Process.call_args.kwargs["args"][0], recorder.origin_ns)
+                process.start.assert_called_once()
+                process.join.assert_called_once_with(timeout=2)
+                process.terminate.assert_not_called()
+
+    def test_timer_paints_source_and_q_signals_only_recorder_stop(self):
+        stop, ready, messages = threading.Event(), threading.Event(), Queue()
+        with mock.patch.object(cv2, "namedWindow"), mock.patch.object(cv2, "resizeWindow"), \
+             mock.patch.object(cv2, "imshow") as show, mock.patch.object(cv2, "destroyWindow"), \
+             mock.patch.object(cv2, "waitKey", return_value=ord("q")):
+            tracing._timer_process(0, stop, ready, messages)
+        self.assertTrue(stop.is_set())
+        self.assertEqual(messages.get_nowait()[0], "closed")
+        show.assert_called_once()
+
+    def test_deployment_timer_uses_large_unpadded_integer_milliseconds(self):
+        with mock.patch.object(cv2, "putText", wraps=cv2.putText) as put_text:
+            frame = tracing.render_deployment_timer(12345.9)
+        calls = [call for call in put_text.call_args_list if call.args[1] == "12345"]
+        self.assertEqual(len(calls), 1)
+        self.assertGreater(calls[0].args[4], 4.5)
+        self.assertEqual(frame.shape, (500, 900, 3))
+        self.assertFalse(any("stop tracing only" in str(call.args[1]) for call in put_text.call_args_list))
+
+    def test_timer_readiness_timeout_cleans_up_spawned_process(self):
+        with mock.patch.dict(tracing.os.environ, {"DISPLAY": ":synthetic"}):
+            context = mock.Mock()
+            stop, ready = mock.Mock(), mock.Mock()
+            ready.wait.return_value = False
+            stop.is_set.return_value = False
+            context.Event.side_effect = (stop, ready)
+            process = context.Process.return_value
+            process.pid, process.exitcode = 123, None
+            process.is_alive.return_value = False
+            with mock.patch.object(tracing.mp, "get_context", return_value=context), \
+                 mock.patch.object(tracing.time, "monotonic", side_effect=(0, 11)):
+                recorder = tracing.DeploymentLatencyRecorder(Path(self.directory.name), {}, {})
+                with self.assertRaisesRegex(RuntimeError, "did not become ready"):
+                    recorder.__enter__()
+            process.join.assert_called_once_with(timeout=2)
+            self.assertEqual(self.metadata(recorder)["stop_reason"], "startup_error")
+
+
+if __name__ == "__main__":
+    unittest.main()
