+++ b/tests/test_can_feedback_matching.py
@@ -0,0 +1,111 @@
+"""Pure matching regressions; no CAN socket, SDK controller, or native decoder."""
+
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from tools.can_audit.match_feedback import (
+    MOTORS, FIELDS, Reconstruction, canonical_raw, describe_candidates,
+    flatten, sdk_values, state_raw,
+)
+
+
+def frame(seq, received_ns, *, uncertainty=0, tx=False):
+    return dict(capture_seq=seq, kernel_monotonic_ns=received_ns,
+                clock_anchor={"uncertainty_ns": uncertainty}, locally_generated=tx)
+
+
+def decoded(motor, raw=(.5, .25, .125), updated=FIELDS):
+    return dict(motor_id=motor, updated_fields=list(updated),
+                **dict(zip(FIELDS, raw)))
+
+
+class CanFeedbackMatchingTests(unittest.TestCase):
+    def test_canonical_keys_reverse_sdk_conversion_only_at_roundoff(self):
+        for motor in MOTORS:
+            raw = (.5003814697265625, -.03296661376953125, .125)
+            self.assertEqual(canonical_raw(motor, sdk_values(motor, raw)), raw)
+            values = list(sdk_values(motor, raw))
+            values[2] += 1e-8
+            with self.assertRaisesRegex(ValueError, "round-trip"):
+                canonical_raw(motor, values)
+
+    def test_repeated_values_remain_ambiguous_and_latest_is_only_lower_bound(self):
+        candidates = [dict(seq=1, receive_ns=10, uncertainty_ns=0),
+                      dict(seq=2, receive_ns=20, uncertainty_ns=0)]
+        row, eligible = describe_candidates(candidates, 30, 0)
+        self.assertEqual(row["status"], "ambiguous")
+        self.assertEqual(row["candidate_count"], 2)
+        self.assertEqual(row["latest_match_age_lower_bound_ms"], 10 / 1e6)
+        self.assertTrue(row["pre_capture_same_value_not_excluded"])
+
+    def test_future_only_and_clock_boundary_are_separate(self):
+        source = dict(seq=1, receive_ns=105, uncertainty_ns=1)
+        row, _ = describe_candidates([source], 100, 1)
+        self.assertEqual(row["status"], "future_only")
+        row, _ = describe_candidates([source], 100, 5)
+        self.assertEqual(row["candidate_count"], 1)
+        self.assertEqual(row["clock_boundary_count"], 1)
+        self.assertEqual(row["definitely_before_count"], 0)
+        self.assertEqual(row["latest_match_age_lower_bound_ms"], 0)
+
+    def test_tx_does_not_mutate_reconstructed_state(self):
+        replay = Reconstruction()
+        replay.add(frame(1, 10, tx=True), decoded(1))
+        self.assertFalse(replay.current)
+        self.assertEqual(replay.counts["tx_ignored"], 1)
+
+    def test_current_only_update_retains_older_position_provenance(self):
+        replay = Reconstruction()
+        replay.add(frame(1, 10), decoded(1))
+        replay.add(frame(2, 20), decoded(1, (.5, .25, .375), ("current_raw",)))
+        event = replay.current[1]
+        self.assertEqual(event["writes"]["position_rad"]["seq"], 1)
+        self.assertEqual(event["writes"]["current_raw"]["seq"], 2)
+        self.assertFalse(event["position_updated"])
+
+    def test_whole_snapshot_disambiguates_independent_motor_repeats(self):
+        replay = Reconstruction()
+        for index, motor in enumerate(MOTORS, 1):
+            replay.add(frame(index, index * 10), decoded(motor))
+        old_key = flatten({motor: (.5, .25, .125) for motor in MOTORS})
+        # Another motor changes before repeated motor1 feedback. The complete
+        # vector is different, so the repeated motor1 tuple does not create a
+        # second candidate for the old whole SDK snapshot.
+        replay.add(frame(8, 80), decoded(2, (.625, .25, .125)))
+        replay.add(frame(9, 90), decoded(1))
+        self.assertEqual(len(replay.motor_index[1][(.5, .25, .125)]), 2)
+        self.assertEqual(len(replay.whole_index[old_key]), 1)
+        row, candidates = describe_candidates(replay.whole_index[old_key], 100, 0)
+        self.assertEqual(row["status"], "unique_in_capture")
+        self.assertEqual(candidates[0]["motors"][1]["writes"]["position_rad"]["receive_ns"], 10)
+
+    def test_unhandled_decoder_reply_invalidates_cache_until_all_fields_seen(self):
+        replay = Reconstruction()
+        replay.add(frame(1, 10), decoded(1))
+        replay.add(frame(2, 20), dict(motor_id=1, decode_skipped="unknown"))
+        self.assertNotIn(1, replay.current)
+        replay.add(frame(3, 30), decoded(1, updated=("current_raw",)))
+        self.assertNotIn(1, replay.current)
+        replay.add(frame(4, 40), decoded(1))
+        self.assertIn(1, replay.current)
+
+    def test_full_tuple_checks_velocity_and_current_not_just_position(self):
+        replay = Reconstruction()
+        replay.add(frame(1, 10), decoded(1))
+        self.assertFalse(replay.motor_index[1].get((.5, .5, .125)))
+        self.assertFalse(replay.motor_index[1].get((.5, .25, .25)))
+
+    def test_native_state_mapping_includes_gripper_and_all_joints(self):
+        raw = {motor: (.5, .25, .125) for motor in MOTORS}
+        values = {motor: sdk_values(motor, raw[motor]) for motor in MOTORS}
+        state = {"joint_pos": [values[m][0] for m in MOTORS[:-1]],
+                 "joint_vel": [values[m][1] for m in MOTORS[:-1]],
+                 "joint_torque": [values[m][2] for m in MOTORS[:-1]],
+                 "gripper_pos": values[8][0], "gripper_vel": values[8][1], "gripper_torque": values[8][2]}
+        self.assertEqual(state_raw(state), raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
