+"""Arithmetic, validity, sample loss accounting, and offline report scope."""
+
+import csv
+from contextlib import redirect_stdout
+import io
+import json
+from pathlib import Path
+import queue
+import sys
+import tempfile
+import threading
+import unittest
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from utils import robot_latency as latency
+
+
+def timing(**overrides):
+    data = dict(version=1, request_id="request1", clock_id="linux:test", sdk_instance_id="sdk1",
+                source_kind="SDK_cache_update", command="SET_EE_POSE",
+                eef_source_ns=1_000_000, joint_source_ns=2_000_000,
+                server_received_ns=3_000_000, server_send_ns=4_000_000,
+                client_send_ns=2_500_000, client_return_ns=5_000_000,
+                clock_uncertainty_ns=1000, eef_sdk_timestamp_s=.001,
+                joint_sdk_timestamp_s=.002)
+    data.update(overrides)
+    return data
+
+
+class RobotLatencyReportTests(unittest.TestCase):
+    def setUp(self):
+        patch = mock.patch.object(latency, "local_clock_id", return_value="linux:test")
+        patch.start()
+        self.addCleanup(patch.stop)
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.directory = Path(self.temp.name) / "session"
+
+    def test_separate_eef_joint_client_controller_and_rpc(self):
+        row = latency.timing_row(timing(), controller_received_ns=6_000_000, label="control")
+        self.assertEqual(row["eef_sdk_to_client_ms"], 4)
+        self.assertEqual(row["joint_sdk_to_client_ms"], 3)
+        self.assertEqual(row["rpc_ms"], 2.5)
+        self.assertEqual(row["eef_sdk_to_server_reply_ms"], 3)
+        self.assertEqual(row["server_reply_to_client_ms"], 1)
+        self.assertEqual(row["client_to_controller_ms"], 1)
+        self.assertEqual(row["eef_sdk_to_controller_ms"], 5)
+
+    def test_validation_rejects_future_wrong_clock_and_nonfinite(self):
+        cases = [dict(clock_id="linux:other"), dict(eef_source_ns=5_000_000),
+                 dict(client_send_ns=4_000_000), dict(server_received_ns=True),
+                 dict(joint_sdk_timestamp_s=float("inf")), dict(source_kind="encoder"),
+                 dict(clock_uncertainty_ns=-1)]
+        for overrides in cases:
+            with self.subTest(overrides=overrides), self.assertRaises(ValueError):
+                latency.timing_row(timing(**overrides))
+        with self.assertRaisesRegex(ValueError, "predates"):
+            latency.timing_row(timing(), controller_received_ns=1)
+
+    def test_preserves_uncertainty_instead_of_clamping_negative_age(self):
+        row = latency.timing_row(timing(eef_source_ns=5_000_001, clock_uncertainty_ns=2_000_000))
+        self.assertEqual(row["eef_sdk_to_client_ms"], -.000001)
+
+    def test_report_separates_commands_phases_and_sdk_instances(self):
+        with latency.RobotLatencyRecorder(self.directory, {"mode": "deployment_feedback"}) as recorder:
+            recorder.record(timing(), label="control")
+            recorder.record(timing(request_id="request2"), label="control")
+            recorder.record(timing(command="GET_STATE", request_id="request3"), label="control")
+            recorder.record(timing(request_id="request4"), label="reset")
+            recorder.record(timing(request_id="request5", sdk_instance_id="sdk2"), label="control")
+        report = (self.directory / "report.txt").read_text()
+        self.assertIn("[control / SET_EE_POSE] n=2", report)
+        self.assertIn("[control / GET_STATE] n=1", report)
+        self.assertIn("[reset / SET_EE_POSE] n=1", report)
+        self.assertIn("SDK instance=sdk2", report)
+        self.assertIn("1/1 (100.0%)", report)
+        self.assertIn("excludes earlier encoder/CAN/cache delay", report)
+        self.assertIn("not action execution delay", report)
+
+    def test_report_recomputes_derived_columns_and_works_after_reboot(self):
+        with latency.RobotLatencyRecorder(self.directory, {}) as recorder:
+            recorder.record(timing())
+        path = self.directory / "samples.csv"
+        with path.open(newline="") as source:
+            rows = list(csv.DictReader(source))
+        rows[0]["eef_sdk_to_client_ms"] = "9999"
+        with path.open("w", newline="") as target:
+            writer = csv.DictWriter(target, fieldnames=latency.CSV_FIELDS)
+            writer.writeheader()
+            writer.writerows(rows)
+        with mock.patch.object(latency, "local_clock_id", return_value="linux:new-boot"):
+            self.assertEqual(latency.load_rows(path)[0]["eef_sdk_to_client_ms"], 4)
+
+    def test_bounded_nonblocking_queue_drop_and_cap_accounting(self):
+        with latency.RobotLatencyRecorder(self.directory, {}, max_samples=1) as recorder:
+            with mock.patch.object(recorder._queue, "put_nowait", side_effect=queue.Full):
+                self.assertFalse(recorder.record(timing()))
+            self.assertTrue(recorder.record(timing()))
+            self.assertFalse(recorder.record(timing()))
+        stats = json.loads((self.directory / "session.json").read_text())["accounting"]
+        self.assertEqual(stats["dropped_queue_full"], 1)
+        self.assertEqual(stats["saved"], 1)
+        self.assertEqual(stats["skipped_cap"], 1)
+
+    def test_invalid_diagnostics_count_and_metadata_updates_are_saved(self):
+        with latency.RobotLatencyRecorder(self.directory, {}) as recorder:
+            with self.assertRaises(ValueError):
+                recorder.record(timing(request_id=""))
+            recorder.metadata["controller_timing_errors"] = 1
+        metadata = json.loads((self.directory / "session.json").read_text())
+        self.assertEqual(metadata["accounting"]["invalid"], 1)
+        self.assertEqual(metadata["metadata"]["controller_timing_errors"], 1)
+        self.assertIn("No valid samples", (self.directory / "report.txt").read_text())
+
+    def test_existing_session_cannot_be_overwritten(self):
+        with latency.RobotLatencyRecorder(self.directory, {}):
+            pass
+        with self.assertRaises(FileExistsError):
+            with latency.RobotLatencyRecorder(self.directory, {}):
+                pass
+
+    def test_saver_failure_is_explicit_and_does_not_block_record(self):
+        recorder = latency.RobotLatencyRecorder(self.directory, {})
+        recorder.__enter__()
+        failed = threading.Event()
+
+        def fail(row):
+            failed.set()
+            raise OSError("disk full")
+
+        recorder._writer.writerow = fail
+        recorder.record(timing())
+        self.assertTrue(failed.wait(timeout=2))
+        recorder._thread.join(timeout=2)
+        self.assertFalse(recorder.record(timing()))
+        with self.assertRaisesRegex(RuntimeError, "disk full"):
+            recorder.close()
+        metadata = json.loads((self.directory / "session.json").read_text())
+        self.assertIn("disk full", metadata["save_error"])
+        self.assertEqual(metadata["accounting"]["dropped_save_error"], 1)
+
+    def test_invalid_csv_is_rejected_with_line_number(self):
+        with latency.RobotLatencyRecorder(self.directory, {}) as recorder:
+            recorder.record(timing())
+        path = self.directory / "samples.csv"
+        path.write_text(path.read_text().replace("5000000", "oops"))
+        with self.assertRaisesRegex(ValueError, "CSV line 2"):
+            latency.load_rows(path)
+
+    def window_report(self, records, windows, *, window_clock="linux:test"):
+        directory = self.directory / "robot0"
+        directory.mkdir(parents=True, exist_ok=True)
+        path = directory / "samples.csv"
+        with path.open("w", newline="") as stream:
+            writer = csv.DictWriter(stream, fieldnames=latency.CSV_FIELDS)
+            writer.writeheader()
+            for data, received in records:
+                writer.writerow(latency.timing_row(data, received, "control", check_local_clock=False))
+        (self.directory / "observation_session.json").write_text(json.dumps({
+            "metadata": {"server": {"clock_id": window_clock}, "policy_windows": windows},
+        }))
+        output = io.StringIO()
+        with redirect_stdout(output):
+            latency.print_report(path)
+        return output.getvalue()
+
+    def shifted(self, offset, **changes):
+        data = timing()
+        for key in latency.NS_FIELDS:
+            if key != "clock_uncertainty_ns":
+                data[key] += offset
+        data.update(changes)
+        return data
+
+    def test_policy_windows_exclude_idle_hold_and_get_state_baseline(self):
+        report = self.window_report([
+            (timing(), 6_000_000),
+            (self.shifted(10_000_000), 16_000_000),
+            (self.shifted(20_000_000), 26_000_000),
+            (self.shifted(12_000_000, command="GET_STATE"), 18_000_000),
+        ], [{"start_ns": 10_000_000, "end_ns": 20_000_000}])
+        all_session, active = report.split("Policy-active SET_EE_POSE feedback", 1)
+        self.assertIn("[control / SET_EE_POSE] n=3", all_session)
+        self.assertIn("may include idle, hold, reset, and warmup", all_session)
+        self.assertIn("eligible active requests: 1/3", active)
+        self.assertIn("[control / SET_EE_POSE] n=1", active)
+        self.assertNotIn("[control / GET_STATE]", active)
+        self.assertIn("read-only baseline", active)
+
+    def test_multiwindow_edges_require_complete_request_and_controller_receipt(self):
+        report = self.window_report([
+            (timing(), 6_000_000),  # Both window edges are inclusive.
+            (self.shifted(10_000_000), None),  # Falls back to client return.
+            (timing(), 6_000_001),  # Client returned in time, controller did not.
+            (self.shifted(-1), 5_999_999),  # Started one ns before first window.
+            (self.shifted(5_000_000), 11_000_000),  # In the gap between runs.
+        ], [{"start_ns": 2_500_000, "end_ns": 6_000_000},
+            {"start_ns": 12_500_000, "end_ns": 15_000_000}])
+        active = report.split("Policy-active SET_EE_POSE feedback", 1)[1]
+        self.assertIn("Recorded policy windows: 2; eligible active requests: 2/5", active)
+        self.assertIn("[control / SET_EE_POSE] n=2", active)
+
+    def test_policy_clock_mismatch_never_produces_active_statistics(self):
+        report = self.window_report([(timing(), 6_000_000)], [
+            {"start_ns": 0, "end_ns": 10_000_000},
+        ], window_clock="linux:another-boot")
+        active = report.split("Policy-active SET_EE_POSE feedback", 1)[1]
+        self.assertIn("clock identity different", active)
+        self.assertIn("No actual policy-active result", active)
+        self.assertNotIn("[control / SET_EE_POSE]", active)
+
+    def test_no_window_and_invalid_window_cannot_be_presented_as_active(self):
+        for windows in ([], [{"start_ns": 9, "end_ns": 8}],
+                        [{"start_ns": True, "end_ns": 10_000_000}]):
+            report = self.window_report([(timing(), 6_000_000)], windows)
+            active = report.split("Policy-active SET_EE_POSE feedback", 1)[1]
+            self.assertIn("No actual policy-active result", active)
+            self.assertNotIn("[control / SET_EE_POSE]", active)
+
+    def test_observation_close_refreshes_finished_controller_report(self):
+        from utils.robot_latency_observation import RobotObservationRecorder
+
+        child = self.directory / "robot0"
+        with latency.RobotLatencyRecorder(child, {}) as recorder:
+            recorder.record(timing(), 6_000_000, "control")
+        self.assertIn("no same-session policy windows", (child / "report.txt").read_text())
+        with RobotObservationRecorder(self.directory, metadata={
+            "server": {"clock_id": "linux:test"},
+            "policy_windows": [{"start_ns": 2_500_000, "end_ns": 6_000_000}],
+            "record_errors": 1,
+        }):
+            pass
+        self.assertIn("eligible active requests: 1/1", (child / "report.txt").read_text())
+        self.assertIn("1 observation timing records failed", (self.directory / "observation_report.txt").read_text())
+        with self.assertRaises(FileExistsError):
+            RobotObservationRecorder(self.directory)
+
+
+if __name__ == "__main__":
+    unittest.main()
