@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Read-only GET_STATE latency baseline, or an offline report of recorded timing."""
+
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import math
+from pathlib import Path
+import sys
+import time
+import uuid
+
+
+REPOSITORY = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPOSITORY))
+
+from utils.robot_latency import RobotLatencyRecorder, print_report
+
+
+def positive_number(value):
+    number = float(value)
+    if not math.isfinite(number) or number <= 0:
+        raise argparse.ArgumentTypeError("must be finite and positive")
+    return number
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--host", "--robot-ip", default="127.0.0.1")
+    parser.add_argument("--port", "--robot-port", type=int, default=8765)
+    parser.add_argument("--duration", type=positive_number, default=30.0, help="seconds of read-only polling")
+    parser.add_argument("--frequency", type=positive_number, default=100.0, help="maximum GET_STATE requests per second; no catch-up bursts")
+    parser.add_argument("--request-timeout", type=positive_number, default=5.0, help="socket send/receive timeout, seconds")
+    parser.add_argument("--output", type=Path, default=REPOSITORY / "data_local/shellgame_eval/robot_obs_latency",
+                        help="parent directory for a unique measurement session")
+    parser.add_argument("--report", type=Path, metavar="CSV", help="report saved CSV without connecting to a robot")
+    return parser.parse_args(argv)
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    if args.report is not None:
+        print_report(args.report)
+        return 0
+    # Delayed import lets offline reporting work with Python's standard library.
+    from modules.arx5_zmq_client import Arx5Client
+
+    session = args.output / f"{dt.datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}"
+    client = None
+    try:
+        print("Read-only GET_STATE baseline: no movement, camera, or model. Do not run concurrently with eval.", flush=True)
+        client = Arx5Client(args.host, args.port, enable_latency=True,
+                            request_timeout_s=args.request_timeout)
+        metadata = {"mode": "read_only_baseline", "host": args.host, "port": args.port,
+                    "duration_s": args.duration, "frequency_hz": args.frequency,
+                    "server": client.latency_metadata}
+        with RobotLatencyRecorder(session, metadata) as recorder:
+            recorder.record(client.latest_state_latency, label="read_only_baseline")
+            start = time.monotonic()
+            deadline = start + args.duration
+            next_request = start + 1 / args.frequency
+            while time.monotonic() < deadline:
+                wait = min(next_request, deadline) - time.monotonic()
+                if wait > 0:
+                    time.sleep(wait)
+                if time.monotonic() >= deadline:
+                    break
+                client.get_state()
+                if client.latest_state_latency is None:
+                    raise RuntimeError(f"Robot timing became invalid: {client.latest_latency_error}")
+                recorder.record(client.latest_state_latency, label="read_only_baseline")
+                next_request = max(next_request + 1 / args.frequency, time.monotonic())
+            recorder.metadata["elapsed_s"] = time.monotonic() - start
+        print_report(session / "samples.csv")
+        return 0
+    except KeyboardInterrupt:
+        print("\nRead-only measurement interrupted; any collected CSV has been closed.", file=sys.stderr)
+        return 130
+    except (RuntimeError, ValueError, OSError) as exc:
+        print(f"Robot latency measurement failed: {exc}", file=sys.stderr)
+        return 1
+    finally:
+        if client is not None:
+            client.close()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
