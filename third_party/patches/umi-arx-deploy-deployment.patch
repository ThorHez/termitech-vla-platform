+"""Passive optical tracing of requests made by the normal deployment loop.
+
+The recorder never reads a camera, calls a policy, or controls a robot. Its
+separate Timer process keeps painting while the caller blocks on inference.
+"""
+
+from __future__ import annotations
+
+import copy
+import datetime as dt
+import json
+import multiprocessing as mp
+import os
+from pathlib import Path
+from queue import Empty, Full, Queue
+import threading
+import time
+import uuid
+
+import numpy as np
+
+from utils.policy_input_latency import save_request, timing_row
+
+
+SAVER_QUEUE_SIZE = 8
+TIMER_START_TIMEOUT = 10.0
+SAVER_CLOSE_TIMEOUT = 10.0
+
+
+def render_deployment_timer(source_ms):
+    """Use large integer milliseconds: display precision cannot justify tenths."""
+    import cv2
+    from utils.camera_latency import render_timer
+
+    frame = render_timer(source_ms)
+    cv2.rectangle(frame, (0, 100), (900, 340), (0, 0, 0), -1)
+    digits = str(int(source_ms))
+    width = cv2.getTextSize(digits, cv2.FONT_HERSHEY_SIMPLEX, 5.5, 3)[0][0]
+    scale = 5.5 * min(1.0, 860 / max(width, 1))
+    cv2.putText(frame, digits, (20, 290), cv2.FONT_HERSHEY_SIMPLEX, scale,
+                (255, 255, 255), 3, cv2.LINE_AA)
+    cv2.rectangle(frame, (0, 430), (900, 500), (0, 0, 0), -1)
+    cv2.putText(
+        frame, "Close Timer to stop tracing; Q / Esc may also stop eval", (20, 460),
+        cv2.FONT_HERSHEY_SIMPLEX, 0.75, (255, 255, 255), 2, cv2.LINE_AA,
+    )
+    return frame
+
+
+def _timer_process(origin_ns, stop, ready, messages) -> None:
+    """Spawn entry point: own one GUI window and no deployment resources."""
+    import cv2
+    from utils.camera_latency import TIMER_WINDOW
+
+    def notify(kind, detail):
+        try:
+            messages.put_nowait((kind, detail))
+        except Full:
+            pass
+
+    try:
+        cv2.setNumThreads(1)
+        cv2.namedWindow(TIMER_WINDOW, cv2.WINDOW_NORMAL)
+        cv2.resizeWindow(TIMER_WINDOW, 900, 500)
+        while not stop.is_set():
+            frame = render_deployment_timer((time.monotonic_ns() - origin_ns) / 1e6)
+            cv2.imshow(TIMER_WINDOW, frame)
+            key = cv2.waitKey(1) & 0xFF
+            if key in (ord("q"), ord("Q"), 27) or cv2.getWindowProperty(
+                TIMER_WINDOW, cv2.WND_PROP_VISIBLE
+            ) == 0:
+                notify("closed", "Timer window closed or Q / Esc pressed")
+                stop.set()
+                break
+            ready.set()
+            stop.wait(0.005)
+    except BaseException as exc:
+        notify("error", f"{type(exc).__name__}: {exc}")
+        stop.set()
+    finally:
+        try:
+            cv2.destroyWindow(TIMER_WINDOW)
+        except cv2.error:
+            pass
+
+
+class DeploymentLatencyRecorder:
+    def __init__(
+        self, output_dir: Path, clock_mapping: dict, session_metadata: dict,
+        max_samples: int = 100, show_timer: bool = True,
+    ):
+        if isinstance(max_samples, bool) or not isinstance(max_samples, int) or max_samples < 1:
+            raise ValueError("max_samples must be a positive integer")
+        self.origin_ns = time.monotonic_ns()
+        self.session_dir = Path(output_dir) / (
+            f"{dt.datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}"
+        )
+        self.clock_mapping = copy.deepcopy(clock_mapping)
+        self.session_metadata = copy.deepcopy(session_metadata)
+        # Catch unserializable caller metadata before starting any resources.
+        json.dumps({"clock_mapping": self.clock_mapping, "metadata": self.session_metadata})
+        self.max_samples, self.show_timer = max_samples, show_timer
+        self._queue = Queue(maxsize=SAVER_QUEUE_SIZE)
+        self._saver_stop = threading.Event()
+        self._saver = None
+        self._saver_error = None
+        self._timer = self._timer_stop = self._timer_messages = None
+        self._started = self._closed = self._active = False
+        self._stop_reason = None
+        self._samples = []
+        self._accounting = {
+            "record_calls": 0, "enqueued": 0, "saved": 0,
+            "dropped_queue_full": 0, "skipped_inactive": 0, "save_errors": 0,
+        }
+
+    def __enter__(self):
+        if self._started or self._closed:
+            raise RuntimeError("Deployment latency recorder cannot be restarted")
+        self.session_dir.mkdir(parents=True, exist_ok=False)
+        self._started = self._active = True
+        self._write_metadata()
+        try:
+            if self.show_timer:
+                self._start_timer()
+            self._saver = threading.Thread(
+                target=self._save_loop, name="deployment-latency-saver", daemon=True
+            )
+            self._saver.start()
+        except BaseException:
+            self._stop_reason = "startup_error"
+            self.close()
+            raise
+        print(f"[deployment-latency] Samples: {self.session_dir}", flush=True)
+        return self
+
+    def _start_timer(self):
+        if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
+            raise RuntimeError("Deployment Timer needs a graphical desktop (DISPLAY is missing)")
+        context = mp.get_context("spawn")
+        self._timer_stop, ready = context.Event(), context.Event()
+        self._timer_messages = context.Queue(maxsize=4)
+        self._timer = context.Process(
+            target=_timer_process,
+            args=(self.origin_ns, self._timer_stop, ready, self._timer_messages),
+            name="deployment-latency-timer", daemon=True,
+        )
+        self._timer.start()
+        deadline = time.monotonic() + TIMER_START_TIMEOUT
+        while not ready.wait(timeout=0.05):
+            if self._timer.exitcode is not None or self._timer_stop.is_set():
+                raise RuntimeError("Deployment Timer exited before its first frame was displayed")
+            if time.monotonic() >= deadline:
+                raise RuntimeError("Deployment Timer did not become ready within 10 seconds")
+
+    def _stop_recording(self, reason):
+        if self._active:
+            self._active = False
+            self._stop_reason = reason
+            print(f"[deployment-latency] Recording stopped: {reason}", flush=True)
+        if self._timer_stop is not None:
+            self._timer_stop.set()
+
+    def _poll(self):
+        if self._saver_error is not None:
+            self._stop_recording("saver_error")
+            raise RuntimeError(f"Deployment latency saver failed: {self._saver_error}") from self._saver_error
+        if self._timer is None or not self._active:
+            return
+        while True:
+            try:
+                kind, detail = self._timer_messages.get_nowait()
+            except Empty:
+                break
+            self._stop_recording(f"timer_{kind}: {detail}")
+        if self._timer_stop.is_set() or self._timer.exitcode is not None:
+            self._stop_recording("Timer closed or exited; no further optical samples")
+
+    def record(self, frame_rgb, read_ns, sampled_ns, result, label="policy") -> None:
+        if not self._started or self._closed:
+            raise RuntimeError("Deployment latency recorder must be used inside its context")
+        self._accounting["record_calls"] += 1
+        self._poll()
+        if not self._active:
+            self._accounting["skipped_inactive"] += 1
+            return
+        if not isinstance(result, dict) or not all(
+            key in result for key in ("client_latency", "latency_probe")
+        ):
+            raise ValueError("Actual policy result must contain client_latency and latency_probe")
+        probe = result["latency_probe"]
+        if not all(key in probe for key in ("received_ns", "policy_start_ns")):
+            raise ValueError("Actual policy probe is missing server receive/policy start timestamps")
+        row = timing_row(result, origin_ns=self.origin_ns, read_ns=read_ns, sampled_ns=sampled_ns)
+        if row["received_ms"] < 0:
+            raise ValueError("Measured frame predates the deployment Timer origin")
+        frame = np.asarray(frame_rgb)
+        if frame.dtype != np.uint8 or frame.ndim != 3 or frame.shape[2] != 3:
+            raise ValueError("Deployment latency frame must be the actual uint8 HWC RGB policy input")
+        index = self._accounting["enqueued"] + 1
+        try:
+            self._queue.put_nowait((index, frame.copy(), row))
+        except Full:
+            self._accounting["dropped_queue_full"] += 1
+            if self._accounting["dropped_queue_full"] == 1:
+                print("[deployment-latency] Saver queue full; dropping samples without waiting", flush=True)
+            return
+        self._accounting["enqueued"] += 1
+        self._samples.append({"index": index, "request_id": row["request_id"], "label": str(label)})
+        if self._accounting["enqueued"] >= self.max_samples:
+            self._stop_recording("max_samples reached")
+
+    def _save_loop(self):
+        while not self._saver_stop.is_set() or not self._queue.empty():
+            try:
+                index, frame, row = self._queue.get(timeout=0.05)
+            except Empty:
+                continue
+            try:
+                save_request(self.session_dir, index, frame, row)
+                self._accounting["saved"] += 1
+            except BaseException as exc:
+                self._accounting["save_errors"] += 1
+                self._saver_error = exc
+                return
+            finally:
+                self._queue.task_done()
+
+    def _write_metadata(self):
+        data = {
+            "kind": "normal_deployment_latency", "origin_ns": self.origin_ns,
+            "clock_mapping": self.clock_mapping, "metadata": self.session_metadata,
+            "max_samples": self.max_samples, "show_timer": self.show_timer,
+            "queue_capacity": self._queue.maxsize, "recording_active": self._active,
+            "stop_reason": self._stop_reason, "accounting": dict(self._accounting),
+            "samples": self._samples,
+            "note": "Actual deployment requests; SOURCE requires transcription from each PNG. "
+            "Timer displays elapsed integer milliseconds rounded down (less than 1 ms quantization). "
+            "The Timer and asynchronous PNG/CSV saver add tracing load. "
+            "Queue-full drops are counted; recording never issues or stops robot actions.",
+        }
+        target = self.session_dir / "session.json"
+        temporary = self.session_dir / "session.json.tmp"
+        temporary.write_text(json.dumps(data, indent=2), encoding="utf-8")
+        temporary.replace(target)
+
+    def close(self):
+        if self._closed:
+            return
+        self._closed = True
+        self._active = False
+        if self._stop_reason is None:
+            self._stop_reason = "context closed"
+        if self._timer_stop is not None:
+            self._timer_stop.set()
+        if self._timer is not None and self._timer.pid is not None:
+            self._timer.join(timeout=2)
+            if self._timer.is_alive():
+                self._timer.terminate()
+                self._timer.join(timeout=2)
+            if self._timer.is_alive():
+                self._timer.kill()
+                self._timer.join(timeout=2)
+        if self._timer_messages is not None:
+            self._timer_messages.close()
+            self._timer_messages.cancel_join_thread()
+        self._saver_stop.set()
+        if self._saver is not None:
+            self._saver.join(timeout=SAVER_CLOSE_TIMEOUT)
+            if self._saver.is_alive():
+                self._stop_reason = "saver_shutdown_timeout"
+                self._write_metadata()
+                raise RuntimeError("Deployment latency saver did not finish within 10 seconds")
+        if self._started:
+            self._write_metadata()
+        if self._saver_error is not None:
+            raise RuntimeError(f"Deployment latency saver failed: {self._saver_error}") from self._saver_error
+
+    def __exit__(self, exc_type, exc, traceback):
+        try:
+            self.close()
+        except Exception as cleanup_error:
+            if exc is None:
+                raise
+            print(f"[deployment-latency] Cleanup also failed: {cleanup_error}", flush=True)
+        return False
diff --git a/utils/policy_input_latency.py b/utils/policy_input_latency.py
new file mode 100644
index 0000000000000000000000000000000000000000..9ac85d7360698e6336cb53347ec32961cea820ff
--- /dev/null
+++ b/utils/policy_input_latency.py
@@ -0,0 +1,277 @@
+"""Optical age of the exact current frame sent to a real policy, without motion."""
+
+from concurrent.futures import ThreadPoolExecutor
+import csv
+import datetime as dt
+import json
+import math
+from multiprocessing.managers import SharedMemoryManager
+import os
+from pathlib import Path
+import time
+import uuid
+
+import cv2
+import numpy as np
+
+from utils.camera_latency import Sample, TIMER_WINDOW, _stop_cameras, annotate_sample, render_timer
+from utils.policy_latency_report import CSV_FIELDS, print_report
+from utils.shellgame_openpi import ShellGameHistory, ShellGamePolicyClient
+
+
+def timing_row(result: dict, *, origin_ns: int, read_ns: int, sampled_ns: int) -> dict:
+    """Map calibrated server clocks into the photographed timer's time domain."""
+    client = result["client_latency"]
+    server = result["latency_probe"]
+    mapping = client["clock_mapping"]
+    lower, upper = mapping["offset_lower_ns"], mapping["offset_upper_ns"]
+    if upper < lower:
+        raise ValueError("Invalid server clock bounds")
+    midpoint = (lower + upper) / 2
+    if not 0 < read_ns <= sampled_ns <= client["send_ns"] <= client["return_ns"]:
+        raise ValueError("Invalid camera/client monotonic timestamp order")
+    row = {
+        "request_id": client["request_id"],
+        "received_ms": (read_ns - origin_ns) / 1e6,
+        "sampled_ms": (sampled_ns - origin_ns) / 1e6,
+        "client_send_ms": (client["send_ns"] - origin_ns) / 1e6,
+        "client_return_ms": (client["return_ns"] - origin_ns) / 1e6,
+        "clock_uncertainty_ms": (upper - lower) / 2e6,
+        "source_ms": "",
+    }
+    for target, key in (
+        ("server_received_ms", "received_ns"),
+        ("policy_start_ms", "policy_start_ns"),
+        ("model_dispatch_ms", "model_dispatch_ns"),
+    ):
+        row[target] = (server[key] - midpoint - origin_ns) / 1e6 if key in server else ""
+    return row
+
+
+def save_request(directory: Path, index: int, frame_rgb: np.ndarray, row: dict) -> None:
+    """Save after inference so image encoding cannot delay the measured request."""
+    name = f"{index:03d}_{row['request_id']}_input.png"
+    sample = Sample(frame_rgb[..., ::-1].copy(), "eval_input", row["received_ms"], row["sampled_ms"])
+    if not cv2.imwrite(str(directory / name), annotate_sample(sample)):
+        raise OSError(f"Could not save {name}")
+    csv_path = directory / "samples.csv"
+    new = not csv_path.exists()
+    with csv_path.open("a", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=CSV_FIELDS)
+        if new:
+            writer.writeheader()
+        writer.writerow({"image": name, **row})
+
+
+def _snapshot(camera) -> tuple[np.ndarray, int, int]:
+    data = camera.get()
+    sampled_ns = time.monotonic_ns()
+    # Own the exact RGB array which will be placed in the policy request.
+    frame = np.asarray(data["color"]).copy()
+    read_ns = int(data["camera_read_monotonic_ns"])
+    if read_ns <= 0 or sampled_ns < read_ns or sampled_ns - read_ns > 2_000_000_000:
+        raise RuntimeError("Camera frame missing or stale (>2s); no latency sample sent")
+    return frame, read_ns, sampled_ns
+
+
+def _warmup(camera, client, policy, prompt, session):
+    frame, _, _ = _snapshot(camera)
+    cv2.imwrite(str(session / "warmup_preview.png"), frame[..., ::-1])
+    history = ShellGameHistory()
+    history.seed_dummy_history(frame, np.zeros(6))
+    if policy.cached_infer_enabled:
+        policy.upload_history(history, prompt=prompt)
+    policy.infer_step(history, current_frame=frame, current_pose6=np.zeros(6), gripper_width=0.0, prompt=prompt)
+    client.enable_latency_probe()
+    return history
+
+
+def _infer_sample(camera, client, policy, history, prompt, origin_ns):
+    # Refresh the cross-host clock bounds BEFORE selecting the measured frame.
+    client.enable_latency_probe()
+    frame, read_ns, sampled_ns = _snapshot(camera)
+    result = policy.infer_step(
+        history, current_frame=frame, current_pose6=np.zeros(6), gripper_width=0.0, prompt=prompt
+    )
+    row = timing_row(result, origin_ns=origin_ns, read_ns=read_ns, sampled_ns=sampled_ns)
+    return frame, row
+
+
+def _infer_and_save(camera, client, policy, history, prompt, origin_ns, session, index):
+    frame, row = _infer_sample(camera, client, policy, history, prompt, origin_ns)
+    save_request(session, index, frame, row)
+    return row
+
+
+def run_measurement(
+    *,
+    output_dir: Path,
+    policy_ip: str,
+    policy_port: int,
+    camera_reorder: str,
+    wrist_camera_index: int,
+    frequency: float,
+    camera_obs_latency: float,
+    cached_infer: bool,
+    prompt: str,
+    sample_count: int,
+    interval: float,
+    timeout: float,
+) -> None:
+    """Camera + real inference benchmark. All returned actions are discarded."""
+    if not all(math.isfinite(x) and x > 0 for x in (frequency, timeout)):
+        raise ValueError("frequency and timeout must be finite and positive")
+    if not math.isfinite(interval) or interval < 0 or sample_count < 1:
+        raise ValueError("interval must be nonnegative and sample count positive")
+    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
+        raise RuntimeError("Run on the camera computer's graphical desktop (DISPLAY is missing)")
+    order = [int(item.strip()) for item in camera_reorder.split(",")]
+    if not order or len(set(order)) != len(order) or min(order) < 0:
+        raise ValueError("camera-reorder must contain distinct nonnegative device indices")
+    if not 0 <= wrist_camera_index < len(order):
+        raise ValueError("wrist-camera-index must index the reordered cameras")
+
+    from openpi_client.websocket_client_policy import WebsocketClientPolicy
+    from modules.arx5_env import Arx5Env
+    from utils.usb_util import get_sorted_v4l_paths
+
+    paths = get_sorted_v4l_paths()
+    if max(order) >= len(paths):
+        raise ValueError(f"Requested camera not found; available devices: {paths}")
+    client = WebsocketClientPolicy(
+        host=policy_ip,
+        port=policy_port,
+        connect_timeout=10,
+        request_timeout=timeout,
+        ping_timeout=timeout,
+        close_timeout=2,
+    )
+    try:
+        client.enable_latency_probe()
+        policy = ShellGamePolicyClient(client, cached_infer=cached_infer)
+        session = output_dir / f"{dt.datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}"
+        session.mkdir(parents=True, exist_ok=False)
+        (session / "session.json").write_text(
+            json.dumps(
+                {
+                    "policy_ip": policy_ip,
+                    "policy_port": policy_port,
+                    "cached_infer": policy.cached_infer_enabled,
+                    "sample_count": sample_count,
+                    "interval_s": interval,
+                    "frequency": frequency,
+                    "robot_motion": False,
+                    "history": "241 copies of warmup camera frame",
+                    "state": "fixed zero pose and gripper; discarded actions",
+                    "note": "camera+policy load; no robot-state alignment or recording load",
+                },
+                indent=2,
+            ),
+            encoding="utf-8",
+        )
+        print(f"[policy-latency] Samples: {session}", flush=True)
+        print("[policy-latency] Aim GoPro at Timer; all digits must be readable in Model input.")
+        print("[policy-latency] Real inference; dummy history/state; no robot controller or action execution.")
+        cv2.setNumThreads(2)
+        with SharedMemoryManager() as manager:
+            env = Arx5Env(
+                output_dir=session,
+                robots_config=[],
+                frequency=frequency,
+                obs_image_resolution=(224, 224),
+                max_obs_buffer_size=120,
+                obs_float32=False,
+                camera_reorder=order,
+                init_joints=False,
+                enable_multi_cam_vis=False,
+                camera_obs_latency=camera_obs_latency,
+                camera_obs_horizon=1,
+                robot_obs_horizon=1,
+                shm_manager=manager,
+            )
+            cameras = list(env.camera.cameras.values())
+            camera = cameras[wrist_camera_index]
+            try:
+                env.camera.start(wait=False)
+                _loop(camera, cameras, client, policy, session, prompt, sample_count, interval)
+            finally:
+                client.close()
+                _stop_cameras(cameras)
+                cv2.destroyAllWindows()
+        if (session / "samples.csv").exists():
+            print_report(session / "samples.csv")
+    finally:
+        client.close()
+
+
+def _loop(camera, cameras, client, policy, session, prompt, sample_count, interval):
+    """Keep the optical clock painting while the websocket blocks in a worker."""
+    origin_ns = time.monotonic_ns()
+    cv2.namedWindow(TIMER_WINDOW, cv2.WINDOW_NORMAL)
+    cv2.resizeWindow(TIMER_WINDOW, 900, 500)
+    cv2.namedWindow("Model input", cv2.WINDOW_NORMAL)
+    cv2.imshow("Model input", np.zeros((672, 672, 3), dtype=np.uint8))
+    executor = ThreadPoolExecutor(max_workers=1)
+    future = None
+    history = None
+    completed = 0
+    next_request = 0.0
+    last_preview = 0.0
+    try:
+        while completed < sample_count:
+            for worker in cameras:
+                if worker.exitcode is not None:
+                    raise RuntimeError(f"Camera exited: {worker.dev_video_path}")
+            if camera.ring_buffer.count and time.monotonic() - last_preview >= 0.05:
+                frame, _, _ = _snapshot(camera)
+                cv2.imshow("Model input", cv2.resize(frame[..., ::-1], (672, 672)))
+                last_preview = time.monotonic()
+            if not camera.ring_buffer.count and time.monotonic_ns() - origin_ns > 20_000_000_000:
+                raise RuntimeError("No camera frame for 20 seconds")
+            if future is not None and future.done():
+                if history is None:
+                    history = future.result()
+                    print("[policy-latency] Warmup complete; collecting measured requests", flush=True)
+                else:
+                    row = future.result()
+                    completed += 1
+                    print(
+                        f"[policy-latency] {completed}/{sample_count}: "
+                        f"read->send={row['client_send_ms'] - row['received_ms']:.1f}ms "
+                        f"clock uncertainty=±{row['clock_uncertainty_ms']:.2f}ms; "
+                        "optical source pending",
+                        flush=True,
+                    )
+                future = None
+                next_request = time.monotonic() + interval
+            if future is None and camera.ring_buffer.count and time.monotonic() >= next_request:
+                if history is None:
+                    print("[policy-latency] Warming real policy; compilation may take minutes", flush=True)
+                    future = executor.submit(_warmup, camera, client, policy, prompt, session)
+                elif completed < sample_count:
+                    future = executor.submit(
+                        _infer_and_save, camera, client, policy, history, prompt, origin_ns, session, completed + 1
+                    )
+            # Stamp immediately before GUI event processing; never after an inference wait.
+            timer = render_timer((time.monotonic_ns() - origin_ns) / 1e6)
+            cv2.rectangle(timer, (0, 430), (900, 500), (0, 0, 0), -1)
+            cv2.putText(
+                timer,
+                "Automatic samples after warmup; Q / Esc: quit",
+                (20, 460),
+                cv2.FONT_HERSHEY_SIMPLEX,
+                0.8,
+                (255, 255, 255),
+                2,
+                cv2.LINE_AA,
+            )
+            cv2.imshow(TIMER_WINDOW, timer)
+            key = cv2.waitKey(1) & 0xFF
+            if key in (ord("q"), ord("Q"), 27):
+                print("[policy-latency] Stopped; completed samples kept", flush=True)
+                break
+            if any(cv2.getWindowProperty(name, cv2.WND_PROP_VISIBLE) == 0 for name in (TIMER_WINDOW, "Model input")):
+                break
+    finally:
+        client.close()  # Wake a pending recv before joining the inference thread.
+        executor.shutdown(wait=True, cancel_futures=True)
diff --git a/utils/policy_latency_report.py b/utils/policy_latency_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc62d0507ae00baee58d715b821f0e144373c5cd
--- /dev/null
+++ b/utils/policy_latency_report.py
@@ -0,0 +1,201 @@
+"""Offline reports for photographed frames sent to the actual policy server.
+
+Server events have already been mapped into the client's timer clock. Their
+shared clock-offset uncertainty is preserved; no optical timestamp is inferred
+from camera compensation, request timing, or synthetic images.
+"""
+
+from __future__ import annotations
+
+import csv
+from dataclasses import dataclass
+import math
+from pathlib import Path
+import statistics
+
+
+CSV_FIELDS = (
+    "image",
+    "request_id",
+    "received_ms",
+    "sampled_ms",
+    "client_send_ms",
+    "client_return_ms",
+    "server_received_ms",
+    "policy_start_ms",
+    "model_dispatch_ms",
+    "clock_uncertainty_ms",
+    "source_ms",
+)
+
+METRIC_LABELS = {
+    "post_read_to_send": "post_read_to_send (client_send - received)",
+    "rpc": "rpc (client_return - client_send)",
+    "camera_read": "camera/read (received - SOURCE)",
+    "client_frame_age": "client frame age (client_send - SOURCE)",
+    "server_frame_age": "server receive frame age (server_received - SOURCE)",
+    "policy_frame_age": "policy wrapper frame age (policy_start - SOURCE)",
+    "model_frame_age": "CPU model dispatch frame age (model_dispatch - SOURCE)",
+}
+SERVER_METRICS = frozenset(("server_frame_age", "policy_frame_age", "model_frame_age"))
+
+
+@dataclass(frozen=True)
+class Measurement:
+    image: str
+    request_id: str
+    received_ms: float
+    sampled_ms: float
+    client_send_ms: float
+    client_return_ms: float
+    server_received_ms: float
+    policy_start_ms: float
+    model_dispatch_ms: float | None
+    clock_uncertainty_ms: float
+    source_ms: float | None
+
+    def metrics(self) -> dict[str, tuple[float, float]]:
+        """Return (midpoint milliseconds, clock uncertainty milliseconds).
+
+        A zero second component for local-clock metrics does not exclude
+        photographed display/scanout/exposure uncertainty.
+        """
+        result = {
+            "post_read_to_send": (self.client_send_ms - self.received_ms, 0.0),
+            "rpc": (self.client_return_ms - self.client_send_ms, 0.0),
+        }
+        if self.source_ms is None:
+            return result
+        result.update({
+            "camera_read": (self.received_ms - self.source_ms, 0.0),
+            "client_frame_age": (self.client_send_ms - self.source_ms, 0.0),
+            "server_frame_age": (
+                self.server_received_ms - self.source_ms, self.clock_uncertainty_ms
+            ),
+            "policy_frame_age": (
+                self.policy_start_ms - self.source_ms, self.clock_uncertainty_ms
+            ),
+        })
+        if self.model_dispatch_ms is not None:
+            result["model_frame_age"] = (
+                self.model_dispatch_ms - self.source_ms, self.clock_uncertainty_ms
+            )
+        return result
+
+
+def _timestamp(row: dict, field: str, *, optional: bool = False) -> float | None:
+    text = (row.get(field) or "").strip()
+    if optional and not text:
+        return None
+    try:
+        value = float(text)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{field} must be a finite, nonnegative number") from exc
+    if not math.isfinite(value) or value < 0:
+        raise ValueError(f"{field} must be a finite, nonnegative number")
+    return value
+
+
+def _validate(measurement: Measurement) -> None:
+    m = measurement
+    if not m.received_ms <= m.sampled_ms <= m.client_send_ms <= m.client_return_ms:
+        raise ValueError(
+            "expected received_ms <= sampled_ms <= client_send_ms <= client_return_ms"
+        )
+    if m.source_ms is not None and m.source_ms > m.received_ms:
+        raise ValueError("expected source_ms <= received_ms")
+    if m.policy_start_ms < m.server_received_ms:
+        raise ValueError("expected server_received_ms <= policy_start_ms")
+    last_event = m.policy_start_ms
+    if m.model_dispatch_ms is not None:
+        if m.model_dispatch_ms < m.policy_start_ms:
+            raise ValueError("expected policy_start_ms <= model_dispatch_ms")
+        last_event = m.model_dispatch_ms
+    # Every server event uses the same clock mapping, so one offset correction
+    # must make the entire server timeline fit inside the client RPC interval.
+    offset_min = max(-m.clock_uncertainty_ms, m.client_send_ms - m.server_received_ms)
+    offset_max = min(m.clock_uncertainty_ms, m.client_return_ms - last_event)
+    if offset_min > offset_max + 1e-9:
+        raise ValueError(
+            "server events cannot fit between client_send_ms and client_return_ms "
+            "within clock_uncertainty_ms"
+        )
+
+
+def read_measurements(csv_path: Path) -> list[Measurement]:
+    """Validate every recorded row, including those awaiting SOURCE transcription."""
+    csv_path = Path(csv_path)
+    measurements = []
+    with csv_path.open(newline="", encoding="utf-8") as stream:
+        reader = csv.DictReader(stream)
+        if not set(CSV_FIELDS).issubset(reader.fieldnames or ()):
+            raise ValueError(f"Not a policy-latency samples.csv: {csv_path}")
+        for line, row in enumerate(reader, start=2):
+            try:
+                if None in row:
+                    raise ValueError("row has more values than the CSV header")
+                values = {
+                    field: _timestamp(row, field, optional=field in {"source_ms", "model_dispatch_ms"})
+                    for field in CSV_FIELDS[2:]
+                }
+                measurement = Measurement(
+                    image=row["image"] or "", request_id=row["request_id"] or "", **values
+                )
+                _validate(measurement)
+            except (TypeError, ValueError) as exc:
+                raise ValueError(f"{csv_path}:{line}: {exc}") from exc
+            measurements.append(measurement)
+    return measurements
+
+
+def _percentile(values: list[float], quantile: float) -> float:
+    ordered = sorted(values)
+    rank = (len(ordered) - 1) * quantile
+    lower = math.floor(rank)
+    upper = math.ceil(rank)
+    return ordered[lower] + (ordered[upper] - ordered[lower]) * (rank - lower)
+
+
+def print_report(csv_path: Path) -> None:
+    measurements = read_measurements(csv_path)
+    if not measurements:
+        raise ValueError(f"No recorded policy requests in {csv_path}")
+    transcribed = sum(m.source_ms is not None for m in measurements)
+    max_uncertainty = max(m.clock_uncertainty_ms for m in measurements)
+    print(
+        f"[policy-latency] {len(measurements)} recorded request samples; "
+        f"{transcribed} photographed SOURCE samples; units: ms"
+    )
+    print(f"Maximum server clock uncertainty: ±{max_uncertainty:.3f} ms")
+    groups: dict[str, list[tuple[float, float]]] = {}
+    for measurement in measurements:
+        for name, value in measurement.metrics().items():
+            groups.setdefault(name, []).append(value)
+    for name, label in METRIC_LABELS.items():
+        if name not in groups:
+            continue
+        data = groups[name]
+        values = [value for value, _ in data]
+        suffix = ""
+        if name in SERVER_METRICS:
+            suffix = f"; clock uncertainty <= ±{max(error for _, error in data):.3f} ms"
+        print(
+            f"  {label}: n={len(values)} mean={statistics.mean(values):.1f} "
+            f"p50={statistics.median(values):.1f} p95={_percentile(values, 0.95):.1f} "
+            f"min={min(values):.1f} max={max(values):.1f}{suffix}"
+        )
+    if not transcribed:
+        print(
+            "No measured optical latency: source_ms is blank. Transcribe SOURCE "
+            "from each saved PNG's photographed Timer, then run this report again."
+        )
+    if "model_frame_age" not in groups:
+        print("No measured CPU model dispatch frame age: SOURCE and model_dispatch_ms are required.")
+    print(
+        "policy_start is the policy wrapper entry. CPU model dispatch includes "
+        "server preprocessing before dispatch; it is not GPU execution start or completion."
+    )
+    print(
+        "Optical frame ages also include display refresh/scanout and exposure uncertainty, "
+        "which is not included in the server clock ± bounds. Discard mixed or unreadable SOURCE digits."
+    )
