+
+"""Optical latency measurement adapted from the supplied RLinf timer script.
+
+Use the real Arx5Env capture/transform/shared-memory path, with no robot or
+policy connection. All displayed times use one system monotonic clock origin.
+"""
+
+from __future__ import annotations
+
+from concurrent.futures import ThreadPoolExecutor
+import csv
+from dataclasses import dataclass
+import datetime as dt
+import math
+from multiprocessing.managers import SharedMemoryManager
+import os
+from pathlib import Path
+from queue import Empty
+import sys
+import tempfile
+import time
+import uuid
+
+import cv2
+import numpy as np
+
+TIMER_WINDOW = "GoPro latency - Timer"
+WINDOWS = {"raw": "GoPro latency - Raw", "eval_input": "GoPro latency - Eval input"}
+HEADER_HEIGHT = 160
+CSV_FIELDS = (
+    "image",
+    "stage",
+    "received_ms",
+    "sampled_ms",
+    "post_read_ms",
+    "source_ms",
+)
+
+
+@dataclass(frozen=True)
+class Sample:
+    image: np.ndarray  # owned BGR copy, never an alias into shared memory
+    stage: str
+    received_ms: float
+    sampled_ms: float
+
+
+def _text(image: np.ndarray, text: str, y: int, scale: float = 0.8) -> None:
+    width = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, scale, 2)[0][0]
+    scale *= min(1.0, (image.shape[1] - 40) / max(width, 1))
+    cv2.putText(
+        image,
+        text,
+        (20, y),
+        cv2.FONT_HERSHEY_SIMPLEX,
+        scale,
+        (255, 255, 255),
+        2,
+        cv2.LINE_AA,
+    )
+
+
+def render_timer(source_ms: float) -> np.ndarray:
+    image = np.zeros((500, 900, 3), dtype=np.uint8)
+    _text(image, "SOURCE (ms)", 65, 1.4)
+    _text(image, f"{source_ms:09.1f}", 290, 4.5)
+    _text(image, "Point GoPro at this clock; keep all digits in Eval input", 405)
+    _text(image, "S / Space: save    Q / Esc: quit", 460)
+    return image
+
+
+def sample_from_data(data: dict, stage: str, origin_ns: int, sampled_ns: int) -> Sample:
+    """Use the timestamp paired with these pixels, never a calibrated timestamp."""
+    received_ns = int(data["camera_read_monotonic_ns"])
+    if received_ns <= 0 or sampled_ns < received_ns:
+        raise ValueError(
+            "Invalid camera monotonic timestamp; restart the camera with the updated code"
+        )
+    frame = data["color"]
+    if stage == "eval_input":
+        frame = frame[..., ::-1]  # eval input is RGB; PNG/OpenCV need BGR
+    elif stage != "raw":
+        raise ValueError(f"Unknown measurement stage: {stage}")
+    return Sample(
+        image=frame.copy(),
+        stage=stage,
+        received_ms=(received_ns - origin_ns) / 1e6,
+        sampled_ms=(sampled_ns - origin_ns) / 1e6,
+    )
+
+
+def annotate_sample(sample: Sample) -> np.ndarray:
+    image = cv2.copyMakeBorder(
+        sample.image,
+        HEADER_HEIGHT,
+        0,
+        0,
+        max(0, 900 - sample.image.shape[1]),
+        cv2.BORDER_CONSTANT,
+        value=(0, 0, 0),
+    )
+    _text(image, f"{sample.stage}   RECEIVED: {sample.received_ms:012.1f} ms", 35)
+    _text(
+        image,
+        f"SAMPLED: {sample.sampled_ms:012.1f} ms   post-read: "
+        f"{sample.sampled_ms - sample.received_ms:.1f} ms",
+        70,
+    )
+    _text(image, "Camera latency ~= RECEIVED - photographed SOURCE", 105)
+    _text(image, "Input latency ~= SAMPLED - photographed SOURCE", 140)
+    return image
+
+
+def save_samples(output_dir: Path, samples: tuple[Sample, ...]) -> Path:
+    """Save immutable snapshots off the GUI thread, preserving their read times."""
+    output_dir.mkdir(parents=True, exist_ok=True)
+    batch = uuid.uuid4().hex
+    csv_path = output_dir / "samples.csv"
+    needs_header = not csv_path.exists() or csv_path.stat().st_size == 0
+    with csv_path.open("a", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=CSV_FIELDS)
+        if needs_header:
+            writer.writeheader()
+        for sample in samples:
+            path = output_dir / f"{batch}_{sample.stage}.png"
+            if not cv2.imwrite(str(path), annotate_sample(sample)):
+                raise OSError(f"Could not write sample: {path}")
+            writer.writerow(
+                {
+                    "image": path.name,
+                    "stage": sample.stage,
+                    "received_ms": f"{sample.received_ms:.3f}",
+                    "sampled_ms": f"{sample.sampled_ms:.3f}",
+                    "post_read_ms": f"{sample.sampled_ms - sample.received_ms:.3f}",
+                    "source_ms": "",
+                }
+            )
+    return csv_path
+
+
+def read_measurements(csv_path: Path) -> dict[str, list[tuple[float, float, float]]]:
+    """Compute camera/input/post-read delays only for manually transcribed rows."""
+    groups: dict[str, list[tuple[float, float, float]]] = {}
+    with csv_path.open(newline="", encoding="utf-8") as stream:
+        reader = csv.DictReader(stream)
+        if not set(CSV_FIELDS).issubset(reader.fieldnames or ()):
+            raise ValueError(f"Not a camera-latency samples.csv: {csv_path}")
+        for line, row in enumerate(reader, start=2):
+            if not (row["source_ms"] or "").strip():
+                continue
+            try:
+                source, received, sampled = (
+                    float(row[key])
+                    for key in ("source_ms", "received_ms", "sampled_ms")
+                )
+                if not all(math.isfinite(x) for x in (source, received, sampled)):
+                    raise ValueError("timestamps must be finite")
+                if not 0 <= source <= received <= sampled:
+                    raise ValueError(
+                        "expected 0 <= source_ms <= received_ms <= sampled_ms"
+                    )
+                if row["stage"] not in WINDOWS:
+                    raise ValueError("unknown stage")
+            except (TypeError, ValueError) as exc:
+                raise ValueError(f"{csv_path}:{line}: {exc}") from exc
+            groups.setdefault(row["stage"], []).append(
+                (received - source, sampled - source, sampled - received)
+            )
+    return groups
+
+
+def print_report(csv_path: Path) -> None:
+    groups = read_measurements(csv_path)
+    if not groups:
+        raise ValueError(
+            "No source_ms values yet; transcribe the photographed SOURCE from each PNG"
+        )
+    for stage, rows in groups.items():
+        values = np.asarray(rows)
+        print(f"[{stage}] {len(rows)} samples (ms)")
+        for column, name in enumerate(("camera/read", "input/sampled", "post-read")):
+            data = values[:, column]
+            print(
+                f"  {name}: mean={np.mean(data):.1f} p50={np.median(data):.1f} "
+                f"p95={np.percentile(data, 95):.1f} min={np.min(data):.1f} max={np.max(data):.1f}"
+            )
+    rows = groups.get("raw", groups.get("eval_input"))
+    median_s = float(np.median(np.asarray(rows)[:, 0])) / 1000
+    print(
+        f"Camera read-latency median: {median_s:.4f}s; reference for --camera-obs-latency."
+    )
+    print(
+        "Includes display refresh/scanout and exposure uncertainty. No policy inference or robot motion."
+    )
+
+
+def _stop_cameras(cameras) -> None:
+    # Measurement owns these processes. Bound shutdown even if a driver blocks
+    # in grab(); never release VideoCapture concurrently from another thread.
+    processes = []
+    for camera in cameras:
+        camera.stop_event.set()
+        recorder = camera.video_recorder
+        if camera.pid is not None:
+            processes.append(camera)
+        if recorder.is_started:
+            recorder.stop()
+            if recorder.pid is not None:
+                processes.append(recorder)
+    for process in processes:
+        process.join(timeout=2.0)
+        if process.is_alive():
+            print(
+                f"[camera-latency] stopping blocked measurement process {process.pid}"
+            )
+            process.terminate()
+            process.join(timeout=2.0)
+            if process.is_alive():
+                process.kill()
+                process.join(timeout=1.0)
+
+
+def _measurement_loop(
+    camera, cameras, output_dir: Path, frequency: float, origin_ns: int
+) -> None:
+    latest: dict[str, Sample] = {}
+    last_poll_ns = 0
+    interval_ns = int(1e9 / frequency)
+    pending_save = None
+    with ThreadPoolExecutor(max_workers=1) as saver:
+        try:
+            cv2.namedWindow(TIMER_WINDOW, cv2.WINDOW_NORMAL)
+            cv2.resizeWindow(TIMER_WINDOW, 900, 500)
+            for name in WINDOWS.values():
+                cv2.namedWindow(name, cv2.WINDOW_NORMAL)
+                cv2.resizeWindow(name, 960, 700)
+                cv2.imshow(name, np.zeros((500, 900, 3), dtype=np.uint8))
+            print("[camera-latency] Aim GoPro at Timer. S/Space: save; Q/Esc: quit.")
+            print(f"[camera-latency] Samples: {output_dir}")
+            while True:
+                now_ns = time.monotonic_ns()
+                if pending_save is not None and pending_save.done():
+                    print(f"[camera-latency] Saved: {pending_save.result()}")
+                    pending_save = None
+                for worker in cameras:
+                    if worker.exitcode is not None:
+                        raise RuntimeError(
+                            f"Camera exited: {worker.dev_video_path} (code {worker.exitcode})"
+                        )
+                if now_ns - last_poll_ns >= interval_ns:
+                    last_poll_ns = now_ns
+                    # Separate buffers can contain different frames. Each snapshot
+                    # retains its OWN read timestamp and photographed SOURCE value.
+                    for stage, getter, ring in (
+                        ("eval_input", camera.get, camera.ring_buffer),
+                        ("raw", camera.get_vis, camera.vis_ring_buffer),
+                    ):
+                        # get() on an empty ring returns an uninitialized slot;
+                        # readiness of the observation ring does not imply vis readiness.
+                        if ring.count == 0:
+                            continue
+                        try:
+                            data = getter()
+                            sampled_ns = time.monotonic_ns()
+                        except Empty:
+                            continue
+                        sample = sample_from_data(data, stage, origin_ns, sampled_ns)
+                        latest[stage] = sample
+                        preview = sample
+                        if stage == "eval_input":
+                            preview = Sample(
+                                cv2.resize(sample.image, (672, 672)),
+                                stage,
+                                sample.received_ms,
+                                sample.sampled_ms,
+                            )
+                        cv2.imshow(WINDOWS[stage], annotate_sample(preview))
+                elapsed_ms = (time.monotonic_ns() - origin_ns) / 1e6
+                for stage in WINDOWS:
+                    sample = latest.get(stage)
+                    if sample is None:
+                        if elapsed_ms > 20000:
+                            raise RuntimeError(
+                                f"No {stage} frame for 20 seconds; check GoPro/HDMI/capture device"
+                            )
+                    elif elapsed_ms - sample.received_ms > 10000:
+                        raise RuntimeError(
+                            f"{stage} camera frames have frozen for 10 seconds"
+                        )
+                # HighGUI paints during waitKey: stamp SOURCE after image copies
+                # and preview rendering, immediately before pumping GUI events.
+                source_ms = (time.monotonic_ns() - origin_ns) / 1e6
+                cv2.imshow(TIMER_WINDOW, render_timer(source_ms))
+                key = cv2.waitKey(1) & 0xFF
+                if key in (ord("q"), ord("Q"), 27):
+                    break
+                if any(
+                    cv2.getWindowProperty(name, cv2.WND_PROP_VISIBLE) == 0
+                    for name in (TIMER_WINDOW, *WINDOWS.values())
+                ):
+                    break
+                if key in (ord("s"), ord("S"), 32) and latest:
+                    if pending_save is None:
+                        pending_save = saver.submit(
+                            save_samples, output_dir, tuple(latest.values())
+                        )
+                    else:
+                        print("[camera-latency] Previous sample is still saving")
+        finally:
+            cv2.destroyAllWindows()
+    if pending_save is not None:
+        print(f"[camera-latency] Saved: {pending_save.result()}")
+
+
+def run_measurement(
+    *,
+    output_dir: Path,
+    camera_reorder: str,
+    wrist_camera_index: int,
+    frequency: float,
+    camera_obs_latency: float,
+) -> None:
+    if not math.isfinite(frequency) or frequency <= 0:
+        raise ValueError("--frequency must be finite and positive")
+    if sys.platform.startswith("linux") and not (
+        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
+    ):
+        raise RuntimeError(
+            "Run from the receiving computer's graphical desktop; no display is available"
+        )
+    order = [int(item.strip()) for item in camera_reorder.split(",")]
+    if not order or len(set(order)) != len(order) or min(order) < 0:
+        raise ValueError(
+            "--camera-reorder must contain distinct non-negative device indices"
+        )
+    if not 0 <= wrist_camera_index < len(order):
+        raise ValueError("--wrist-camera-index must index the reordered cameras")
+
+    from modules.arx5_env import Arx5Env
+    from utils.usb_util import get_sorted_v4l_paths
+
+    paths = get_sorted_v4l_paths()
+    if max(order) >= len(paths):
+        raise ValueError(
+            f"--camera-reorder={camera_reorder} unavailable; detected devices: {paths}"
+        )
+    session_dir = (
+        output_dir / f"{dt.datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}"
+    )
+    session_dir.mkdir(parents=True, exist_ok=True)
+    cv2.setNumThreads(2)
+    with SharedMemoryManager() as shm_manager:
+        # Reuse exactly the eval configuration. Empty robot list creates no
+        # controllers; do not call get_obs(), which requires robot alignment.
+        env = Arx5Env(
+            output_dir=session_dir,
+            robots_config=[],
+            frequency=frequency,
+            obs_image_resolution=(224, 224),
+            max_obs_buffer_size=120,
+            obs_float32=False,
+            camera_reorder=order,
+            init_joints=False,
+            enable_multi_cam_vis=False,
+            camera_obs_latency=camera_obs_latency,
+            camera_obs_horizon=1,
+            robot_obs_horizon=1,
+            shm_manager=shm_manager,
+        )
+        cameras = list(env.camera.cameras.values())
+        selected = cameras[wrist_camera_index]
+        print(
+            f"[camera-latency] camera{wrist_camera_index}: {selected.dev_video_path}; "
+            f"requested {selected.resolution}@{selected.capture_fps}fps, buffer={selected.cap_buffer_size}"
+        )
+        print(
+            f"[camera-latency] Polling at {frequency:g}Hz; configured compensation "
+            f"{camera_obs_latency:g}s is NOT used in measured delays."
+        )
+        origin_ns = time.monotonic_ns()
+        try:
+            env.camera.start(wait=False)
+            _measurement_loop(selected, cameras, session_dir, frequency, origin_ns)
+        finally:
+            _stop_cameras(cameras)
+
+
+def run_self_test() -> None:
+    origin_ns = 10_000_000_000
+    frame = render_timer(123456.0)
+    original = frame.copy()
+    data = {
+        "color": frame,
+        "camera_read_monotonic_ns": origin_ns + 123638_000_000,
+        "timestamp": -999.0,
+    }  # compensated wall time must be irrelevant
+    sample = sample_from_data(data, "raw", origin_ns, origin_ns + 123650_000_000)
+    with tempfile.TemporaryDirectory(prefix="gopro_latency_") as directory:
+        root = Path(directory)
+        csv_path = save_samples(root, (sample,))
+        save_samples(root, (sample,))
+        with csv_path.open(newline="", encoding="utf-8") as stream:
+            rows = list(csv.DictReader(stream))
+        saved = cv2.imread(str(root / rows[0]["image"]))
+        if not np.array_equal(saved[HEADER_HEIGHT:, : frame.shape[1]], original):
+            raise RuntimeError("Self-test failed: saved camera pixels changed")
+        if len(rows) != 2 or rows[0]["image"] == rows[1]["image"]:
+            raise RuntimeError("Self-test failed: sample filenames/CSV rows")
+        for row in rows:
+            row["source_ms"] = "123456.0"
+        with csv_path.open("w", newline="", encoding="utf-8") as stream:
+            writer = csv.DictWriter(stream, fieldnames=CSV_FIELDS)
+            writer.writeheader()
+            writer.writerows(rows)
+        if read_measurements(csv_path)["raw"] != [(182.0, 194.0, 12.0)] * 2:
+            raise RuntimeError("Self-test failed: optical/input delay calculation")
+        if not np.array_equal(frame, original):
+            raise RuntimeError("Self-test failed: mutated camera frame")
+    print(
+        "Camera latency self-test passed: monotonic timestamps, PNG/CSV, and 182ms optical / 194ms input delay"
+    )
