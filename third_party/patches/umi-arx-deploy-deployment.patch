+"""Loopback protocol integration; synthetic policy only, never optical/model latency."""
+
+import asyncio
+from pathlib import Path
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SERVER_SRC = ROOT.parent / "openpi-umi" / "src"
+sys.path.insert(0, str(ROOT / "packages" / "openpi-client" / "src"))
+
+
+@unittest.skipUnless(SERVER_SRC.is_dir(), "requires the adjacent openpi-umi checkout")
+class PolicyLatencyRoundtripTests(unittest.IsolatedAsyncioTestCase):
+    async def run_roundtrip(self, shared_clock):
+        sys.path.insert(0, str(SERVER_SRC))
+        from openpi.serving.websocket_policy_server import WebsocketPolicyServer
+        from openpi.shared import latency
+        from openpi_client.websocket_client_policy import WebsocketClientPolicy
+        from websockets.asyncio.server import serve
+
+        class SyntheticPolicy:
+            def __init__(self):
+                self.observations = []
+
+            def infer(self, observation):
+                self.observations.append(dict(observation))
+                latency.mark_model_dispatch()
+                return {"actions": [observation["frame"]]}
+
+        policy = SyntheticPolicy()
+        server = WebsocketPolicyServer(policy, host="127.0.0.1", port=0)
+        if not shared_clock:
+            # Exercise network-bound calibration with an explicitly distinct clock identity.
+            server._latency_clock_id = "server:synthetic-remote-clock"
+            server._metadata["latency_clock_id"] = server._latency_clock_id
+
+        def run_client(port):
+            client = WebsocketClientPolicy(
+                host="127.0.0.1", port=port, connect_timeout=3,
+                request_timeout=3, close_timeout=1,
+            )
+            try:
+                self.assertEqual(client.infer({"frame": 1})["actions"], [1])
+                mapping = client.enable_latency_probe(clock_samples=3)
+                self.assertEqual(mapping["same_clock"], shared_clock)
+                self.assertLessEqual(mapping["offset_lower_ns"], 0)
+                self.assertGreaterEqual(mapping["offset_upper_ns"], 0)
+                results = [client.infer({"frame": frame}) for frame in (2, 3)]
+                self.assertNotEqual(
+                    results[0]["client_latency"]["request_id"], results[1]["client_latency"]["request_id"],
+                )
+                for frame, result in zip((2, 3), results):
+                    self.assertEqual(result["actions"], [frame])
+                    local = result["client_latency"]
+                    remote = result["latency_probe"]
+                    self.assertEqual(local["request_id"], remote["request_id"])
+                    self.assertEqual(remote["clock_id"], mapping["server_clock_id"])
+                    # Actual loopback test uses one process and hence one monotonic clock.
+                    ticks = [
+                        local["send_ns"], remote["received_ns"], remote["policy_start_ns"],
+                        remote["model_dispatch_ns"], local["return_ns"],
+                    ]
+                    self.assertEqual(ticks, sorted(ticks))
+                    self.assertIn("infer_ms", result["server_timing"])
+            finally:
+                client.close()
+
+        async with serve(server._handler, "127.0.0.1", 0, compression=None, max_size=None) as listener:
+            port = listener.sockets[0].getsockname()[1]
+            await asyncio.to_thread(run_client, port)
+        self.assertEqual(policy.observations, [{"frame": 1}, {"frame": 2}, {"frame": 3}])
+
+    async def test_shared_clock_protocol_roundtrip(self):
+        await self.run_roundtrip(shared_clock=True)
+
+    async def test_distinct_clock_protocol_roundtrip(self):
+        await self.run_roundtrip(shared_clock=False)
+
+
+if __name__ == "__main__":
+    unittest.main()
