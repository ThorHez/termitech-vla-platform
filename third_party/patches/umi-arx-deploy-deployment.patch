diff --git a/scripts/inspect_robot_can_feedback.py b/scripts/inspect_robot_can_feedback.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d601ebc70bce3ab05a2837cd40e1d37200a5925
--- /dev/null
+++ b/scripts/inspect_robot_can_feedback.py
@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Receive-only SocketCAN capture plus optional read-only SDK snapshots.
+
+Requires the installed latency-aware robot server whose query handlers do not
+initialize an inactive controller. Do not point it at an unverified older
+server: its handling of even query commands may initialize hardware. This
+client only sends queries and never writes a CAN frame or requests motion.
+Kernel CAN timestamps identify host reception, not motor sampling.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import datetime as dt
+import json
+import math
+from pathlib import Path
+import socket
+import struct
+import sys
+import threading
+import time
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+# Linux's old time64 ABI on this verified 64-bit deployment host.
+SO_TIMESTAMPNS = 35
+SO_RXQ_OVFL = 40
+
+
+def json_default(value):
+    if hasattr(value, "tolist"):
+        return value.tolist()
+    raise TypeError(type(value).__name__)
+
+
+def clock_anchor():
+    before = time.monotonic_ns()
+    wall = time.time_ns()
+    after = time.monotonic_ns()
+    return {"wall_ns": wall, "mono_ns": (before + after) // 2,
+            "uncertainty_ns": (after - before + 1) // 2}
+
+
+def parse_frame(payload, ancillary, flags, received_ns, anchor):
+    if len(payload) != 16 or flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
+        raise ValueError("Truncated or unsupported CAN frame/ancillary data")
+    can_id, length, raw = struct.unpack("=IB3x8s", payload)
+    if length > 8:
+        raise ValueError("Invalid classical CAN payload length")
+    kernel_ns = None
+    overflow = None
+    for level, kind, data in ancillary:
+        if level == socket.SOL_SOCKET and kind == SO_TIMESTAMPNS:
+            if len(data) != 16:
+                raise ValueError("Expected 64-bit Linux timespec")
+            sec, nsec = struct.unpack("=qq", data)
+            if sec < 0 or not 0 <= nsec < 1_000_000_000:
+                raise ValueError("Invalid kernel CAN timestamp")
+            kernel_ns = sec * 1_000_000_000 + nsec
+        elif level == socket.SOL_SOCKET and kind == SO_RXQ_OVFL:
+            overflow = struct.unpack("=I", data[:4])[0]
+    if kernel_ns is None:
+        raise ValueError("Kernel CAN reception timestamp missing")
+    return {
+        "can_id": can_id, "dlc": length, "data_hex": raw[:length].hex(),
+        "flags": flags, "locally_generated": bool(flags & socket.MSG_DONTROUTE),
+        "kernel_wall_ns": kernel_ns,
+        "kernel_monotonic_ns": kernel_ns + anchor["mono_ns"] - anchor["wall_ns"],
+        "userspace_receive_ns": received_ns, "clock_anchor": anchor,
+        "socket_dropped_total": overflow,
+    }
+
+
+class PassiveCapture:
+    def __init__(self, interface, path, max_frames=500000):
+        self.interface, self.path, self.max_frames = interface, Path(path), max_frames
+        self.stop = threading.Event()
+        self.ready = threading.Event()
+        self.counts = Counter()
+        self.error = None
+        self.started_ns = self.stopped_ns = None
+        self.offset_range = None
+        self.thread = threading.Thread(target=self.run, name="passive-can-reader", daemon=True)
+
+    def run(self):
+        can_socket = None
+        try:
+            can_socket = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
+            can_socket.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4 * 1024 * 1024)
+            can_socket.setsockopt(socket.SOL_SOCKET, SO_TIMESTAMPNS, 1)
+            can_socket.setsockopt(socket.SOL_SOCKET, SO_RXQ_OVFL, 1)
+            can_socket.bind((self.interface,))
+            can_socket.settimeout(.1)
+            self.started_ns = time.monotonic_ns()
+            self.ready.set()
+            with self.path.open("x", buffering=1024 * 1024) as stream:
+                while not self.stop.is_set():
+                    try:
+                        data, ancillary, flags, _ = can_socket.recvmsg(72, 256)
+                    except socket.timeout:
+                        continue
+                    received_ns = time.monotonic_ns()
+                    anchor = clock_anchor()
+                    offset = anchor["mono_ns"] - anchor["wall_ns"]
+                    if self.offset_range is None:
+                        self.offset_range = [offset, offset]
+                    else:
+                        self.offset_range = [min(self.offset_range[0], offset), max(self.offset_range[1], offset)]
+                    row = parse_frame(data, ancillary, flags, received_ns, anchor)
+                    self.counts["frames"] += 1
+                    self.counts["tx_echo" if row["locally_generated"] else "rx"] += 1
+                    if row["socket_dropped_total"] is not None:
+                        self.counts["socket_dropped_total"] = row["socket_dropped_total"]
+                    if self.counts["frames"] > self.max_frames:
+                        raise RuntimeError("CAN capture limit reached; ending read-only audit")
+                    row["capture_seq"] = self.counts["frames"]
+                    stream.write(json.dumps(row, separators=(",", ":")) + "\n")
+        except BaseException as exc:
+            self.error = f"{type(exc).__name__}: {exc}"
+        finally:
+            if can_socket is not None:
+                can_socket.close()
+            self.stopped_ns = time.monotonic_ns()
+            self.ready.set()
+
+    def close(self):
+        self.stop.set()
+        self.thread.join(timeout=2)
+        if self.thread.is_alive():
+            self.error = "CAN receiver did not finish within 2 seconds"
+
+
+class ReadOnlyProbe:
+    def __init__(self, host, port, timeout_ms=1500):
+        import zmq
+        self.zmq = zmq
+        self.context = zmq.Context()
+        self.socket = self.context.socket(zmq.REQ)
+        self.socket.setsockopt(zmq.LINGER, 0)
+        self.socket.setsockopt(zmq.RCVTIMEO, timeout_ms)
+        self.socket.setsockopt(zmq.SNDTIMEO, timeout_ms)
+        self.socket.connect(f"tcp://{host}:{port}")
+
+    def request(self, command):
+        if command not in ("GET_LATENCY_INFO", "GET_STATE"):
+            raise ValueError("Only read-only commands are permitted")
+        request = {"cmd": command, "data": None}
+        request_id = uuid.uuid4().hex
+        if command == "GET_STATE":
+            request["_robot_latency"] = {"version": 1, "request_id": request_id}
+        sent_ns = time.monotonic_ns()
+        self.socket.send_pyobj(request)
+        reply = self.socket.recv_pyobj()
+        received_ns = time.monotonic_ns()
+        if not isinstance(reply, dict) or reply.get("cmd") != command or not isinstance(reply.get("data"), dict):
+            raise RuntimeError(f"Read-only {command} failed: {reply}")
+        if command == "GET_STATE":
+            from utils.robot_latency import validate_timing
+            timing = dict(reply.get("robot_latency") or {})
+            if timing.get("request_id") != request_id:
+                raise RuntimeError("SDK response request identity mismatch")
+            timing.update(command=command, client_send_ns=sent_ns, client_return_ns=received_ns)
+            reply["robot_latency"] = validate_timing(timing)
+        return reply
+
+    def close(self):
+        self.socket.close()
+        self.context.term()
+
+
+def positive(value):
+    value = float(value)
+    if not math.isfinite(value) or value <= 0:
+        raise argparse.ArgumentTypeError("must be finite and positive")
+    return value
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--interface", default="can0")
+    parser.add_argument("--host", default="127.0.0.1")
+    parser.add_argument("--port", type=int, default=8765)
+    parser.add_argument("--duration", type=positive, default=10.)
+    parser.add_argument("--frequency", type=positive, default=100.)
+    parser.add_argument("--wait-active", type=float, default=0., help="maximum seconds to wait for user-started controller")
+    parser.add_argument("--output", type=Path, default=ROOT / "data_local/shellgame_eval/can_feedback_audit")
+    args = parser.parse_args(argv)
+    if not math.isfinite(args.wait_active) or args.wait_active < 0:
+        parser.error("--wait-active must be finite and nonnegative")
+    session = args.output / f"{dt.datetime.now():%Y%m%d_%H%M%S}_{uuid.uuid4().hex[:8]}"
+    session.mkdir(parents=True, exist_ok=False)
+    print(f"[can-audit] Receive-only CAN + read-only SDK; output: {session}", flush=True)
+    print("[can-audit] Requires the updated read-only query handlers. No CAN transmissions; run with eval stopped.", flush=True)
+    metadata = {"schema_version": 1, "interface": args.interface, "host": args.host, "port": args.port,
+                "duration_s": args.duration, "frequency_hz": args.frequency, "sdk_samples": 0,
+                "scope": "Linux CAN reception to SDK snapshots; excludes motor sampling and adapter pre-kernel delay"}
+    capture = PassiveCapture(args.interface, session / "can_frames.jsonl")
+    probe = None
+    exit_code = 1
+    try:
+        capture.thread.start()
+        if not capture.ready.wait(timeout=5) or capture.error:
+            raise RuntimeError(capture.error or "CAN socket failed to become ready")
+        wait_deadline = time.monotonic() + args.wait_active
+        while True:
+            if capture.error:
+                raise RuntimeError(capture.error)
+            if probe is not None:
+                probe.close()
+            probe = ReadOnlyProbe(args.host, args.port)
+            try:
+                info = probe.request("GET_LATENCY_INFO")["data"]
+            except Exception:
+                if time.monotonic() >= wait_deadline:
+                    raise
+            else:
+                from utils.robot_latency import local_clock_id, validate_latency_metadata
+                if info.get("protocol_version") != 1 or info.get("clock_id") != local_clock_id():
+                    raise RuntimeError("Need the updated local robot server and a shared Linux clock")
+                metadata["last_server_info"] = info
+                if info.get("controller_active") is True:
+                    metadata["server"] = validate_latency_metadata(info)
+                    break
+                if time.monotonic() >= wait_deadline:
+                    raise RuntimeError("Controller inactive; no hardware will be initialized by this audit")
+            time.sleep(.5)
+        print("[can-audit] Active controller found; collecting read-only snapshots.", flush=True)
+        # Build a preceding CAN history without issuing any motor command.
+        time.sleep(.25)
+        start = time.monotonic()
+        metadata["sampling_start_ns"] = time.monotonic_ns()
+        deadline = start + args.duration
+        next_sample = start
+        with (session / "sdk_states.jsonl").open("x", buffering=1024 * 1024) as stream:
+            while time.monotonic() < deadline:
+                if capture.error:
+                    raise RuntimeError(capture.error)
+                wait = next_sample - time.monotonic()
+                if wait > 0:
+                    time.sleep(wait)
+                if time.monotonic() >= deadline:
+                    break
+                row = probe.request("GET_STATE")
+                if row["robot_latency"]["sdk_instance_id"] != metadata["server"]["sdk_instance_id"]:
+                    raise RuntimeError("SDK instance changed during capture")
+                stream.write(json.dumps(row, default=json_default, separators=(",", ":")) + "\n")
+                metadata["sdk_samples"] += 1
+                next_sample = max(next_sample + 1 / args.frequency, time.monotonic())
+        metadata["sampling_end_ns"] = time.monotonic_ns()
+        exit_code = 0
+    except KeyboardInterrupt:
+        metadata["error"] = "Interrupted by user"
+        exit_code = 130
+    except Exception as exc:
+        metadata["error"] = f"{type(exc).__name__}: {exc}"
+        print(f"[can-audit] {metadata['error']}", flush=True)
+    finally:
+        if probe is not None:
+            probe.close()
+        capture.close()
+        metadata.update(can_counts=dict(capture.counts), can_error=capture.error,
+                        capture_start_ns=capture.started_ns, capture_end_ns=capture.stopped_ns,
+                        wall_to_monotonic_offset_range=capture.offset_range)
+        if capture.error:
+            exit_code = 1
+        (session / "session.json").write_text(json.dumps(metadata, indent=2, ensure_ascii=False) + "\n")
+        print(f"[can-audit] Saved {metadata['sdk_samples']} SDK replies; CAN {dict(capture.counts)}", flush=True)
+        print(f"[can-audit] Output: {session}", flush=True)
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
