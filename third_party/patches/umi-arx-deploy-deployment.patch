+"""Opt-in timestamps for the existing ARX ZMQ state replies.
+
+This measures SDK cache age, not physical encoder sampling or CAN latency.
+Nothing here creates a controller, reads another state sample, or issues motion.
+"""
+
+import math
+from pathlib import Path
+import time
+import uuid
+
+
+PROTOCOL_VERSION = 1
+SOURCE_KIND = "SDK_cache_update"
+SDK_QUANTIZATION_NS = 1_000
+SCOPE = (
+    "SDK state-cache update to client receipt; excludes encoder sampling and "
+    "CAN/cache delay before the SDK timestamp. EEF and joint snapshots retain "
+    "their own timestamps. This is not command-to-motion latency."
+)
+
+
+def linux_clock_id():
+    """Only Linux boot identity establishes a shared monotonic clock domain."""
+    try:
+        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
+        return "linux:" + str(uuid.UUID(boot_id))
+    except (OSError, ValueError):
+        return "server:" + uuid.uuid4().hex
+
+
+class RobotLatencyServer:
+    def __init__(self, *, clock_ns=None, clock_id=None):
+        self.clock_ns = time.monotonic_ns if clock_ns is None else clock_ns
+        self.clock_id = linux_clock_id() if clock_id is None else clock_id
+        self.sdk_instance_id = None
+
+    def new_sdk_instance(self):
+        """Call once after each successful construction of the actual SDK."""
+        self.sdk_instance_id = uuid.uuid4().hex
+
+    def info(self):
+        return {
+            "protocol_version": PROTOCOL_VERSION,
+            "clock_id": self.clock_id,
+            "sdk_instance_id": self.sdk_instance_id,
+            "source_kind": SOURCE_KIND,
+            "scope": SCOPE,
+        }
+
+    def decorate_reply(
+        self, request, reply, controller, server_received_ns,
+        *, eef_state=None, joint_state=None,
+    ):
+        """Append timing to an existing reply, preserving its ordinary payload.
+
+        Missing/broken timing metadata never changes whether a command executes
+        or what state is returned. No SDK timing call occurs without opt-in.
+        Call immediately before send_pyobj; server_send_ns excludes serialization.
+        """
+        if (request.get("cmd") not in ("GET_STATE", "SET_EE_POSE")
+                or "_robot_latency" not in request):
+            return reply
+        probe = request["_robot_latency"]
+        request_id = probe.get("request_id") if isinstance(probe, dict) else None
+        timing = {
+            "version": PROTOCOL_VERSION,
+            "request_id": request_id if isinstance(request_id, str) else None,
+            "clock_id": self.clock_id,
+            "sdk_instance_id": self.sdk_instance_id,
+            "source_kind": SOURCE_KIND,
+            "server_received_ns": server_received_ns,
+        }
+        try:
+            if not isinstance(probe, dict):
+                raise ValueError("_robot_latency must be a dictionary")
+            if type(probe.get("version")) is not int or probe["version"] != PROTOCOL_VERSION:
+                raise ValueError("unsupported _robot_latency version")
+            if not isinstance(request_id, str) or not 1 <= len(request_id) <= 256:
+                raise ValueError("request_id must contain 1 to 256 characters")
+            if self.sdk_instance_id is None:
+                raise ValueError("no identified SDK controller instance")
+            if eef_state is None or joint_state is None:
+                raise ValueError("ordinary reply has no state snapshots")
+            eef_s = float(eef_state.timestamp)
+            joint_s = float(joint_state.timestamp)
+            if not all(math.isfinite(value) and value > 0 for value in (eef_s, joint_s)):
+                raise ValueError("uninitialized or invalid SDK state timestamp")
+
+            # Both returned snapshots were already read. Bracket a clock query
+            # per request; neither a common SDK epoch nor long-term drift is assumed.
+            before_ns = self.clock_ns()
+            sdk_s = float(controller.get_timestamp())
+            after_ns = self.clock_ns()
+            if not math.isfinite(sdk_s) or sdk_s < 0 or after_ns < before_ns:
+                raise ValueError("invalid SDK clock sample")
+            if max(eef_s, joint_s) > sdk_s + 1e-6:
+                raise ValueError("state timestamp is newer than the SDK clock sample")
+            sdk_ns = round(sdk_s * 1_000_000_000)
+            offset_mid_ns = (before_ns + after_ns) // 2 - sdk_ns
+            # Conservatively allow 1us for each of the reference timestamp and
+            # a state timestamp, plus the full host call-bracket uncertainty.
+            uncertainty_ns = (after_ns - before_ns + 1) // 2 + 2 * SDK_QUANTIZATION_NS
+            timing.update({
+                "eef_source_ns": offset_mid_ns + round(eef_s * 1_000_000_000),
+                "joint_source_ns": offset_mid_ns + round(joint_s * 1_000_000_000),
+                "clock_uncertainty_ns": uncertainty_ns,
+                "eef_sdk_timestamp_s": eef_s,
+                "joint_sdk_timestamp_s": joint_s,
+            })
+        except Exception as error:
+            timing["error"] = f"{type(error).__name__}: {error}"
+        reply["robot_latency"] = timing
+        timing["server_send_ns"] = self.clock_ns()
+        return reply
