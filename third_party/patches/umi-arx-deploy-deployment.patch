+        lines.append(f"| {motor} | {ages['n']} | {fmt(ages, 'mean')} | {fmt(ages, 'p95')} | {fmt(ages, 'max')} | {fmt(intervals, 'mean')} | {fmt(intervals, 'max')} |")
+    subset = report["unique_whole_snapshot_subset"]
+    lines.extend(["", f"整组唯一候选子集：{subset['n']} 份；其中 EEF 与 joint_state 时间戳一致：{subset['eef_and_joint_same_snapshot_count']} 份。",
