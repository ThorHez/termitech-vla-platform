+"""Exercise the deployment loop with deterministic hardware-free collaborators."""
+
+from contextlib import ExitStack, redirect_stdout
+import importlib.util
+import io
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+from click.testing import CliRunner
+import numpy as np
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class FakeClock:
+    def __init__(self):
+        self.ns = 1_000_000_000_000
+        self.sleeps = []
+
+    def now(self):
+        return self.ns / 1e9
+
+    def advance(self, seconds):
+        self.ns += round(seconds * 1e9)
+
+    def sleep(self, seconds):
+        self.sleeps.append(seconds)
+        self.advance(seconds)
+
+
+class DeploymentLoopLatencyTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        previous_cwd, previous_path = Path.cwd(), sys.path[:]
+        try:
+            spec = importlib.util.spec_from_file_location(
+                "deployment_eval_latency_test", ROOT / "scripts" / "eval_arx5_pi_hzl.py",
+            )
+            cls.eval = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(cls.eval)
+        finally:
+            os.chdir(previous_cwd)
+            sys.path[:] = previous_path
+
+    def run_episode(self, *, tracing=False, warmup=False, rejected=False, observe_only=False,
+                    direct_action_direction=None, discard_samples=False, robot_tracing=False):
+        clock, events, observations, requests, actions, records = FakeClock(), [], [], [], [], []
+        robot_records = []
+        target_inferences = 1 if observe_only else 2 + int(warmup)
+        state = SimpleNamespace(last_deadline=None, inference_count=0)
+
+        def get_obs():
+            index = len(observations) + 1
+            events.append(("get_obs", index))
+            clock.advance(0.002)
+            observation = {
+                "camera0_rgb": np.full((2, 224, 224, 3), 255, dtype=np.uint8),
+                "camera1_rgb": np.stack([
+                    np.full((224, 224, 3), 100 + index, dtype=np.uint8),
+                    np.full((224, 224, 3), index, dtype=np.uint8),
+                ]),
+                "camera1_read_monotonic_ns": np.array([clock.ns - 200_000_000, clock.ns - 100_000_000]),
+                "sampled_monotonic_ns": clock.ns,
+                "timestamp": np.array([clock.now() - 0.1]),
+                "robot0_eef_pos": np.array([[0.1, 0.2, 0.3]]),
+                "robot0_eef_rot_axis_angle": np.zeros((1, 3)),
+                "robot0_gripper_width": np.array([0.03]),
+            }
+            observations.append(observation)
+            if robot_tracing:
+                observation["robot_observation_monotonic_ns"] = clock.ns
+                observation["robot0_feedback_timing"] = {"test_index": index}
+            return observation
+
+        def infer_step(history, **kwargs):
+            state.inference_count += 1
+            frame = kwargs["current_frame"]
+            index = int(frame[0, 0, 0])
+            events.append(("infer", index))
+            send_ns = clock.ns
+            clock.advance(0.020)
+            result = {
+                "actions": np.full((16, 10), index / 100, dtype=np.float64),
+                "client_latency": {"send_ns": send_ns, "return_ns": clock.ns},
+                "latency_probe": {"request_id": f"request-{index}"},
+            }
+            requests.append((frame, result))
+            return result
+
+        def exec_actions(**kwargs):
+            index = len(observations)
+            events.append(("exec_actions", index))
+            actions.append({key: value.copy() if isinstance(value, np.ndarray) else value
+                           for key, value in kwargs.items()})
+            state.last_deadline = float(kwargs["timestamps"][-1])
+
+        def key_events():
+            finished = state.inference_count >= target_inferences
+            deadline_reached = state.last_deadline is None or clock.now() >= state.last_deadline
+            return ["s"] if finished and deadline_reached else []
+
+        def record(frame, read_ns, sampled_ns, result, *, label):
+            events.append(("record", int(frame[0, 0, 0])))
+            records.append((frame, read_ns, sampled_ns, result, label))
+            # Recorder queue-full/inactive behavior returns without blocking or stopping policy.
+            return False if discard_samples else None
+
+        def record_robot(obs, used_ns, *, label):
+            events.append(("robot_record", obs["robot0_feedback_timing"]["test_index"]))
+            robot_records.append((obs, used_ns, label))
+
+        env = SimpleNamespace(
+            get_obs=mock.Mock(side_effect=get_obs),
+            exec_actions=mock.Mock(side_effect=exec_actions),
+            start_episode=mock.Mock(side_effect=lambda timestamp: events.append(("start_episode", timestamp))),
+            end_episode=mock.Mock(side_effect=lambda: events.append(("end_episode",))),
+        )
+        client = SimpleNamespace(
+            cached_infer_enabled=True,
+            infer_step=mock.Mock(side_effect=infer_step),
+            upload_history=mock.Mock(return_value={"cache_ready": True}),
+            start_forced_direction_test=mock.Mock(return_value={"cache_ready": True}),
+            reset_session=mock.Mock(side_effect=lambda: events.append(("reset_session",))),
+        )
+        recorder = SimpleNamespace(record=mock.Mock(side_effect=record)) if tracing else None
+        robot_recorder = SimpleNamespace(record=mock.Mock(side_effect=record_robot), metadata={}) if robot_tracing else None
+        history = SimpleNamespace(ready=direct_action_direction is None, episode_start_pose6=np.zeros(6))
+        safety = mock.Mock(side_effect=[(0, "synthetic rejected chunk"), (16, None)]) if rejected else mock.Mock(
+            return_value=(16, None),
+        )
+        fake_time = SimpleNamespace(time=clock.now, monotonic=clock.now, monotonic_ns=lambda: clock.ns,
+                                    sleep=clock.sleep)
+        with ExitStack() as stack:
+            stack.enter_context(mock.patch.dict(sys.modules, {
+                "peripherals.keystroke_counter": SimpleNamespace(KeyCode=lambda char: char),
+            }))
+            stack.enter_context(mock.patch.object(self.eval, "time", fake_time))
+            stack.enter_context(mock.patch.object(self.eval, "select_safe_waypoint_count", safety))
+            stack.enter_context(mock.patch.object(self.eval, "eef_pose_to_link6", side_effect=lambda pose, _: pose.copy()))
+            stack.enter_context(mock.patch.object(self.eval, "relative_chunk_to_world", side_effect=lambda raw, _: raw[:, :7].copy()))
+            stack.enter_context(mock.patch.object(self.eval, "link6_actions_to_eef", side_effect=lambda chunk, _: chunk.copy()))
+            stack.enter_context(mock.patch.object(self.eval, "relative_pose10", return_value=np.zeros(10)))
+            stack.enter_context(mock.patch.object(self.eval, "rotation_error_deg", return_value=0.0))
+            stack.enter_context(mock.patch.object(self.eval, "print_action_debug"))
+            stack.enter_context(mock.patch.object(self.eval, "hold_current_pose", side_effect=lambda _: events.append(("hold",))))
+            stack.enter_context(mock.patch.object(self.eval, "draw_status", side_effect=lambda frame, _: frame))
+            stack.enter_context(mock.patch.object(self.eval.cv2, "imshow"))
+            stack.enter_context(mock.patch.object(self.eval.cv2, "pollKey"))
+            stack.enter_context(redirect_stdout(io.StringIO()))
+            result = self.eval.run_policy(
+                env=env, policy_client=client, history=history, wrist_camera_index=1, prompt="test prompt",
+                frequency=20.0, steps_per_inference=16, action_lead_time=0.1,
+                max_duration=10.0, max_inference_latency=3.0,
+                max_pos_speed=0.4, max_rot_speed=0.8,
+                workspace_min=np.array([-0.5, -0.5, 0.03]), workspace_max=np.array([0.5, 0.5, 0.8]),
+                gripper_min=0.0, gripper_max=0.085, eef_offset=0.145, gripper_scale=False,
+                direct_gripper_full_open=0.11, key_counter=SimpleNamespace(get_press_events=key_events),
+                observe_only=observe_only, warmup_done=not warmup,
+                direct_action_direction=direct_action_direction, latency_recorder=recorder,
+                robot_latency_recorder=robot_recorder,
+            )
+        return SimpleNamespace(result=result, events=events, observations=observations, requests=requests,
+                               actions=actions, records=records, robot_records=robot_records,
+                               robot_metadata=robot_recorder.metadata if robot_recorder is not None else None,
+                               sleeps=clock.sleeps, env=env, client=client)
+
+    def assert_same_execution(self, baseline, traced):
+        self.assertEqual(baseline.result, traced.result)
+        self.assertEqual(baseline.events, [event for event in traced.events if event[0] not in ("record", "robot_record")])
+        self.assertEqual(baseline.sleeps, traced.sleeps)
+        self.assertEqual(len(baseline.actions), len(traced.actions))
+        for expected, actual in zip(baseline.actions, traced.actions):
+            self.assertEqual(expected.keys(), actual.keys())
+            for key in expected:
+                np.testing.assert_array_equal(actual[key], expected[key])
+
+    def assert_exact_records(self, episode, indices):
+        self.assertEqual(len(episode.records), len(indices))
+        for record, index in zip(episode.records, indices):
+            frame, read_ns, sampled_ns, result, label = record
+            observation = episode.observations[index - 1]
+            request_frame, request_result = episode.requests[index - 1]
+            self.assertIs(frame, request_frame)
+            self.assertIs(result, request_result)
+            np.testing.assert_array_equal(frame, observation["camera1_rgb"][-1])
+            self.assertEqual(read_ns, observation["camera1_read_monotonic_ns"][-1])
+            self.assertEqual(sampled_ns, observation["sampled_monotonic_ns"])
+            self.assertIn(label, ("policy", "observe-only"))
+
+    def test_tracing_preserves_two_normal_and_forced_direction_chunks(self):
+        for direction in (None, "left"):
+            with self.subTest(direction=direction):
+                baseline = self.run_episode(direct_action_direction=direction)
+                traced = self.run_episode(tracing=True, direct_action_direction=direction)
+                self.assert_same_execution(baseline, traced)
+                self.assertEqual(traced.env.get_obs.call_count, 2)
+                self.assertEqual(traced.client.infer_step.call_count, 2)
+                self.assertEqual(traced.env.exec_actions.call_count, 2)
+                relevant = [event for event in traced.events if event[0] in ("get_obs", "infer", "exec_actions", "record")]
+                self.assertEqual(relevant, [
+                    ("get_obs", 1), ("infer", 1), ("exec_actions", 1), ("record", 1),
+                    ("get_obs", 2), ("infer", 2), ("exec_actions", 2), ("record", 2),
+                ])
+                self.assert_exact_records(traced, [1, 2])
+                if direction:
+                    traced.client.start_forced_direction_test.assert_called_once_with(direction)
+                    traced.client.upload_history.assert_not_called()
+                else:
+                    traced.client.upload_history.assert_called_once()
+                traced.client.reset_session.assert_called_once()
+                traced.env.end_episode.assert_called_once()
+
+    def test_warmup_is_not_recorded_and_fresh_policy_observations_are_recorded(self):
+        baseline = self.run_episode(warmup=True)
+        traced = self.run_episode(tracing=True, warmup=True)
+        self.assert_same_execution(baseline, traced)
+        self.assertEqual(traced.env.get_obs.call_count, 3)
+        self.assertEqual(traced.env.exec_actions.call_count, 2)
+        self.assert_exact_records(traced, [2, 3])
+
+    def test_rejected_chunk_is_recorded_without_new_actions_or_observations(self):
+        baseline = self.run_episode(rejected=True)
+        traced = self.run_episode(tracing=True, rejected=True)
+        self.assert_same_execution(baseline, traced)
+        self.assertEqual(traced.env.exec_actions.call_count, 1)
+        self.assert_exact_records(traced, [1, 2])
+        self.assertLess(traced.events.index(("record", 1)), traced.events.index(("get_obs", 2)))
+
+    def test_discarding_records_does_not_stop_policy_or_add_waits(self):
+        baseline = self.run_episode()
+        traced = self.run_episode(tracing=True, discard_samples=True)
+        self.assert_same_execution(baseline, traced)
+        self.assertEqual(traced.env.exec_actions.call_count, 2)
+        self.assertEqual(len(traced.records), 2)
+
+    def test_observe_only_records_actual_request_without_action_submission(self):
+        baseline = self.run_episode(observe_only=True)
+        traced = self.run_episode(tracing=True, observe_only=True)
+        self.assert_same_execution(baseline, traced)
+        traced.env.exec_actions.assert_not_called()
+        self.assert_exact_records(traced, [1])
+        self.assertEqual(traced.records[0][-1], "observe-only")
+
+    def test_recording_and_self_test_are_rejected_before_any_connection(self):
+        with mock.patch.object(self.eval, "ShellGamePolicyClient", side_effect=AssertionError("must not connect")):
+            result = CliRunner().invoke(self.eval.main, ["--record-policy-input-latency", "--self-test"])
+        self.assertEqual(result.exit_code, 2, repr(result.exception))
+        self.assertIn("recording", result.output)
+        self.assertIn("self-test", result.output)
+
+    def test_robot_timing_preserves_control_and_records_exact_used_observation(self):
+        for options in ({"direct_action_direction": "left"}, {"warmup": True}, {"rejected": True}, {"observe_only": True}):
+            with self.subTest(options=options):
+                baseline = self.run_episode(**options)
+                traced = self.run_episode(robot_tracing=True, **options)
+                self.assert_same_execution(baseline, traced)
+                expected = traced.observations[1:] if options.get("warmup") else traced.observations
+                self.assertEqual(len(traced.robot_records), len(expected))
+                for (obs, used_ns, label), expected_obs in zip(traced.robot_records, expected):
+                    self.assertIs(obs, expected_obs)
+                    self.assertEqual(used_ns, obs["robot_observation_monotonic_ns"])
+                    self.assertNotEqual(label, "warmup")
+                    index = obs["robot0_feedback_timing"]["test_index"]
+                    if ("exec_actions", index) in traced.events:
+                        self.assertLess(traced.events.index(("exec_actions", index)), traced.events.index(("robot_record", index)))
+                windows = traced.robot_metadata.get("policy_windows", [])
+                if options.get("observe_only"):
+                    self.assertEqual(windows, [])
+                else:
+                    self.assertEqual(len(windows), 1)
+                    window = windows[0]
+                    for _, used_ns, _ in traced.robot_records:
+                        self.assertLessEqual(window["start_ns"], used_ns)
+                        self.assertGreater(window["end_ns"], used_ns)
+                    if options.get("warmup"):
+                        self.assertGreater(window["start_ns"], traced.observations[0]["robot_observation_monotonic_ns"])
+
+    def test_robot_recording_and_self_test_fail_before_any_connection(self):
+        result = CliRunner().invoke(self.eval.main, ["--record-robot-obs-latency", "--self-test"])
+        self.assertEqual(result.exit_code, 2)
+        self.assertIn("robot latency", result.output)
+
+
+if __name__ == "__main__":
+    unittest.main()
