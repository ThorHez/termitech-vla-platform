@@ -0,0 +1,163 @@
+"""CAN capture contracts with synthetic packets and mocks; no hardware I/O."""
+
+import importlib.util
+import json
+from pathlib import Path
+import socket
+import struct
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+from utils import robot_latency
+
+
+SCRIPT = Path(__file__).resolve().parents[2] / "scripts/inspect_robot_can_feedback.py"
+SPEC = importlib.util.spec_from_file_location("can_capture_for_test", SCRIPT)
+capture = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(capture)
+
+
+def packet(can_id=1, data=b"\x20\x80\x00\x80\x08\x00\x50\x00"):
+    return struct.pack("=IB3x8s", can_id, len(data), data)
+
+
+def ancillary(timestamp_ns=10_000_000_123, dropped=None):
+    result = [(socket.SOL_SOCKET, capture.SO_TIMESTAMPNS,
+               struct.pack("=qq", *divmod(timestamp_ns, 1_000_000_000)))]
+    if dropped is not None:
+        result.append((socket.SOL_SOCKET, capture.SO_RXQ_OVFL, struct.pack("=I", dropped)))
+    return result
+
+
+class CaptureContractTests(unittest.TestCase):
+    def setUp(self):
+        self.anchor = {"wall_ns": 10_000_000_000, "mono_ns": 5_000_000_000, "uncertainty_ns": 7}
+
+    def parse(self, **kwargs):
+        return capture.parse_frame(kwargs.get("data", packet()), kwargs.get("ancillary", ancillary()),
+                                   kwargs.get("flags", 0), 5_000_000_333, self.anchor)
+
+    def test_clock_anchor_brackets_realtime_in_monotonic_domain(self):
+        with mock.patch.object(capture.time, "monotonic_ns", side_effect=[100, 113]), \
+             mock.patch.object(capture.time, "time_ns", return_value=1000000):
+            anchor = capture.clock_anchor()
+        self.assertEqual(anchor, {"wall_ns": 1000000, "mono_ns": 106, "uncertainty_ns": 7})
+
+    def test_kernel_timestamp_mapping_preserves_original_and_clock_bound(self):
+        result = self.parse()
+        self.assertEqual(result["kernel_wall_ns"], 10_000_000_123)
+        self.assertEqual(result["kernel_monotonic_ns"], 5_000_000_123)
+        self.assertEqual(result["userspace_receive_ns"], 5_000_000_333)
+        self.assertEqual(result["clock_anchor"]["uncertainty_ns"], 7)
+        self.assertIsNone(result["socket_dropped_total"])
+
+    def test_transmit_direction_comes_from_flags_not_can_id(self):
+        remote = self.parse()
+        local = self.parse(flags=socket.MSG_DONTROUTE)
+        self.assertFalse(remote["locally_generated"])
+        self.assertTrue(local["locally_generated"])
+        self.assertEqual(remote["can_id"], local["can_id"])
+        self.assertEqual(remote["data_hex"], local["data_hex"])
+
+    def test_socket_overflow_is_saved_separately_from_missing_counter(self):
+        self.assertEqual(self.parse(ancillary=ancillary(dropped=7))["socket_dropped_total"], 7)
+        self.assertIsNone(self.parse()["socket_dropped_total"])
+
+    def test_truncated_frame_ancillary_invalid_timestamp_and_missing_timestamp_rejected(self):
+        invalid = [
+            {"data": bytes(15)}, {"data": bytes(72)},
+            {"data": struct.pack("=IB3x8s", 1, 9, bytes(8))},
+            {"flags": socket.MSG_TRUNC}, {"flags": socket.MSG_CTRUNC},
+            {"ancillary": []},
+            {"ancillary": [(socket.SOL_SOCKET, capture.SO_TIMESTAMPNS, bytes(8))]},
+            {"ancillary": [(socket.SOL_SOCKET, capture.SO_TIMESTAMPNS, struct.pack("=qq", 1, 1000000000))]},
+        ]
+        for kwargs in invalid:
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                self.parse(**kwargs)
+
+    def test_receiver_only_binds_receives_and_closes_without_send(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "can.jsonl"
+            collector = capture.PassiveCapture("fake0", path)
+            fake_socket = mock.Mock()
+            def receive(*args):
+                collector.stop.set()
+                return packet(), ancillary(dropped=9), socket.MSG_DONTROUTE, ("fake0",)
+            fake_socket.recvmsg.side_effect = receive
+            with mock.patch.object(capture.socket, "socket", return_value=fake_socket), \
+                 mock.patch.object(capture, "clock_anchor", return_value=self.anchor):
+                collector.run()
+            self.assertIsNone(collector.error)
+            self.assertEqual(dict(collector.counts), {"frames": 1, "tx_echo": 1, "socket_dropped_total": 9})
+            fake_socket.bind.assert_called_once_with(("fake0",))
+            fake_socket.close.assert_called_once()
+            fake_socket.send.assert_not_called()
+            fake_socket.sendto.assert_not_called()
+            fake_socket.sendmsg.assert_not_called()
+            self.assertEqual(json.loads(path.read_text())["capture_seq"], 1)
+
+    def test_probe_rejects_mutating_commands_before_network_use(self):
+        probe = capture.ReadOnlyProbe.__new__(capture.ReadOnlyProbe)
+        probe.socket = mock.Mock()
+        for command in ("SET_EE_POSE", "RESET_TO_HOME", "SET_TO_DAMPING"):
+            with self.assertRaisesRegex(ValueError, "read-only"):
+                probe.request(command)
+        probe.socket.send_pyobj.assert_not_called()
+
+    def test_get_state_always_has_optin_and_validates_request_and_clocks(self):
+        probe = capture.ReadOnlyProbe.__new__(capture.ReadOnlyProbe)
+        probe.socket = mock.Mock()
+        def reply():
+            request = probe.socket.send_pyobj.call_args.args[0]
+            self.assertEqual(request["_robot_latency"]["version"], 1)
+            return {"cmd": "GET_STATE", "data": {"joint_pos": [0.]}, "robot_latency": {
+                "version": 1, "request_id": request["_robot_latency"]["request_id"],
+                "clock_id": "linux:test", "sdk_instance_id": "sdk1", "source_kind": "SDK_cache_update",
+                "server_received_ns": 120, "server_send_ns": 180,
+                "eef_source_ns": 90, "joint_source_ns": 91, "clock_uncertainty_ns": 2,
+                "eef_sdk_timestamp_s": .01, "joint_sdk_timestamp_s": .011,
+            }}
+        probe.socket.recv_pyobj.side_effect = reply
+        with mock.patch.object(capture.time, "monotonic_ns", side_effect=[100, 200]), \
+             mock.patch.object(robot_latency, "local_clock_id", return_value="linux:test"):
+            result = probe.request("GET_STATE")
+        self.assertEqual(result["robot_latency"]["client_return_ns"], 200)
+        self.assertEqual(result["robot_latency"]["client_send_ns"], 100)
+
+    def test_get_state_rejects_mismatching_request_identity(self):
+        probe = capture.ReadOnlyProbe.__new__(capture.ReadOnlyProbe)
+        probe.socket = mock.Mock()
+        probe.socket.recv_pyobj.return_value = {
+            "cmd": "GET_STATE", "data": {}, "robot_latency": {"request_id": "another-request"},
+        }
+        with self.assertRaisesRegex(RuntimeError, "identity mismatch"):
+            probe.request("GET_STATE")
+
+    def test_inactive_server_main_never_requests_get_state(self):
+        requested = []
+        fake_probe = mock.Mock()
+        def reply(command):
+            requested.append(command)
+            return {"data": {"protocol_version": 1, "clock_id": "linux:test", "controller_active": False}}
+        fake_probe.request.side_effect = reply
+        fake_capture = SimpleNamespace(
+            thread=mock.Mock(), ready=mock.Mock(wait=mock.Mock(return_value=True)),
+            error=None, close=mock.Mock(), counts={}, started_ns=100, stopped_ns=200, offset_range=None,
+        )
+        with tempfile.TemporaryDirectory() as directory, \
+             mock.patch.object(capture, "PassiveCapture", return_value=fake_capture), \
+             mock.patch.object(capture, "ReadOnlyProbe", return_value=fake_probe), \
+             mock.patch.object(robot_latency, "local_clock_id", return_value="linux:test"):
+            status = capture.main(["--output", directory])
+            sessions = list(Path(directory).iterdir())
+            self.assertEqual(status, 1)
+            self.assertEqual(requested, ["GET_LATENCY_INFO"])
+            self.assertFalse((sessions[0] / "sdk_states.jsonl").exists())
+            self.assertIn("inactive", json.loads((sessions[0] / "session.json").read_text())["error"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/can_audit/test_decode_feedback.py b/tools/can_audit/test_decode_feedback.py
new file mode 100644
index 0000000000000000000000000000000000000000..d1195aefc6e8ea1c569e6e4304f51f81036c9e37
--- /dev/null
+++ b/tools/can_audit/test_decode_feedback.py
@@ -0,0 +1,80 @@
+"""Synthetic saved bytes only. Does not open any CAN device or controller."""
+
+import ctypes
+import struct
+import unittest
+
+from tools.can_audit.decode_feedback import FeedbackDecoder, _MotorMessage
+
+
+def packed(first, p=32768, v=2048, current=2048):
+    return bytes((first, p >> 8, p & 255, v >> 4,
+                  ((v & 15) << 4) | (current >> 8), current & 255, 80, 0))
+
+
+def native_float_scale(raw, lo, hi, bits):
+    def f32(value):
+        return struct.unpack("<f", struct.pack("<f", value))[0]
+    return f32(lo + f32(f32(raw * f32(hi - lo)) / ((1 << bits) - 1)))
+
+
+class OfflineDecoderTests(unittest.TestCase):
+    def setUp(self):
+        self.decoder = FeedbackDecoder()
+
+    def test_abi_and_extreme_ranges(self):
+        self.assertEqual(ctypes.sizeof(_MotorMessage), 48)
+        self.assertEqual(_MotorMessage.motor_id.offset, 12)
+        for can_id, first, velocity_limit, current_limit in ((1, 0x20, 18., 30.), (0, 5, 45., 18.)):
+            low = self.decoder.decode(can_id, packed(first, 0, 0, 0))
+            high = self.decoder.decode(can_id, packed(first, 65535, 4095, 4095))
+            self.assertEqual((low["position_rad"], high["position_rad"]), (-12.5, 12.5))
+            self.assertEqual((low["velocity_rad_s"], high["velocity_rad_s"]), (-velocity_limit, velocity_limit))
+            self.assertEqual((low["current_raw"], high["current_raw"]), (-current_limit, current_limit))
+
+    def test_exact_float32_values_match_integer_field_quantization(self):
+        for can_id, first, vmax, imax in ((4, 0x23, 18., 30.), (0, 7, 45., 18.)):
+            for p, v, current in ((32768, 2048, 2048), (18653, 23, 4040), (1, 4094, 3)):
+                result = self.decoder.decode(can_id, packed(first, p, v, current))
+                self.assertEqual(result["position_rad"], native_float_scale(p, -12.5, 12.5, 16))
+                self.assertEqual(result["velocity_rad_s"], native_float_scale(v, -vmax, vmax, 12))
+                self.assertEqual(result["current_raw"], native_float_scale(current, -imax, imax, 12))
+                self.assertTrue(result["position_updated"])
+        self.assertEqual(self.decoder.decode(1, packed(0x23))["error"], 3)
+
+    def test_auxiliary_ec_reply_does_not_refresh_used_position(self):
+        first = self.decoder.decode(2, packed(0x20, 24000))
+        auxiliary = bytes((0x40,)) + struct.pack(">f", 3.25) + struct.pack(">h", -100) + bytes((80,))
+        result = self.decoder.decode(2, auxiliary)
+        self.assertEqual(result["position_rad"], first["position_rad"])
+        self.assertEqual(result["aux_angle_float"], 3.25)
+        self.assertEqual(result["current_raw"], -1.)
+        self.assertFalse(result["position_updated"])
+        self.assertNotIn("position_rad", result["updated_fields"])
+        self.assertIn("decode_skipped", self.decoder.decode(2, b"\xa0\x01"))
+
+    def test_per_motor_private_caches_do_not_change_other_motor_readings(self):
+        self.decoder.decode(1, packed(0x20, 20000))
+        self.decoder.decode(4, packed(0x20, 40000))
+        second = FeedbackDecoder()
+        # An auxiliary reply leaves position uninitialized in a new private cache.
+        auxiliary = bytes((0x40,)) + struct.pack(">f", 3.) + bytes((0, 0, 80))
+        self.assertEqual(second.decode(1, auxiliary)["position_rad"], 0.)
+        self.assertNotEqual(self.decoder.decode(1, auxiliary)["position_rad"], 0.)
+
+    def test_local_transmit_unknown_motor_and_flagged_frames_are_not_feedback(self):
+        self.assertIsNone(self.decoder.decode(1, packed(0x20), locally_generated=True))
+        self.assertIsNone(self.decoder.decode(5, packed(0x20)))
+        self.assertIsNone(self.decoder.decode(0, packed(15)))
+        self.assertIsNone(self.decoder.decode(0x80000001, packed(0x20)))
+        self.assertEqual(self.decoder.decode(0, packed(8))["motor_id"], 8)
+
+    def test_truncated_or_invalid_input_rejected_before_native_access(self):
+        for can_id, data in ((1, b""), (1, b"\x20"), (1, b"\x40" * 7),
+                             (0, b"\x05" * 5), (1, bytes(9)), (-1, bytes(8))):
+            with self.subTest(can_id=can_id, data=data), self.assertRaises(ValueError):
+                self.decoder.decode(can_id, data)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/robot_latency/zmq_server.py b/tools/robot_latency/zmq_server.py
new file mode 100644
index 0000000000000000000000000000000000000000..fee7750fbac1acf1d0ba20772a890e4a20d8f0b3
--- /dev/null
+++ b/tools/robot_latency/zmq_server.py
@@ -0,0 +1,330 @@
+'''
+sudo slcand -o -f -s8 /dev/arxcan0 can0 && sudo ifconfig can0 up
+
+conda activate arx-py310
+python python/communication/zmq_server.py X5 can0
+'''
+import sys
+import os
+import numpy as np
+
+ROOT_DIR = os.path.dirname(os.path.dirname(__file__))
+sys.path.append(ROOT_DIR)
+os.chdir(ROOT_DIR)
+import time
+from typing import Any, cast
+
+import arx5_interface as arx5
+import zmq
+import click
+import sys
+import traceback
+import importlib.util
+
+# The standalone helper is installed beside this file; launch arguments stay unchanged.
+_LATENCY_HELPER_PATH = os.environ.get(
+    "ARX_ROBOT_LATENCY_HELPER",
+    os.path.join(os.path.dirname(os.path.abspath(__file__)), "robot_latency_server.py"),
+)
+_latency_spec = importlib.util.spec_from_file_location("arx_robot_latency_server", _LATENCY_HELPER_PATH)
+if _latency_spec is None or _latency_spec.loader is None:
+    raise ImportError(f"Cannot load robot latency helper: {_LATENCY_HELPER_PATH}")
+_latency_module = importlib.util.module_from_spec(_latency_spec)
+_latency_spec.loader.exec_module(_latency_module)
+RobotLatencyServer = _latency_module.RobotLatencyServer
+
+
+def echo_exception():
+    exc_type, exc_value, exc_traceback = sys.exc_info()
+    # Extract unformatted traceback
+    tb_lines = traceback.format_exception(exc_type, exc_value, exc_traceback)
+    # Print line of code where the exception occurred
+
+    return "".join(tb_lines)
+
+
+class Arx5Server:
+    def __init__(
+        self,
+        zmq_ip: str,
+        zmq_port: int,
+        model: str,
+        interface: str,
+        no_cmd_timeout: float = 60.0,
+    ):
+        self.robot_latency = RobotLatencyServer()
+        self.model = model
+        self.interface = interface
+        self.arx5_cartesian_controller = self._create_controller()
+        print(f"Arx5Server is initialized with {model} on {interface}")
+        self.context = zmq.Context()
+        self.socket = self.context.socket(zmq.REP)
+        self.socket.bind(f"tcp://{zmq_ip}:{zmq_port}")
+        self.poller = zmq.Poller()
+        self.poller.register(self.socket, zmq.POLLIN)
+
+        self.zmq_ip = zmq_ip
+        self.zmq_port = zmq_port
+        self.last_cmd_time = time.monotonic()
+        self.no_cmd_timeout = no_cmd_timeout
+        self.is_reset_to_home = False
+        self.last_eef_cmd: npt.NDArray[np.float64] | None = None
+
+    def _create_controller(self) -> arx5.Arx5CartesianController:
+        robot_config = arx5.RobotConfigFactory.get_instance().get_config(self.model)
+        # From calibrate_gripper(): fully-open motor readout (this arm is not reversed)
+        robot_config.gripper_open_readout = 5.15507
+        # Default 1.5Nm trips easily when opening against end-stop with imperfect calibration
+        robot_config.gripper_torque_max = 2.5
+        controller_config = arx5.ControllerConfigFactory.get_instance().get_config(
+            "cartesian_controller", robot_config.joint_dof
+        )
+        # Softer gripper so home-open is less likely to hard-stall
+        controller_config.default_gripper_kp = 2.0
+        controller = arx5.Arx5CartesianController(
+            robot_config, controller_config, self.interface
+        )
+        self.robot_latency.new_sdk_instance()
+        return controller
+
+    def run(self):
+        print(f"Arx5ZmqServer is running on {self.zmq_ip}:{self.zmq_port}")
+        while True:
+            try:
+                socks = dict(self.poller.poll(int(self.no_cmd_timeout * 1000)))
+                if self.socket in socks and socks[self.socket] == zmq.POLLIN:
+                    msg: dict[str, Any] = self.socket.recv_pyobj()
+                    server_received_ns = time.monotonic_ns()
+                    # A protocol capability query must never recreate hardware.
+                    latency_info_only = isinstance(msg, dict) and msg.get("cmd") == "GET_LATENCY_INFO"
+                    latency_state_only = (
+                        isinstance(msg, dict) and msg.get("cmd") == "GET_STATE"
+                        and "_robot_latency" in msg
+                    )
+                    if self.arx5_cartesian_controller is None and latency_state_only:
+                        self.socket.send_pyobj({
+                            "cmd": "GET_STATE",
+                            "data": "ERROR: Robot controller is inactive; read-only latency queries do not initialize hardware",
+                        })
+                        continue
+                    if self.arx5_cartesian_controller is None and not latency_info_only:
+                        print(f"Reestablishing high level controller")
+                        self.arx5_cartesian_controller = self._create_controller()
+                else:
+
+                    if self.arx5_cartesian_controller is not None:
+                        print(
+                            f"Timeout: No command received for {self.no_cmd_timeout} sec. ARX5 arm is reset to home position."
+                        )
+                        self.arx5_cartesian_controller.reset_to_home()
+                        self.arx5_cartesian_controller.set_to_damping()
+                        self.last_eef_cmd = None
+                        del self.arx5_cartesian_controller
+                        self.arx5_cartesian_controller = None
+                    continue
+            except KeyboardInterrupt:
+                break
+            except Exception as e:
+                exception_str = echo_exception()
+                print(f"Error: {exception_str}")
+                continue
+            try:
+                if not isinstance(msg, dict):
+                    print(f"Error: Received invalid Message {msg}, ignored")
+                    self.socket.send_pyobj(
+                        {
+                            "cmd": "UNKNOWN",
+                            "data": f"ERROR: Received invalid Message {msg}",
+                        }
+                    )
+                    continue
+                if msg["cmd"] == "GET_LATENCY_INFO":
+                    latency_info = self.robot_latency.info()
+                    latency_info["controller_active"] = self.arx5_cartesian_controller is not None
+                    self.socket.send_pyobj({
+                        "cmd": "GET_LATENCY_INFO",
+                        "data": latency_info,
+                    })
+                elif msg["cmd"] == "GET_STATE":
+                    # print(f"Received GET_STATE message")
+                    eef_pose_cmd = self.arx5_cartesian_controller.get_eef_cmd()
+                    eef_state = self.arx5_cartesian_controller.get_eef_state()
+
+                    if "_robot_latency" not in msg:
+                        print(f"{eef_pose_cmd}")
+                        print(f"{eef_state.pose_6d()}")
+                    low_state = self.arx5_cartesian_controller.get_joint_state()
+                    reply_msg = {
+                        "cmd": "GET_STATE",
+                        "data": {
+                            "timestamp": eef_state.timestamp,
+                            "ee_pose": eef_state.pose_6d().copy(),
+                            "joint_pos": low_state.pos().copy(),
+                            "joint_vel": low_state.vel().copy(),
+                            "joint_torque": low_state.torque().copy(),
+                            "gripper_pos": low_state.gripper_pos,
+                            "gripper_vel": low_state.gripper_vel,
+                            "gripper_torque": low_state.gripper_torque,
+                        },
+                    }
+                    self.robot_latency.decorate_reply(
+                        msg, reply_msg, self.arx5_cartesian_controller, server_received_ns,
+                        eef_state=eef_state, joint_state=low_state,
+                    )
+                    self.socket.send_pyobj(reply_msg)
+                elif msg["cmd"] == "SET_EE_POSE":
+                    if self.last_eef_cmd is None:
+                        error_str = "Error: Cannot set EE pose before RESET_TO_HOME. Please check the input."
+                        print(error_str)
+                        self.socket.send_pyobj(
+                            {
+                                "cmd": "SET_EE_POSE",
+                                "data": error_str,
+                            }
+                        )
+                        continue
+                    # print(f"Received SET_EE_POSE message, data: {msg['data']}")
+                    target_ee_pose = cast(np.ndarray, msg["data"]["ee_pose"])
+
+                    if np.linalg.norm(target_ee_pose - self.last_eef_cmd) > 0.1:
+                        error_str = f"Error: Cannot set EE pose {target_ee_pose} far away from last command: {self.last_eef_cmd}. Please check the input."
+                        print(error_str)
+                        self.socket.send_pyobj(
+                            {
+                                "cmd": "SET_EE_POSE",
+                                "data": error_str,
+                            }
+                        )
+                        continue
+                    self.last_eef_cmd = target_ee_pose.copy()
+                    
+                    if msg["data"]["gripper_pos"] is not None:
+                        target_gripper_pos = cast(float, msg["data"]["gripper_pos"])
+                    else:
+                        # Maintain the current gripper position
+                        target_gripper_pos = (
+                            self.arx5_cartesian_controller.get_eef_state().gripper_pos
+                        )
+                    if self.is_reset_to_home:
+                        if (
+                            np.linalg.norm(
+                                target_ee_pose
+                                - self.arx5_cartesian_controller.get_home_pose()
+                            )
+                            > 0.1
+                        ):
+                            error_str = f"Error: Cannot set EE pose far away from home: {target_ee_pose} after RESET_TO_HOME. Please check the input."
+                            print(error_str)
+                            self.socket.send_pyobj(
+                                {
+                                    "cmd": "SET_EE_POSE",
+                                    "data": error_str,
+                                }
+                            )
+                            continue
+
+                    self.arx5_cartesian_controller.set_eef_cmd(
+                        arx5.EEFState(target_ee_pose, target_gripper_pos)
+                    )
+                    eef_state = self.arx5_cartesian_controller.get_eef_state()
+                    low_state = self.arx5_cartesian_controller.get_joint_state()
+                    reply_msg = {
+                        "cmd": "SET_EE_POSE",
+                        "data": {
+                            "timestamp": eef_state.timestamp,
+                            "ee_pose": eef_state.pose_6d().copy(),
+                            "joint_pos": low_state.pos().copy(),
+                            "joint_vel": low_state.vel().copy(),
+                            "joint_torque": low_state.torque().copy(),
+                            "gripper_pos": low_state.gripper_pos,
+                            "gripper_vel": low_state.gripper_vel,
+                            "gripper_torque": low_state.gripper_torque,
+                        },
+                    }
+                    self.robot_latency.decorate_reply(
+                        msg, reply_msg, self.arx5_cartesian_controller, server_received_ns,
+                        eef_state=eef_state, joint_state=low_state,
+                    )
+                    self.socket.send_pyobj(reply_msg)
+                    self.is_reset_to_home = False
+                elif msg["cmd"] == "RESET_TO_HOME":
+                    print(f"Received RESET_TO_HOME message")
+                    self.arx5_cartesian_controller.reset_to_home()
+                    reply_msg = {
+                        "cmd": "RESET_TO_HOME",
+                        "data": "OK",
+                    }
+                    self.last_eef_cmd = self.arx5_cartesian_controller.get_eef_cmd().pose_6d().copy()
+                    self.socket.send_pyobj(reply_msg)
+                    self.is_reset_to_home = True
+                elif msg["cmd"] == "SET_TO_DAMPING":
+                    print(f"Received SET_TO_DAMPING message")
+                    self.arx5_cartesian_controller.set_to_damping()
+                    reply_msg = {
+                        "cmd": "SET_TO_DAMPING",
+                        "data": "OK",
+                    }
+                    self.socket.send_pyobj(reply_msg)
+                    self.is_reset_to_home = False
+                elif msg["cmd"] == "GET_GAIN":
+                    print(f"Received GET_GAIN message")
+                    gain = self.arx5_cartesian_controller.get_gain()
+                    reply_msg = {
+                        "cmd": "GET_GAIN",
+                        "data": {
+                            "kp": gain.kp().copy(),
+                            "kd": gain.kd().copy(),
+                            "gripper_kp": gain.gripper_kp,
+                            "gripper_kd": gain.gripper_kd,
+                        },
+                    }
+                    self.socket.send_pyobj(reply_msg)
+                elif msg["cmd"] == "SET_GAIN":
+                    print(f"Received SET_GAIN message, data: {msg['data']}")
+                    assert isinstance(msg["data"], dict)
+
+                    kp = cast(np.ndarray, msg["data"]["kp"])
+                    kd = cast(np.ndarray, msg["data"]["kd"])
+                    gripper_kp = cast(float, msg["data"]["gripper_kp"])
+                    gripper_kd = cast(float, msg["data"]["gripper_kd"])
+                    self.arx5_cartesian_controller.set_gain(
+                        arx5.Gain(kp, kd, gripper_kp, gripper_kd)
+                    )
+                    reply_msg = {
+                        "cmd": "SET_GAIN",
+                        "data": "OK",
+                    }
+                    self.socket.send_pyobj(reply_msg)
+                else:
+                    raise ValueError(f"Unknown message type: {msg['cmd']}")
+            except KeyboardInterrupt:
+                break
+            except Exception as e:
+                exception_str = echo_exception()
+                self.socket.send_pyobj(
+                    {"cmd": msg["cmd"], "data": f"ERROR: {exception_str}"}
+                )
+                print(f"Error: {exception_str}")
+                continue
+
+    def __del__(self):
+        self.socket.close()
+        self.context.term()
+        print("Arx5ZmqServer is terminated")
+
+
+@click.command()
+@click.argument("model")  # ARX arm model: X5 or L5
+@click.argument("interface")  # can bus name (can0 etc.)
+def main(model: str, interface: str):
+    server = Arx5Server(
+        model=model,
+        interface=interface,
+        zmq_ip="0.0.0.0",
+        zmq_port=8765,
+    )
+    server.run()
+
+
+if __name__ == "__main__":
+    main()
