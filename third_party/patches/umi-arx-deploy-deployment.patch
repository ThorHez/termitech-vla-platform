index 0000000000000000000000000000000000000000..484fcf23811d61a83dbd43d49faa03e6f3afe6a6
--- /dev/null
+++ b/tests/test_robot_latency_client.py
@@ -0,0 +1,218 @@
+"""No hardware or listening sockets: exercise the opt-in wire contract."""
+
+from pathlib import Path
+import sys
+import unittest
+from unittest import mock
+
+import numpy as np
+import zmq
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from modules import arx5_zmq_client as client_module
+from utils import robot_latency
+
+
+class RobotLatencyClientTests(unittest.TestCase):
+    def setUp(self):
+        self.socket = mock.Mock()
+        self.context = mock.Mock()
+        self.context.socket.return_value = self.socket
+        self.metadata = dict(protocol_version=1, clock_id="linux:test", sdk_instance_id="sdk-1",
+                             source_kind="SDK_cache_update", controller_active=True)
+        self.reply_override = None
+        self.probe_override = {}
+        self.states = []
+        self.requests = []
+        self.measured_requests = 0
+        self.socket.send_pyobj.side_effect = self.requests.append
+        self.socket.recv_pyobj.side_effect = self.reply
+        for patch in (
+            mock.patch.object(client_module.zmq, "Context", return_value=self.context),
+            mock.patch.object(robot_latency, "local_clock_id", return_value="linux:test"),
+            mock.patch.object(client_module.time, "monotonic_ns", side_effect=range(100, 3000, 100)),
+        ):
+            patch.start()
+            self.addCleanup(patch.stop)
+        self.client = None
+
+    def tearDown(self):
+        if self.client is not None:
+            self.client.close()
+
+    def reply(self):
+        request = self.requests[-1]
+        if request["cmd"] == "GET_LATENCY_INFO":
+            return {"cmd": "GET_LATENCY_INFO", "data": self.metadata}
+        if self.reply_override is not None:
+            return self.reply_override
+        state = {"timestamp": 1.0, "ee_pose": np.zeros(6), "joint_pos": np.zeros(6)}
+        self.states.append(state)
+        response = {"cmd": request["cmd"], "data": state}
+        if "_robot_latency" in request:
+            offset = 200 * self.measured_requests
+            self.measured_requests += 1
+            response["robot_latency"] = dict(
+                version=1, request_id=request["_robot_latency"]["request_id"], clock_id="linux:test",
+                sdk_instance_id="sdk-1", source_kind="SDK_cache_update",
+                server_received_ns=offset + 120, server_send_ns=offset + 180,
+                eef_source_ns=offset + 110, joint_source_ns=offset + 115,
+                clock_uncertainty_ns=2, eef_sdk_timestamp_s=offset + .1,
+                joint_sdk_timestamp_s=offset + .15,
+            )
+            response["robot_latency"].update(self.probe_override)
+        return response
+
+    def make_client(self, **kwargs):
+        self.client = client_module.Arx5Client("127.0.0.1", 8765, **kwargs)
+        return self.client
+
+    def test_disabled_preserves_messages_and_never_reads_timing_clock(self):
+        with mock.patch.object(client_module.time, "monotonic_ns", side_effect=AssertionError("disabled")):
+            client = self.make_client()
+            target = np.zeros(6)
+            state = client.set_ee_pose(target, .01)
+        self.assertEqual([r["cmd"] for r in self.requests], ["GET_STATE", "SET_EE_POSE"])
+        self.assertEqual(self.requests[0], {"cmd": "GET_STATE", "data": None})
+        self.assertIs(self.requests[1]["data"]["ee_pose"], target)
+        self.assertNotIn("_robot_latency", self.requests[1])
+        self.assertIs(state, self.states[-1])
+        self.assertIsNone(client.latest_state_latency)
+        self.socket.setsockopt.assert_not_called()
+
+    def test_preflight_before_state_and_brackets_same_reply(self):
+        client = self.make_client(enable_latency=True)
+        self.assertEqual([r["cmd"] for r in self.requests], ["GET_LATENCY_INFO", "GET_STATE"])
+        timing = client.latest_state_latency
+        self.assertEqual((timing["client_send_ns"], timing["client_return_ns"]), (100, 200))
+        self.assertEqual(timing["request_id"], self.requests[-1]["_robot_latency"]["request_id"])
+        self.assertEqual(timing["command"], "GET_STATE")
+        self.assertIs(client.latest_state, self.states[-1])
+        self.socket.setsockopt.assert_any_call(zmq.RCVTIMEO, 5000)
+        state = client.set_ee_pose(np.zeros(6))
+        self.assertIs(state, client.latest_state)
+        self.assertEqual(client.latest_state_latency["command"], "SET_EE_POSE")
+        self.assertEqual(client.latest_state_latency["client_return_ns"], 400)
+
+    def test_unsupported_metadata_fails_without_state_or_motion(self):
+        self.metadata = "unknown command"
+        with self.assertRaisesRegex(RuntimeError, "update and restart"):
+            self.make_client(enable_latency=True)
+        self.assertEqual([r["cmd"] for r in self.requests], ["GET_LATENCY_INFO"])
+        self.socket.close.assert_called_once_with(linger=0)
+        self.context.term.assert_called_once()
+
+    def test_different_host_clock_rejected_before_get_state(self):
+        self.metadata["clock_id"] = "linux:another-host"
+        with self.assertRaisesRegex(RuntimeError, "same Linux boot clock"):
+            self.make_client(enable_latency=True)
+        self.assertEqual(len(self.requests), 1)
+
+    def test_inactive_controller_rejected_without_querying_state(self):
+        self.metadata["controller_active"] = False
+        with self.assertRaisesRegex(RuntimeError, "inactive"):
+            self.make_client(enable_latency=True)
+        self.assertEqual([r["cmd"] for r in self.requests], ["GET_LATENCY_INFO"])
+
+    def test_invalid_first_reply_fails_preflight(self):
+        self.probe_override = {"request_id": "wrong"}
+        with self.assertRaisesRegex(RuntimeError, "preflight failed"):
+            self.make_client(enable_latency=True)
+
+    def test_bad_runtime_diagnostics_preserve_state_and_clear_old_timing(self):
+        client = self.make_client(enable_latency=True)
+        for override in ({"request_id": "other"}, {"clock_id": "linux:other"},
+                         {"eef_source_ns": 99999}, {"server_received_ns": True},
+                         {"server_send_ns": 0}, {"eef_sdk_timestamp_s": float("nan")}):
+            with self.subTest(override=override):
+                self.probe_override = override
+                state = client.set_ee_pose(np.zeros(6))
+                self.assertIs(state, self.states[-1])
+                self.assertIsNone(client.latest_state_latency)
+                self.assertTrue(client.latest_latency_error)
+
+    def test_missing_diagnostics_never_inherit_previous_age(self):
+        client = self.make_client(enable_latency=True)
+        state = {"timestamp": 9.0}
+        self.reply_override = {"cmd": "SET_EE_POSE", "data": state}
+        self.assertIs(client.set_ee_pose(np.zeros(6)), state)
+        self.assertIsNone(client.latest_state_latency)
+        self.assertIn("missing robot_latency", client.latest_latency_error)
+
+    def test_sdk_generation_change_is_retained_for_report_grouping(self):
+        client = self.make_client(enable_latency=True)
+        self.probe_override = {"sdk_instance_id": "sdk-2"}
+        client.get_state()
+        self.assertEqual(client.latest_state_latency["sdk_instance_id"], "sdk-2")
+
+    def test_failed_state_reply_clears_timing(self):
+        client = self.make_client(enable_latency=True)
+        self.reply_override = {"cmd": "SET_EE_POSE", "data": "server error"}
+        with self.assertRaisesRegex(ValueError, "server error"):
+            client.set_ee_pose(np.zeros(6))
+        self.assertIsNone(client.latest_state_latency)
+
+    def test_timeout_reconnects_with_timeout_and_clears_timing(self):
+        client = self.make_client(enable_latency=True, request_timeout_s=.5)
+        self.socket.recv_pyobj.side_effect = zmq.Again()
+        with self.assertRaisesRegex(RuntimeError, "timed out"):
+            client.get_state()
+        self.assertIsNone(client.latest_state_latency)
+        self.assertEqual(self.context.socket.call_count, 2)
+        self.assertEqual(self.socket.setsockopt.call_args_list.count(mock.call(zmq.RCVTIMEO, 500)), 2)
+
+    def test_close_is_idempotent_and_never_sends_a_command(self):
+        client = self.make_client(enable_latency=True)
+        count = len(self.requests)
+        client.close()
+        client.close()
+        self.assertEqual(len(self.requests), count)
+        self.socket.close.assert_called_once_with(linger=0)
+
+    def test_restore_unbounded_transport_after_finite_preflight(self):
+        client = self.make_client(enable_latency=True)
+        self.socket.setsockopt.assert_any_call(zmq.RCVTIMEO, 5000)
+        count = len(self.requests)
+        client.set_request_timeout(None)
+        self.assertIsNone(client.request_timeout_s)
+        self.socket.setsockopt.assert_any_call(zmq.RCVTIMEO, -1)
+        self.socket.setsockopt.assert_any_call(zmq.SNDTIMEO, -1)
+        self.assertEqual(len(self.requests), count)
+        self.assertEqual(self.context.socket.call_count, 1)
+        self.assertTrue(client.enable_latency)
+        client.set_ee_pose(np.zeros(6))
+        self.assertEqual(client.latest_state_latency["command"], "SET_EE_POSE")
+        # A reconnect inherits the selected unbounded mode, not the preflight
+        # default; a newly created ZMQ socket has both deadlines disabled.
+        self.socket.setsockopt.reset_mock()
+        client._connect_socket()
+        self.socket.setsockopt.assert_not_called()
+
+    def test_timeout_configuration_is_validated_without_requests(self):
+        client = self.make_client(enable_latency=True)
+        count = len(self.requests)
+        for value in (0, -1, float("inf"), float("nan"), True):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                client.set_request_timeout(value)
+        self.assertEqual(client.request_timeout_s, 5)
+        client.set_request_timeout(.25)
+        self.socket.setsockopt.assert_any_call(zmq.RCVTIMEO, 250)
+        self.socket.setsockopt.assert_any_call(zmq.SNDTIMEO, 250)
+        self.assertEqual(client.request_timeout_s, .25)
+        self.assertEqual(len(self.requests), count)
+        client.close()
+        with self.assertRaisesRegex(RuntimeError, "closed"):
+            client.set_request_timeout(None)
+
+    def test_unbounded_runtime_keeps_legacy_transport_failure_fallback(self):
+        client = self.make_client(enable_latency=True)
+        client.set_request_timeout(None)
+        previous = client.latest_state
+        self.socket.recv_pyobj.side_effect = zmq.ZMQError("transport interrupted")
+        self.assertIs(client.set_ee_pose(np.zeros(6)), previous)
+        self.assertIsNone(client.latest_state_latency)
+        self.assertIn("transport failed", client.latest_latency_error)
+
+
+if __name__ == "__main__":
+    unittest.main()
