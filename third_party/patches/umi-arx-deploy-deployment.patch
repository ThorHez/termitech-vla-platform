@@ -0,0 +1,96 @@
+"""Real localhost ZMQ transport with fake state/SDK; never connects to hardware."""
+
+from pathlib import Path
+import sys
+import threading
+import time
+from types import SimpleNamespace
+import unittest
+
+import numpy as np
+import zmq
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from modules.arx5_zmq_client import Arx5Client
+from utils.robot_latency import timing_row
+from utils.robot_latency_server import RobotLatencyServer
+
+
+class RobotLatencyRoundtripTests(unittest.TestCase):
+    def test_ordinary_and_traced_state_replies_match_over_zmq(self):
+        ready, stop = threading.Event(), threading.Event()
+        status = {}
+        requests = []
+        payload = {"timestamp": .5, "ee_pose": np.arange(6, dtype=float),
+                   "joint_pos": np.ones(6), "gripper_pos": .02}
+
+        def server():
+            context = zmq.Context()
+            socket = context.socket(zmq.REP)
+            socket.setsockopt(zmq.LINGER, 0)
+            socket.setsockopt(zmq.RCVTIMEO, 100)
+            try:
+                status["port"] = socket.bind_to_random_port("tcp://127.0.0.1")
+                clock_origin = time.monotonic() - .51
+                fake_sdk = SimpleNamespace(get_timestamp=lambda: time.monotonic() - clock_origin)
+                helper = RobotLatencyServer()
+                helper.new_sdk_instance()
+                ready.set()
+                while not stop.is_set():
+                    try:
+                        request = socket.recv_pyobj()
+                    except zmq.Again:
+                        continue
+                    received_ns = time.monotonic_ns()
+                    requests.append(request)
+                    if request["cmd"] == "GET_LATENCY_INFO":
+                        reply = {"cmd": request["cmd"], "data": dict(helper.info(), controller_active=True)}
+                    else:
+                        reply = {"cmd": request["cmd"], "data": payload}
+                        helper.decorate_reply(request, reply, fake_sdk, received_ns,
+                                              eef_state=SimpleNamespace(timestamp=.5),
+                                              joint_state=SimpleNamespace(timestamp=.501))
+                    socket.send_pyobj(reply)
+            except BaseException as exc:
+                status["error"] = exc
+                ready.set()
+            finally:
+                socket.close(linger=0)
+                context.term()
+
+        worker = threading.Thread(target=server, daemon=True)
+        worker.start()
+        self.assertTrue(ready.wait(timeout=3), "Fake server startup timed out")
+        if "error" in status:
+            raise status["error"]
+        old_client = new_client = None
+        try:
+            old_client = Arx5Client("127.0.0.1", status["port"], request_timeout_s=2)
+            old_state = old_client.set_ee_pose(np.zeros(6), .02)
+            new_client = Arx5Client("127.0.0.1", status["port"], enable_latency=True, request_timeout_s=2)
+            initial_timing = new_client.latest_state_latency
+            new_state = new_client.set_ee_pose(np.zeros(6), .02)
+            for key in payload:
+                np.testing.assert_array_equal(old_state[key], new_state[key])
+            row = timing_row(new_client.latest_state_latency)
+            self.assertGreater(row["eef_sdk_to_client_ms"], 0)
+            self.assertGreater(row["rpc_ms"], 0)
+            self.assertAlmostEqual(row["eef_sdk_to_client_ms"] - row["joint_sdk_to_client_ms"], 1, places=6)
+            self.assertEqual(row["command"], "SET_EE_POSE")
+            self.assertNotEqual(row["request_id"], initial_timing["request_id"])
+            self.assertEqual([r["cmd"] for r in requests],
+                             ["GET_STATE", "SET_EE_POSE", "GET_LATENCY_INFO", "GET_STATE", "SET_EE_POSE"])
+            self.assertNotIn("_robot_latency", requests[0])
+            self.assertNotIn("_robot_latency", requests[1])
+        finally:
+            for client in (old_client, new_client):
+                if client is not None:
+                    client.close()
+            stop.set()
+            worker.join(timeout=3)
+        self.assertFalse(worker.is_alive())
+        self.assertNotIn("error", status)
+
+
+if __name__ == "__main__":
+    unittest.main()
