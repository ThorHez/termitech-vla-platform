+        server.arx5_cartesian_controller = controller if controller_active else None
+        server.robot_latency = RobotLatencyServer(clock_ns=lambda: 100_000_000_000, clock_id="linux:fake")
+        server.robot_latency.new_sdk_instance()
+        return server, controller
+
+    def test_readonly_info_never_recreates_an_inactive_controller(self):
