+# %%
+import sys
+import os
+from queue import Queue
+
+from openpi_client.websocket_client_policy import WebsocketClientPolicy
+
+ROOT_DIR = os.path.dirname(os.path.dirname(__file__))
+sys.path.append(ROOT_DIR)
+os.chdir(ROOT_DIR)
+
+# %%
+import os
+import pathlib
+import time
+from multiprocessing.managers import SharedMemoryManager
+
+import click
+import cv2
+import numpy as np
+import scipy.spatial.transform as st
+from omegaconf import OmegaConf
+from utils.other_util import precise_wait
+from peripherals.keystroke_counter import KeystrokeCounter, Key, KeyCode
+from utils.real_inference_util import (
+    get_real_obs_dict,
+    get_real_obs_resolution,
+    get_real_umi_obs_dict,
+    get_real_umi_action,
+)
+from peripherals.spacemouse_shared_memory import Spacemouse
+from utils.pose_util import pose_to_mat, mat_to_pose
+from modules.arx5_env import Arx5Env
+import zmq
+from scipy.spatial.transform import Rotation as R
+
+OmegaConf.register_new_resolver("eval", eval, replace=True)
+
+# DEFAULT_GRIPPER_MAX_WIDTH = 0.11475166624692577
+DEFAULT_GRIPPER_MAX_WIDTH = 0.085
+
+# ===== 夹取高度补偿默认参数（单位：米）=====
+# 针对「到位但高度/开合差一点」：先降 Z，再延迟闭合。
+# 可用命令行覆盖，例如:
+#   --grasp_z_offset 0.008 --grasp_x_pullback 0.007 --grasp_pre_close_steps 3 --delay_grip_close_steps 1
+GRASP_Z_OFFSET = 0.025       # 夹取时向下补偿 8 mm（悬空则加大，蹭桌则减小）
+GRASP_PRE_CLOSE_STEPS = 3    # 闭合前多少个轨迹点开始下降
+DELAY_GRIP_CLOSE_STEPS = 1   # 降到位后，再延迟几步才真正闭合
+MIN_SAFE_TCP_Z = 0.025       # TCP 最低安全高度，按桌面高度标定
+GRIP_CLOSE_THRESHOLD = 0.05  # 低于此开度视为「准备闭合」
+# ===== [前倾拉回X补偿] 夹取降 Z 时末端会往前趴，用负 X 把指尖拉回来 =====
+# 对应原版: action_np[:, 0] += float(-0.007)  （+X 朝前，减 X = 往回拉）
+GRASP_X_PULLBACK = 0.009     # 夹取时沿 -X 回拉 7 mm；夹空就加大，夹到元件后面就减小；0 关闭
+
+
+def solve_table_collision(ee_pose, gripper_width, height_threshold):
+    finger_thickness = 25.5 / 1000
+    keypoints = list()
+    for dx in [-1, 1]:
+        for dy in [-1, 1]:
+            keypoints.append((dx * gripper_width / 2, dy * finger_thickness / 2, 0))
+    keypoints = np.asarray(keypoints)
+    rot_mat = st.Rotation.from_rotvec(ee_pose[3:6]).as_matrix()
+    transformed_keypoints = (
+        np.transpose(rot_mat @ np.transpose(keypoints)) + ee_pose[:3]
+    )
+    delta = max(height_threshold - np.min(transformed_keypoints[:, 2]), 0)
+    ee_pose[2] += delta
+    # ee_pose[0] += delta*8
+    ee_pose[0] += delta
+
+
+def apply_grasp_z_offset(
+    action_np,
+    n_robots,
+    z_offset=GRASP_Z_OFFSET,
+    x_pullback=GRASP_X_PULLBACK,
+    pre_close_steps=GRASP_PRE_CLOSE_STEPS,
+    delay_grip_close_steps=DELAY_GRIP_CLOSE_STEPS,
+    min_safe_tcp_z=MIN_SAFE_TCP_Z,
+    close_threshold=GRIP_CLOSE_THRESHOLD,
+    open_width=DEFAULT_GRIPPER_MAX_WIDTH,
+):
+    """夹取补偿：闭合前先降 Z；可选沿 -X 拉回，抵消前倾；可选延迟闭合。"""
+    if z_offset <= 0.0 and x_pullback <= 0.0 and delay_grip_close_steps <= 0:
+        return action_np
+
+    for robot_idx in range(n_robots):
+        x_idx = robot_idx * 7 + 0
+        z_idx = robot_idx * 7 + 2
+        grip_idx = robot_idx * 7 + 6
+
+        wants_close = action_np[:, grip_idx] < close_threshold
+        close_indices = np.flatnonzero(wants_close)
+        if close_indices.size == 0:
+            continue
+
+        grasp_mask = wants_close.copy()
+        for close_idx in close_indices:
+            start_idx = max(0, int(close_idx) - int(pre_close_steps))
+            grasp_mask[start_idx : int(close_idx) + 1] = True
+
+        if z_offset > 0.0:
+            z_before = action_np[grasp_mask, z_idx].copy()
+            z_target = z_before - float(z_offset)
+            z_after = np.maximum(z_target, float(min_safe_tcp_z))
+            clipped = int(np.sum(z_target < float(min_safe_tcp_z)))
+            action_np[grasp_mask, z_idx] = z_after
+            print(
+                f"Robot {robot_idx} grasp Z compensation: "
+                f"{z_before.min():.4f}~{z_before.max():.4f} -> "
+                f"{z_after.min():.4f}~{z_after.max():.4f}, "
+                f"steps={int(grasp_mask.sum())}, offset={z_offset:.4f}, "
+                f"safe_z={min_safe_tcp_z:.4f}, clipped={clipped}/{int(grasp_mask.sum())}"
+            )
+
+        # ===== [前倾拉回X补偿] 开始 =====
+        # 等价于原版 action_np[:, 0] += float(-0.007)，但只作用在「即将夹取」的轨迹点上。
+        # +X 朝前，所以减去 x_pullback = 往机器人底座方向拉回，抵消降 Z 时手腕前倾甩出的指尖。
+        if x_pullback > 0.0:
+            x_before = action_np[grasp_mask, x_idx].copy()
+            action_np[grasp_mask, x_idx] = x_before - float(x_pullback)
+            print(
+                f"Robot {robot_idx} grasp X pullback: "
+                f"{x_before.min():.4f}~{x_before.max():.4f} -> "
+                f"{(x_before - float(x_pullback)).min():.4f}~"
+                f"{(x_before - float(x_pullback)).max():.4f}, "
+                f"steps={int(grasp_mask.sum())}, pullback={x_pullback:.4f}"
+            )
+        # ===== [前倾拉回X补偿] 结束 =====
+
+        delay_n = int(max(0, delay_grip_close_steps))
+        if delay_n > 0:
+            segment_starts = [int(close_indices[0])]
+            for i in range(1, len(close_indices)):
+                if int(close_indices[i]) != int(close_indices[i - 1]) + 1:
+                    segment_starts.append(int(close_indices[i]))
+            for seg_start in segment_starts:
+                hold_end = min(len(action_np), seg_start + delay_n)
+                action_np[seg_start:hold_end, grip_idx] = float(open_width)
+
+    return action_np
+
+
+def clamp_action_rotation(action_np, n_robots, current_poses, max_rot_step):
+    """限制每一步动作相对上一步（第一步相对当前实际姿态）的旋转变化量。
+
+    max_rot_step: 单步最大旋转角（弧度），<=0 时关闭。
+    防止 policy 输出异常大旋转时机械臂一次性大幅扭转。
+    """
+    if max_rot_step <= 0.0:
+        return action_np
+
+    for robot_idx in range(n_robots):
+        base = robot_idx * 7
+        prev_rot = R.from_rotvec(np.asarray(current_poses[robot_idx][3:6], dtype=np.float64))
+        clamped = 0
+        for i in range(len(action_np)):
+            target_rot = R.from_rotvec(action_np[i, base + 3 : base + 6])
+            delta_rotvec = (prev_rot.inv() * target_rot).as_rotvec()
+            angle = float(np.linalg.norm(delta_rotvec))
+            if angle > max_rot_step:
+                # 只缩小旋转步幅，方向保持不变
+                delta_rotvec = delta_rotvec * (max_rot_step / angle)
+                target_rot = prev_rot * R.from_rotvec(delta_rotvec)
+                action_np[i, base + 3 : base + 6] = target_rot.as_rotvec()
+                clamped += 1
+            prev_rot = target_rot
+        if clamped > 0:
+            print(
+                f"[rot_limit] robot{robot_idx}: clamped {clamped}/{len(action_np)} steps "
+                f"(max_rot_step={max_rot_step:.3f} rad/step)"
+            )
+
+    return action_np
+
+
+def clamp_base_distance(action_np, n_robots, min_base_dist, tcp_flange_offset=0.145):
+    """限制「法兰」到底座原点的最小 XY 距离，防止末端退回底座导致大幅扭转。
+
+    min_base_dist: 法兰最小水平距离（米），<=0 时关闭。
+    tcp_flange_offset: TCP 相对法兰的前伸距离（米），X5=0.145，X5_umi=0.225。
+    action 里的位置是 TCP，法兰位置 = TCP位置 - offset * TCP姿态Z轴（即夹爪指向）。
+    法兰太近时沿径向把法兰推到安全半径上，TCP 目标随之平移，姿态不变。
+    """
+    if min_base_dist <= 0.0:
+        return action_np
+
+    for robot_idx in range(n_robots):
+        base = robot_idx * 7
+        tcp_xy = action_np[:, base : base + 2]
+
+        # TCP 姿态的 Z 轴（世界系）就是 link6/法兰的前伸方向
+        rot_mats = R.from_rotvec(action_np[:, base + 3 : base + 6]).as_matrix()
+        forward_xy = rot_mats[:, :2, 2]  # Z 轴的 XY 分量
+        flange_xy = tcp_xy - float(tcp_flange_offset) * forward_xy
+
+        dist = np.linalg.norm(flange_xy, axis=1)
+        too_close = dist < float(min_base_dist)
+        if not np.any(too_close):
+            continue
+
+        # 距离原点过近且方向不可靠时，默认沿 +X 推出去
+        direction = flange_xy[too_close] / np.maximum(dist[too_close, None], 1e-6)
+        zero_dir = dist[too_close] < 1e-6
+        if np.any(zero_dir):
+            direction[zero_dir] = np.array([1.0, 0.0])
+
+        flange_xy_new = direction * float(min_base_dist)
+        # 法兰外推多少，TCP 同步平移多少（姿态不变）
+        action_np[too_close, base : base + 2] += flange_xy_new - flange_xy[too_close]
+
+        print(
+            f"[base_limit] robot{robot_idx}: pushed out {int(np.sum(too_close))}/{len(action_np)} steps "
+            f"(flange dist {dist[too_close].min():.3f} -> {min_base_dist:.3f} m, "
+            f"tcp_flange_offset={tcp_flange_offset:.3f})"
+        )
+
+    return action_np
