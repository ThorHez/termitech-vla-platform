diff --git a/setup_arxcan1.sh b/setup_arxcan1.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f76d1c73853e89846c2b70d586db3f53e5963662
--- /dev/null
+++ b/setup_arxcan1.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# Setup arxcan1 / can1 for arm2 USB2CAN (serial 0021002B5330530320323656)
+set -euo pipefail
+
+RULES=/etc/udev/rules.d/arx_can.rules
+SERIAL0=004B00295330530320323656
+SERIAL1=0021002B5330530320323656
+
+sudo tee "$RULES" >/dev/null <<EOF
+SUBSYSTEM=="tty", ATTRS{idVendor}=="16d0", ATTRS{idProduct}=="117e", ATTRS{serial}=="${SERIAL0}", SYMLINK+="arxcan0"
+SUBSYSTEM=="tty", ATTRS{idVendor}=="16d0", ATTRS{idProduct}=="117e", ATTRS{serial}=="${SERIAL1}", SYMLINK+="arxcan1"
+EOF
+
+sudo udevadm control --reload-rules
+sudo udevadm trigger
+sleep 1
+
+echo "=== /dev/arxcan* ==="
+ls -l /dev/arxcan* || true
+
+if [ ! -e /dev/arxcan1 ]; then
+  echo "ERROR: /dev/arxcan1 missing. Unplug/replug arm2 CAN, then re-run."
+  exit 1
+fi
+
+if ! ip link show can1 >/dev/null 2>&1; then
+  if ! pgrep -af 'slcand.*arxcan1' >/dev/null; then
+    sudo slcand -o -f -s8 /dev/arxcan1 can1
+  fi
+fi
+sudo ip link set can1 up
+
+echo "=== CAN interfaces ==="
+ip link show type can
+echo "Done. Use: python python/communication/zmq_server.py X5 can1"
