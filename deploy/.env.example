POSTGRES_PASSWORD=replace-with-generated-database-password
VLA_ENROLLMENT_TOKEN=replace-with-different-generated-enrollment-token
# 首次管理员在服务器控制台通过 python -m vla_control.users create-admin 创建。
# 网页必须经 HTTPS 入口；默认关闭旧共享管理员令牌认证。
VLA_SESSION_TTL_SECONDS=7200
VLA_SESSION_IDLE_SECONDS=900
# 敏感操作验证密码后，在此时间内可继续进行敏感操作；不会续期登录。
VLA_SESSION_REAUTH_SECONDS=300
# Agent 可达的 HTTPS 中台根地址。留空时仅自动采用当前公开 HTTPS 入口。
VLA_AGENT_CONTROL_PLANE_URL=
# HTTPS 入口配置；使用 compose.https.yaml 才发布 80/443，API 的 8000 仍只绑定宿主机回环地址。
VLA_PUBLIC_URL=https://115.190.212.169
# scripts/configure_https.py 生成的 Caddyfile 所在绝对目录。
VLA_HTTPS_CONFIG_DIR=/etc/termitech-vla/https
# 仅 provided 模式使用；目录内的证书/私钥要与 Caddyfile 中的最终容器路径对应。
VLA_HTTPS_CERTS_DIR=/etc/termitech-vla/certs
VLA_HTTPS_BIND=0.0.0.0
# 独立代理网络中只信任 Caddy 的单个地址；如网段冲突，须同时修改这三个值。
VLA_HTTPS_PROXY_SUBNET=172.29.239.0/28
VLA_HTTPS_PROXY_IP=172.29.239.2
VLA_HTTPS_API_IP=172.29.239.3
